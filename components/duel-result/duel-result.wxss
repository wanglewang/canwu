/* 对决结算卡（components/duel-result）的私有样式：比分板与两个点数。
   遮罩、弹窗、结果行都取 app.wxss 与 styles/immortal.wxss 的通用类，
   这里只补「我方 / 对方」这一块没有现成样式的东西。 */

.duel-score {
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: var(--sp-6) 0;
    border-radius: var(--r-md);
    background: var(--c-surface-2);
}

.duel-score__side {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.duel-num {
    margin-top: var(--sp-2);
    font-size: var(--fs-h1);
    font-weight: 700;
    line-height: 1;
    color: var(--c-text);
    animation: riseIn 420ms ease-out both;
}

.duel-vs {
    color: var(--c-text-3);
    font-size: var(--fs-note);
}

@keyframes riseIn {
    from { opacity: 0; transform: translateY(var(--sp-4)); }
    to { opacity: 1; transform: translateY(0); }
}
