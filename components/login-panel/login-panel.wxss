/* 登录面板：与全站同一套墨金，不用蓝色（原先是 #3b6ef5 的通用蓝，和墨底放一起最刺眼）。
   颜色全部取令牌，组件内不写裸色值；深色是唯一一套，系统明暗切换不翻转。 */
.login {
    padding: var(--sp-6) var(--sp-5);
    border: 1rpx solid var(--c-imm-line);
    border-radius: var(--r-lg);
    background: var(--c-imm-panel);
}

.login-title {
    display: block;
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--c-imm-text);
}

.login-desc {
    display: block;
    margin-top: var(--sp-3);
    font-size: var(--fs-note);
    line-height: var(--lh-body);
    color: var(--c-imm-text-3);
}

.login-input {
    box-sizing: border-box;
    width: 100%;
    height: var(--touch);
    padding: 0 var(--sp-5);
    margin-top: var(--sp-6);
    border: 1rpx solid var(--c-imm-line);
    border-radius: var(--r-md);
    background: var(--c-imm-bg-2);
    font-size: var(--fs-body-sm);
    color: var(--c-imm-text);
}

.login-placeholder {
    color: var(--c-imm-text-3);
}

.login-row {
    display: flex;
    align-items: center;
}

.login-code {
    flex: 1;
    margin-top: var(--sp-4);
}

/* 获取验证码 = 次操作：细描边金字，不铺色块，避免和「登录 / 注册」抢主次 */
.login-send {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--touch);
    margin: var(--sp-4) 0 0 var(--sp-4);
    padding: 0 var(--sp-5);
    border: 1rpx solid var(--c-imm-gold-dim);
    border-radius: var(--r-md);
    color: var(--c-imm-gold);
    font-size: var(--fs-note);
    line-height: 1;
}

.login-send-disabled {
    border-color: var(--c-imm-line);
    color: var(--c-imm-text-3);
}

.login-button {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: var(--touch);
    margin-top: var(--sp-5);
    padding: 0 var(--sp-6);
    border: 0;
    border-radius: var(--r-md);
    background: linear-gradient(to bottom, var(--c-imm-gold), var(--c-imm-gold-dim));
    color: var(--c-imm-bg);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1;
    letter-spacing: var(--sp-1);
}

.login-button::after {
    border: none;
}

.login-tip {
    display: block;
    margin-top: var(--sp-4);
    font-size: var(--fs-caption);
    color: var(--c-imm-jade);
}

.login-error {
    display: block;
    margin-top: var(--sp-4);
    font-size: var(--fs-caption);
    color: var(--c-imm-danger);
}
