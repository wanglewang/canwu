# WorkBuddy 本地工作区元数据（项目记忆、应用注册）
.workbuddy/

# 本地应用预览卡（含机器相关的绝对路径，不入库）
*.genie

# npm 依赖与小程序 npm 构建产物（发布流程会自动构建）
node_modules/
miniprogram_npm/

# 临时校验脚本 / 日志
.tmp-*
*.log

# Git 内部版本控制数据（永不入库 / 同步）
.git

# Gitee 同步插件诊断日志
_gitee-sync-plus-log.md

# Obsidian 回收站目录
.trash/

# Obsidian 工作区布局（面板/标签状态，不跨设备同步）
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/plugins/gitee-sync-plus/data.json
