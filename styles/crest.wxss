/* ---------- 灵纹牌上的八种图案（连连看 / 消消乐） ----------
   这张 sprite 是 assets/crest.png 内联进来的（小程序 wxss 不能引用包内图片路径，
   只能 base64）。八个图案：灵果 / 灵梨 / 灵珠 / 灵桃 / 灵橘 / 茶盏 / 灵葫 / 灵芝。
   为什么用图片而不是继续用字符或 CSS 拼：✦ ◆ ✿ 是 dingbat，安卓上会被系统换成
   彩色 emoji；水果这类「一眼认」的形，用圆和边框也拼不出来，拼出来仍是几何纹。
   sprite 是 8 格横排（512×64），容器取 800% 宽即正好一格，靠 position-x 切。 */

.cell__crest {
    display: block;
    box-sizing: border-box;
    width: 72rpx;
    height: 72rpx;
    background-image: url(data:image/png;base64,);
    background-repeat: no-repeat;
    background-size: 800% auto;
    background-position-y: 50%;
}

.crest--1 { background-position-x: 0%; }
.crest--2 { background-position-x: 14.2857%; }
.crest--3 { background-position-x: 28.5714%; }
.crest--4 { background-position-x: 42.8571%; }
.crest--5 { background-position-x: 57.1429%; }
.crest--6 { background-position-x: 71.4286%; }
.crest--7 { background-position-x: 85.7143%; }
.crest--8 { background-position-x: 100%; }

/* 选中：纹样轻轻跳一下再落定，像从盘面上被「拿起来」。
   只动 .cell__crest 自己的 transform —— 格子的 transform 归按压反馈所有
   （.cell--press 的 scale），两个类写同一个属性会互相顶掉，按下就没有反馈了。 */
.cell--chip.cell--sel .cell__crest {
    animation: crestPick 340ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes crestPick {
    0% { transform: scale(1) translateY(0); }
    42% { transform: scale(1.22) translateY(-6rpx); }
    72% { transform: scale(1.05) translateY(-1rpx); }
    100% { transform: scale(1.12) translateY(-3rpx); }
}

/* 矮盘（6×6 消消乐）里图案跟着收一档，别顶到牌边。 */
.grid--compact .cell__crest {
    width: 60rpx;
    height: 60rpx;
}
