/* ==========================================================================
   《参悟》设计令牌 · Design Tokens · 唯一真源
   --------------------------------------------------------------------------
   所有页面的颜色、字号、间距、圆角、阴影、层级都从这里取，不要在页面 wxss
   里再写裸色值。两套皮肤，三档设置（跟随系统 / 白天 / 夜晚）：

     · 白天「宣纸彩墨」——宣纸底、白纸卡、墨褐字，五支国画颜料色。
     · 夜里「墨玉夜」——深青墨底、玉白字，颜料色整体提亮一档。

   页面一律挂 .pg--imm，把 --c-* 映到 --c-imm-*；夜里再挂 .pg--t-night（见文件末尾）。
   档位由 utils/theme.js 解析成一个确定结果（light / night），页面根节点出类名，
   原生栏由同一次调用改色——CSS 里没有第二条路径，也没有媒体查询。
   夜里的原色写在 `--night-*` 里**只此一份**，夜块与 styles/scene.wxss 的舞台都引用它——
   参悟页舞台固定深色，而它用的正是这一支，所以夜里打开这一页时，页面与舞台是同一个色，
   进局没有切换。

   【为什么夜里不换一套新配色，而是提亮同一套】
   深夜有人打开小程序，看到的必须是「同一座山门，只是天黑了」。
   换一套新配色意味着所有对比度都得重新标定一遍，而没有任何断言能证明它好看。
   所以夜里只做三件事：底色压到深青墨、文字翻成玉白、颜料色各提一档到 5:1 以上。

   【为什么不是墨底金线】
   上一版把强调色收到金色一支（#cfae6d），理由是更早那版「米金 + 薄荷青 +
   荧光青 + 绿灰」四处并发、整页发浑发荧光——那个问题是真的，但收过头了。
   只剩一支低饱和旧金压在大面积墨底上，读起来就是「黑、灰、一点脏黄」：
   页面层一支彩色的都没有，而项目里本来就有五行色板，却只注进了玩法盘面。
   这一版改回彩色，但纪律不是「放开撒彩」，而是**一个系统一个颜色**：
   颜色本身就是信息，玩家扫一眼颜色就知道哪块是灵力、哪块是灵石。
   底色与正文仍是低彩度的纸与墨，彩色只落在标签、数值、图标、进度与主操作上；
   大面积彩色与「宣纸」会互相打架，也会让每一屏都在喊。

   【五支颜料取「水彩」的浓度，不取「矿物颜料」】
   2026-11 把五支整体降饱和、提明度（色相分工一个字不动）：朱砂→陶土红、石青→雾水蓝、
   石绿→苔豆绿、藤黄→麦芽黄、绛紫→藕荷紫。浓到发艳的那版被否过，玩家原话
   「花里胡哨刺眼」。降饱和不是退回灰：每支仍保住自己的色相；做文字的那几支另备
   深一档的 `-text`，压到 4.5:1 以上，块色与描边才用柔版。夜里同此理，各提一档。

   【页面规范】
   1. 结构：一级页 / 二级页根节点统一 .pg（登录页 .login-page、参悟页 .pg--scene），
      页头交给原生导航栏（标题 + 返回箭头），页内不再画标题；「说明」沉到页尾 .pg__foot 一行，
      不再画第二层标题；区块 .section = .section__head + 若干 .card，页尾 .pg__foot。
   2. 栅格：以 4rpx 为基准，只用 --sp-*；页面左右留白 --page-x（28rpx）。
   3. 排版：只用 --fs-* 阶梯；caption 只用于角标 / 注脚，正文不小于 body。
   4. 触控：主操作高度 --touch（88rpx）；卡片内次操作可以降到 --touch-sm，
      但必须靠 .btn-row 或父行留白补足热区，两个可点元素间距 ≥ --sp-2。
   5. 反馈：可点 view 统一挂 hover-class="pressable"；危险操作只有 .imm-btn--danger。
   6. 层级：内容 0 / 吸底条 40 / 倒计时 80 / 遮罩 90 / 结算 100，
      只用 --z-*，禁止随手写 z-index: 999。
   7. 安全区：所有吸底元素与页面底部留白必须带 env(safe-area-inset-bottom)。
   8. 主题：--c-nav / --c-tab / --c-tab-* 必须与 theme.json 的 @变量同值；
      scripts/verify.js 会逐项核对，改色请两处一起改。
   9. 玩法盘面主题色（--acc / --soft / --ink / --glow / --well / --deep）
      由 minigames/theme.js 与 data/visual.js 注入，不在这里定义。
   10. 盘面材质（--jade / --jade-paper / --jade-dim / --jade-ink / --gold-line）
      是 19 门共用的一副「玉牌」，不跟功法走，所以放在这里定义；
      台面色仍由 --well 按功法所属那一族注入。参悟页的沉浸舞台是页面规范的
      白名单例外（styles/scene.wxss），它固定深色：盘面要跳出来，台必须暗。

   【命名】--c-* 颜色 / --fs-* 字号 / --sp-* 间距 / --r-* 圆角 /
           --sh-* 阴影 / --z-* 层级 / --dur-* 动效 / --lh-* 行高
   ========================================================================== */

page {
    /* ---------- 颜色：表面与文字 ---------- */
    /* 纸与墨两档，色温偏暖：纯白 + 纯黑是印刷品，不是宣纸。 */
    --c-bg:              #f2e9d6;   /* 页面底色：宣纸 */
    --c-surface:         #fffcf2;   /* 卡片 / 面板 / 吸底条：压在上面的白纸 */
    --c-surface-2:       #f6eeda;   /* 内嵌块：码框 / 输入框底 / 次按钮 */
    --c-surface-3:       #fbf6e8;   /* 更浅的嵌套块 */
    --c-surface-ink:     #33291f;   /* 墨褐主卡：深底反差块 */
    --c-on-ink:          #fffcf2;   /* 墨褐卡主文字 */
    --c-on-ink-2:        #c4b391;   /* 墨褐卡次文字 */
    --c-border:          #e2d3b5;   /* 常规描边：淡褐，像纸的裁切边 */
    --c-border-strong:   #cbb488;   /* 强调描边 */
    --c-divider:         #ebe0c7;   /* 分隔线 */
    --c-text:            #33291f;   /* 正文：墨褐，不用纯黑 */
    --c-text-2:          #5b4c3b;   /* 次要文字 5.2:1 */
    --c-text-3:          #786850;   /* 注脚 / 占位 4.7:1，浅底上再淡就读不清了 */
    --c-placeholder:     #9a8a71;   /* 输入框 placeholder：唯一允许低于 4.5:1 的一档 */

    /* ---------- 颜色：语义与强调（*-text 用于文字，裸名用于背景） ---------- */
    /* 五支颜料色，各自绑一个系统，不许混用（见文件头「一个系统一个颜色」）：
       朱砂 = 主操作 / 当前项；石青 = 灵力 / 链接 / 信息；
       石绿 = 进度 / 成功；藤黄 = 灵石 / 贵重；绛紫 = 秘境 / 稀有。 */
    --c-primary:         #b1503a;   /* 朱砂（陶土红）：主操作底，白字压上 5.0:1 */
    --c-primary-soft:    #f8e8e2;
    --c-primary-on:      #fffcf2;
    --c-primary-text:    #a8462f;   /* 朱砂做文字的可读版（5.7:1） */
    --c-gold:            #b8933f;   /* 藤黄（麦芽黄）：只做底与小面积色块 */
    --c-gold-soft:       #f6eddc;
    --c-gold-text:       #8a6d24;   /* 藤黄做文字要压暗才有 4.8:1 */
    --c-danger:          #b3352b;
    --c-danger-text:     #b3352b;
    --c-success:         #6a9c78;   /* 石绿（苔豆绿） */
    --c-success-text:    #4a7a58;
    --c-neutral:         #8d7c64;
    --c-neutral-soft:    #efe4cc;
    --c-link:            #3d6f88;   /* 石青（雾水蓝） */
    --c-track:           #e8dbbe;   /* 进度轨 */
    --c-fill:            #b1503a;   /* 进度填充：与主操作同色 */
    --c-mask:            rgba(51, 41, 31, 0.45);
    --c-ink-scrim:       rgba(255, 252, 242, 0.14);  /* 墨褐卡内嵌块 */
    --c-ink-track:       rgba(255, 252, 242, 0.24);  /* 墨褐卡上的进度轨 / 标签底 */
    --c-ink-divider:     rgba(255, 252, 242, 0.18);  /* 墨褐卡上的分隔线 */
    --c-gold-bright:     #d8bd78;               /* 金色高光，明暗通用 */

    /* ---------- 颜色：仙箓皮肤（亮色段 = 白天「宣纸彩墨」） ----------- */
    /* 五支颜料色 + 纸墨两档。彩色不许铺大面：卡片仍是白纸，颜色落在
       数值、图标、标签、进度与主操作上；底色一彩，整页就变成游戏登录页。 */
    /* 对比度（WCAG，纸 #fffcf2 上）：正文 12.4:1、次文字 6.4:1、注脚 5.5:1，
       朱砂文字版 5.7:1、石青 5.3:1、藤黄文字版 4.8:1，均达 AA。 */
    --c-imm-bg:          #f2e9d6;   /* 宣纸底 */
    --c-imm-bg-2:        #faf4e6;   /* 页面顶部渐层：比底更亮一档，像纸受光 */
    --c-imm-panel:       #fffcf2;   /* 面板 */
    --c-imm-panel-2:     #fffef9;   /* 面板顶部渐层 */
    --c-imm-tile:        #fbf4e3;   /* 宫格底 */
    --c-imm-line:        #e2d3b5;   /* 常规描边 */
    --c-imm-line-soft:   #eee2c8;   /* 分隔线 */
    --c-imm-primary:     #b1503a;   /* 朱砂：主操作 / 当前项 */
    --c-imm-primary-deep:#973e2c;   /* 朱砂下沿：只做实心按钮渐变的末端，不用它画描边 */
    --c-imm-primary-soft:#f8e8e2;
    --c-imm-gold:        #b8933f;   /* 藤黄：灵石 / 贵重 */
    --c-imm-gold-deep:   #9d7d2d;
    --c-imm-gold-text:   #8a6d24;   /* 藤黄做文字要压暗才有 4.8:1 */
    --c-imm-gold-dim:    #d4c19c;   /* 浅金：只用于描边与细线 */
    --c-imm-gold-soft:   rgba(184, 147, 63, 0.13);
    --c-imm-text:        #33291f;   /* 墨褐正文 */
    --c-imm-text-2:      #5b4c3b;   /* 次要文字 */
    --c-imm-text-3:      #786850;   /* 注脚 / 占位 */
    --c-imm-jade:        #6a9c78;   /* 石绿：进度与「进行中」 */
    --c-imm-jade-dim:    rgba(106, 156, 120, 0.34);   /* 石绿描边：只做边框，不做字色 */
    --c-imm-azure:       #3d6f88;   /* 石青：灵力 / 信息 / 秘境 */
    --c-imm-violet:      #8a67a0;   /* 绛紫：稀有 / 特殊 */
    --c-imm-track:       rgba(51, 41, 31, 0.09);
    --c-imm-danger:      #b3352b;   /* 警示文字：只用于不可撤销说明 */
    --c-imm-danger-soft: rgba(179, 53, 43, 0.08);   /* 警示块底 */
    --c-imm-mask:        rgba(51, 41, 31, 0.40);
    --c-imm-shadow:      0 12rpx 36rpx rgba(120, 96, 56, 0.14);

    /* ---------- 盘面材质：19 门共用的一副「玉牌」 ---------- */
    /* 参悟页的盘面是「墨玉台 + 暖白玉牌」：台色按功法族由 --well 注入，
       牌面这一套是常数——换门不换棋子，像同一副棋换棋盘。
       牌必须比台亮六七倍，否则两块深色糊成一片（旧版是纸白底摆纸白牌，整盘只剩一圈白边）。
       这一组不跟着页面改宣纸：它是舞台上的东西，舞台仍固定深色。 */
    --jade:              #fbf3dd;   /* 玉牌面（比纯白暖一档，才像骨牌而不是纸卡） */
    --jade-paper:        #e6d3ac;   /* 凹槽纸面：翻开 / 已定的格 */
    --jade-dim:          #b3ab96;   /* 暗玉：未启用 / 已走过 / 虚影 */
    --jade-ink:          #3c382a;   /* 牌上的字 */
    --gold-line:         rgba(201, 154, 30, 0.55);  /* 牌缘与盘框的金线 */

    /* 探禁（数格辨禁）专属色板：整盘落低亮区的青灰石，不随功法变，昼夜各一套。
       极性是死的——未探浅而凸、已探深而凹，已探永远是全盘最暗的一层；
       数字是唯一亮起来的东西。色系可以从暖褐换成青灰，极性绝不翻。
       夜里那一份原色写在下面的 --night-mine-*，由 .pg--t-night 逐键转接。 */
    --mine-hidden-a:     #4b6472;   /* 未探石面上缘受光 */
    --mine-hidden-b:     #384f5d;   /* 未探石面下缘 */
    --mine-hidden-ink:   #d8e8ec;   /* 未探格上的符文（旗 / 禁制） */
    --mine-open:         #1b2b35;   /* 已探凹处：全盘最暗 */
    --mine-open-edge:    rgba(154, 201, 214, 0.20);
    --mine-n1:           #8fd3c6;   /* 数字 1：青玉 */
    --mine-n2:           #e9ad9b;   /* 数字 2：暖陶 */
    --mine-n3:           #e0c788;   /* 数字 3+：旧金 */
    --mine-flag:         #c9a24d;   /* 阵钉：全盘第二亮 */
    --mine-flag-ink:     #241a08;
    --mine-strike:       #a83b32;   /* 踩中的朱砂 */
    --mine-strike-ink:   #f5d9d1;
    --mine-vein:         rgba(216, 236, 241, 0.055);  /* 石纹：凑近才看得见 */

    /* ---------- 颜色：原生导航与 tabBar（与 theme.json 一一对应） ---------- */
    /* 原生栏与 tabBar 必须与页面同色，否则顶部会拼出一条异色横条。
       亮色段取宣纸白，暗色段取墨玉深底（#0f2030），theme.json 的 light / dark 两段照抄。
       tabBar 图标是 png，不认这里的变量：夜版另有一套文件，由 app.js 换。 */
    --c-nav:             #fffcf2;   /* @navBgColor */
    --c-tab:             #fffcf2;   /* @tabBgColor */
    --c-tab-text:        #786850;   /* @tabColor */
    --c-tab-active:      #b1503a;   /* @tabSelectedColor */

    /* ---------- 夜色板：昼夜两套皮肤里「夜」的那一份原色 ---------- */
    /* 只在这里定义一次。下面暗色段把它逐键映到 --c-* / --c-imm-*，
       styles/scene.wxss 的 .pg--scene 也映同一批——参悟页舞台固定深色，
       用的就是这一支。两处引用同一组值，所以「夜里的页面」与「夜里的舞台」
       在结构上不可能漂开；改夜戏只需要改这一段。
       不叫 --c-night-*：verify 要求暗色段覆盖亮色段每一个 --c-* 键，
       带 --c- 前缀会被当成「亮色段有、暗色段也必须有一个」的令牌。 */
    /* 对比度（WCAG，夜底 #08131c 上）：正文 16.3:1、次文字 10.0:1、注脚 7.0:1，
       朱砂 7.6:1、藤黄 10.5:1、石青 8.9:1、绛紫 7.3:1、石绿 9.0:1，全达 AA。 */
    --night-bg:            #08131c;   /* 深青墨底：也是参悟页舞台底色 */
    --night-bg-2:          #0e2030;   /* 页面顶部渐层 */
    --night-panel:         #0f2030;   /* 卡 / 面板 / 吸底条 */
    --night-panel-2:       #132a3d;   /* 内嵌块 */
    --night-panel-3:       #16324a;   /* 更浅的嵌套块 */
    --night-tile:          #0d1d2b;   /* 宫格底 */
    --night-sink:          #050e16;   /* 反衬深块：白天那块的墨褐卡，夜里翻成更深的坑 */
    --night-line:          rgba(227, 241, 248, 0.20);
    --night-line-soft:     rgba(227, 241, 248, 0.12);
    --night-line-strong:   rgba(227, 241, 248, 0.34);
    --night-primary:       #dd927c;   /* 朱砂夜里提亮：深底上的 #b1503a 只剩 3.6:1 */
    --night-primary-deep:  #c07a66;
    --night-primary-soft:  rgba(221, 146, 124, 0.16);
    --night-on-primary:    #0b1620;   /* 亮朱砂上的字要用深色，白字对比不足 */
    --night-gold:          #dcc06a;
    --night-gold-deep:     #c9ab5c;
    --night-gold-dim:      rgba(220, 192, 106, 0.45);
    --night-gold-soft:     rgba(220, 192, 106, 0.12);
    --night-gold-bright:   #e6cf8a;
    --night-text:          #e3f1f8;   /* 玉白，不用纯白 */
    --night-text-2:        #9fc3d4;
    --night-text-3:        #7fa3b8;
    --night-placeholder:   #5d7d90;   /* 唯一允许低于 4.5:1 的一档 */
    --night-jade:          #95bda9;
    --night-jade-dim:      rgba(149, 189, 169, 0.42);
    --night-azure:         #8db7e0;
    --night-violet:        #ac98d6;
    --night-neutral:       #8fa6b5;
    --night-neutral-soft:  rgba(227, 241, 248, 0.08);
    --night-track:         rgba(227, 241, 248, 0.12);
    --night-danger:        #e0928a;
    --night-danger-soft:   rgba(224, 146, 138, 0.12);
    --night-mask:          rgba(4, 8, 7, 0.72);
    --night-shadow:        0 24rpx 80rpx rgba(0, 0, 0, 0.55);
    /* 深块上的叠加层：白天是「墨褐卡的白色蒙层」，夜里那块本身已经是深坑，
       蒙层要压在它上面提亮，而不是再压暗。 */
    --night-ink-scrim:     rgba(0, 0, 0, 0.30);
    --night-ink-track:     rgba(227, 241, 248, 0.24);
    --night-ink-divider:   rgba(227, 241, 248, 0.18);
    /* 探禁的夜色石盘：夜里页面是 #08131c，未探格仍要比它亮一档，
       已探再压到近乎墨色——盘的边界靠「青石 vs 墨」自己撑住，不靠边框。 */
    --night-mine-hidden-a: #2d4b59;
    --night-mine-hidden-b: #203945;
    --night-mine-open:     #101e27;
    --night-mine-flag:     #d4af5e;
    --night-mine-strike:   #d4695e;

    /* ---------- 字号阶梯（rpx，1sp ≈ 2rpx） ---------- */
    --fs-caption:        22rpx;     /* 角标 / 注脚，下限 */
    --fs-note:           24rpx;     /* 辅助说明 */
    --fs-body-sm:        26rpx;     /* 密集文本：指南条目 */
    --fs-body:           28rpx;     /* 正文 */
    --fs-subhead:        30rpx;     /* 区块标题 */
    --fs-h3:             32rpx;     /* 卡片标题 / 数值 */
    --fs-h2:             34rpx;     /* 小节标题 */
    --fs-lead:           40rpx;     /* 姓名 / 强调标题 */
    --fs-h1:             54rpx;     /* 页面大标题 */
    --fs-display:        76rpx;     /* 战力等大数字 */

    /* ---------- 行高 ---------- */
    --lh-tight:          1.25;
    --lh-head:           1.4;
    --lh-body:           1.65;
    --lh-loose:          1.7;

    /* ---------- 间距栅格（4rpx 基准） ---------- */
    --sp-1:              4rpx;
    --sp-2:              8rpx;
    --sp-3:              12rpx;
    --sp-4:              16rpx;
    --sp-5:              20rpx;
    --sp-6:              24rpx;
    --sp-8:              32rpx;
    --sp-10:             40rpx;
    --sp-12:             48rpx;
    --sp-16:             64rpx;
    --page-x:            28rpx;     /* 页面左右留白 */
    --page-top:          28rpx;
    --page-bottom:       60rpx;     /* 页面底部留白（不含安全区） */
    --card-pad:          28rpx;     /* 卡片内边距 */
    --card-gap:          24rpx;     /* 卡片间距 */
    --section-gap:       40rpx;     /* 区块间距 */
    --bar-height:        152rpx;    /* 吸底条占位高度 */

    /* ---------- 圆角 ---------- */
    --r-xs:              8rpx;
    --r-sm:              12rpx;
    --r-md:              16rpx;
    --r-lg:              24rpx;
    --r-xl:              28rpx;
    --r-pill:            999rpx;

    /* ---------- 阴影 ---------- */
    /* 纸上的阴影要带一点褐色，纯黑投影会让宣纸变成塑料。 */
    --sh-card:           0 4rpx 14rpx rgba(120, 96, 56, 0.07);
    --sh-bar:            0 -6rpx 20rpx rgba(120, 96, 56, 0.10);
    --sh-modal:          0 18rpx 48rpx rgba(90, 72, 44, 0.20);
    --sh-none:           none;

    /* ---------- 层级 ---------- */
    --z-base:            0;
    --z-sticky:          40;
    --z-countdown:       80;
    --z-mask:            90;
    --z-settle:          100;

    /* ---------- 触控 ---------- */
    --touch:             88rpx;     /* 主操作最小高度 */
    --touch-sm:          76rpx;     /* 次操作 */
    --touch-xs:          68rpx;     /* 卡片内紧凑操作 / 文字链 */

    /* ---------- 动效 ---------- */
    --dur-fast:          120ms;
    --dur-slow:          320ms;
    --ease:              cubic-bezier(0.2, 0.8, 0.2, 1);

    /* ---------- 安全区 ---------- */
    --safe-bottom:       env(safe-area-inset-bottom);
}

/* 夜皮肤「墨玉夜」：页面根节点挂 .pg--t-night 才生效。
   这里全部引用上面的 --night-*，不写第二份色值——两处各写一遍，改动时必然漏一处，
   而漏掉的那一处不会有任何断言报红（页面照样渲染，只是颜色悄悄不对）。

   【为什么不用 prefers-color-scheme】
   皮肤现在有三档设置：跟随系统 / 白天 / 夜晚。媒体查询只能问系统，玩家手选白天时
   没有任何选择器能盖住「系统说是夜」——只能再写一份白天值，两份值互相打架，
   而且谁赢取决于选择器权重，改样式的人看不出来。所以主题由 utils/theme.js 解析成
   一个确定结果，页面挂类名；CSS 里只有一条路径。原生栏由同一次调用改色（见 theme.js）。

   【为什么挂在 .pg--t-night 而不是 page】
   类名挂在页面根节点上，自己的声明盖过 page 继承下来的值。page 元素本身的背景
   只能由 wx.setBackgroundColor 改，那是另一件事（见 theme.js 的 applyChrome）。

   原生栏那四个例外：verify 拿它们和 theme.json 逐字比对，必须是字面量，不能是 var()。 */
.pg--t-night {
        --c-bg:              var(--night-bg);
        --c-surface:         var(--night-panel);
        --c-surface-2:       var(--night-panel-2);
        --c-surface-3:       var(--night-panel-3);
        --c-surface-ink:     var(--night-sink);
        --c-on-ink:          var(--night-text);
        --c-on-ink-2:        var(--night-text-2);
        --c-border:          var(--night-line);
        --c-border-strong:   var(--night-line-strong);
        --c-divider:         var(--night-line-soft);
        --c-text:            var(--night-text);
        --c-text-2:          var(--night-text-2);
        --c-text-3:          var(--night-text-3);
        --c-placeholder:     var(--night-placeholder);

        --c-primary:         var(--night-primary);
        --c-primary-soft:    var(--night-primary-soft);
        --c-primary-on:      var(--night-on-primary);
        --c-primary-text:    var(--night-primary);
        --c-gold:            var(--night-gold);
        --c-gold-soft:       var(--night-gold-soft);
        --c-gold-text:       var(--night-gold);
        --c-danger:          var(--night-danger);
        --c-danger-text:     var(--night-danger);
        --c-success:         var(--night-jade);
        --c-success-text:    var(--night-jade);
        --c-neutral:         var(--night-neutral);
        --c-neutral-soft:    var(--night-neutral-soft);
        --c-link:            var(--night-azure);
        --c-track:           var(--night-track);
        --c-fill:            var(--night-primary);
        --c-mask:            var(--night-mask);
        --c-ink-scrim:       var(--night-ink-scrim);
        --c-ink-track:       var(--night-ink-track);
        --c-ink-divider:     var(--night-ink-divider);
        --c-gold-bright:     var(--night-gold-bright);

        /* 仙箓皮肤：同一支夜色，逐键映过去。 */
        --c-imm-bg:          var(--night-bg);
        --c-imm-bg-2:        var(--night-bg-2);
        /* 探禁色板转接：原色只在 --night-mine-* 写一份，这里只做映射。 */
        --mine-hidden-a:     var(--night-mine-hidden-a);
        --mine-hidden-b:     var(--night-mine-hidden-b);
        --mine-open:         var(--night-mine-open);
        --mine-flag:         var(--night-mine-flag);
        --mine-strike:       var(--night-mine-strike);
        --c-imm-panel:       var(--night-panel);
        --c-imm-panel-2:     var(--night-panel-2);
        --c-imm-tile:        var(--night-tile);
        --c-imm-line:        var(--night-line);
        --c-imm-line-soft:   var(--night-line-soft);
        --c-imm-primary:     var(--night-primary);
        --c-imm-primary-deep: var(--night-primary-deep);
        --c-imm-primary-soft: var(--night-primary-soft);
        --c-imm-gold:        var(--night-gold);
        --c-imm-gold-deep:   var(--night-gold-deep);
        --c-imm-gold-text:   var(--night-gold);
        --c-imm-gold-dim:    var(--night-gold-dim);
        --c-imm-gold-soft:   var(--night-gold-soft);
        --c-imm-text:        var(--night-text);
        --c-imm-text-2:      var(--night-text-2);
        --c-imm-text-3:      var(--night-text-3);
        --c-imm-jade:        var(--night-jade);
        --c-imm-jade-dim:    var(--night-jade-dim);
        --c-imm-azure:       var(--night-azure);
        --c-imm-violet:      var(--night-violet);
        --c-imm-track:       var(--night-track);
        --c-imm-danger:      var(--night-danger);
        --c-imm-danger-soft: var(--night-danger-soft);
        --c-imm-mask:        var(--night-mask);
        --c-imm-shadow:      var(--night-shadow);

        --c-nav:             #0f2030;
        --c-tab:             #0f2030;
        --c-tab-text:        #9fc3d4;
        --c-tab-active:      #dd927c;

        /* 深底上投影不靠「压暗」而是靠「离得远」：纸上的褐影在夜里会糊成一块脏晕。 */
        --sh-card:           0 4rpx 14rpx rgba(0, 0, 0, 0.36);
        --sh-bar:            0 -6rpx 20rpx rgba(0, 0, 0, 0.42);
        --sh-modal:          0 18rpx 48rpx rgba(0, 0, 0, 0.52);
}
