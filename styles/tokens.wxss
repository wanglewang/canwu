/* ==========================================================================
   《参悟》设计令牌 · Design Tokens · 唯一真源
   --------------------------------------------------------------------------
   所有页面的颜色、字号、间距、圆角、阴影、层级都从这里取，不要在页面 wxss
   里再写裸色值。改版后全站恒定深色：页面一律挂 .pg--imm，把 --c-* 映到
   --c-imm-*，不随系统翻色；下方暗色段只服务没挂 .pg--imm 的基础层。

   【页面规范】
   1. 结构：一级页 / 二级页根节点统一 .pg（登录页 .login-page、参悟页 .pg--scene），
      页头交给原生导航栏（标题 + 返回箭头），页内不再画标题；「说明」沉到页尾 .pg__foot 一行，
      不再画第二层标题；区块 .section = .section__head + 若干 .card，页尾 .pg__foot。
   2. 栅格：以 4rpx 为基准，只用 --sp-*；页面左右留白 --page-x（28rpx）。
   3. 排版：只用 --fs-* 阶梯；caption 只用于角标 / 注脚，正文不小于 body。
   4. 触控：主操作高度 --touch（88rpx）；卡片内次操作可以降到 --touch-sm，
      但必须靠 .btn-row 或父行留白补足热区，两个可点元素间距 ≥ --sp-2。
   5. 反馈：可点 view 统一挂 hover-class="pressable"；危险操作只有 .imm-btn--danger。
   6. 层级：内容 0 / 吸底条 40 / 倒计时 80 / 遮罩 90 / 结算 100，
      只用 --z-*，禁止随手写 z-index: 999。
   7. 安全区：所有吸底元素与页面底部留白必须带 env(safe-area-inset-bottom)。
   8. 主题：--c-nav / --c-tab / --c-tab-* 必须与 theme.json 的 @变量同值；
      scripts/verify.js 会逐项核对，改色请两处一起改。
   9. 玩法盘面主题色（--acc / --soft / --ink / --glow / --well / --deep）
      由 minigames/theme.js 与 data/visual.js 注入，不在这里定义。

   【命名】--c-* 颜色 / --fs-* 字号 / --sp-* 间距 / --r-* 圆角 /
           --sh-* 阴影 / --z-* 层级 / --dur-* 动效 / --lh-* 行高
   ========================================================================== */

page {
    /* ---------- 颜色：表面与文字 ---------- */
    --c-bg:              #f2eee4;   /* 页面底色 */
    --c-surface:         #fffdf7;   /* 卡片 / 面板 / 吸底条 */
    --c-surface-2:       #f1ede1;   /* 内嵌块：码框 / 输入框底 / 次按钮 */
    --c-surface-3:       #f7f3e8;   /* 更浅的嵌套块 */
    --c-surface-ink:     #2f4a41;   /* 深绿主卡 */
    --c-on-ink:          #fffdf7;   /* 深绿卡主文字 */
    --c-on-ink-2:        #b9c9bf;   /* 深绿卡次文字 */
    --c-border:          #e3ddcd;   /* 常规描边 */
    --c-border-strong:   #ddd5c2;   /* 强调描边 */
    --c-divider:         #e9e3d4;   /* 分隔线 */
    --c-text:            #2f3a34;   /* 正文 */
    --c-text-2:          #8a8f83;   /* 次要文字 */
    --c-text-3:          #a09e8f;   /* 辅助 / 占位 / 页脚 */
    --c-placeholder:     #a9a99a;   /* 输入框 placeholder */

    /* ---------- 颜色：语义与强调（*-text 用于文字，裸名用于背景） ---------- */
    --c-primary:         #2f6b5b;
    --c-primary-soft:    #e2efe8;
    --c-primary-on:      #fffdf7;
    --c-primary-text:    #2f6b5b;
    --c-gold:            #b8893b;
    --c-gold-soft:       #f5ead2;
    --c-gold-text:       #a2762d;
    --c-danger:          #b4453c;
    --c-danger-text:     #b4453c;
    --c-success:         #3d8c74;
    --c-success-text:    #2f6b5b;
    --c-neutral:         #8a8f83;
    --c-neutral-soft:    #ece9df;
    --c-link:            #2f6b5b;
    --c-track:           #e9e3d4;   /* 进度轨 */
    --c-fill:            #3d8c74;   /* 进度填充 */
    --c-mask:            rgba(30, 40, 34, 0.55);
    --c-ink-scrim:       rgba(0, 0, 0, 0.18);   /* 深色卡内嵌块 */
    --c-ink-track:       rgba(255, 253, 247, 0.18);  /* 深色卡上的进度轨 / 标签底 */
    --c-ink-divider:     rgba(255, 253, 247, 0.16);  /* 深色卡上的分隔线 */
    --c-gold-bright:     #d8b775;               /* 金色高光，明暗通用 */

    /* ---------- 颜色：仙箓皮肤（四个主页面恒定深色，不随系统明暗翻转） ----------- */
    /* 只有四支色相：墨（底）、暖白（字）、旧金（唯一强调）、青玉（只标进度）。      */
    /* 上一版是米金 + 薄荷青 + 荧光青 + 绿灰四处并发，字还偏绿，整页发浑发荧光；     */
    /* 这一版把强调色收到金色一支，青玉只出现在进度条与「正在进行」这类状态上。      */
    /* 对比度（WCAG）：正文 13.4:1、次文字 6.9:1、金色 7.9:1，均高于 AA。           */
    --c-imm-bg:          #0c1311;   /* 墨底 */
    --c-imm-bg-2:        #101917;   /* 页面顶部渐层 */
    --c-imm-panel:       #151f1c;   /* 面板 */
    --c-imm-panel-2:     #1a2521;   /* 面板顶部渐层 */
    --c-imm-tile:        #16211d;   /* 宫格底 */
    --c-imm-line:        #2a3833;   /* 常规描边 */
    --c-imm-line-soft:   #1f2a26;   /* 分隔线 */
    --c-imm-gold:        #cfae6d;   /* 旧金：唯一强调色 */
    --c-imm-gold-deep:   #b08f52;   /* 亮金下沿：只做实心按钮渐变的末端，不用它画描边 */
    --c-imm-gold-dim:    #5d4c2b;   /* 暗金：只用于描边 */
    --c-imm-gold-soft:   rgba(207, 174, 109, 0.10);
    --c-imm-text:        #ece5d8;   /* 暖白正文 */
    --c-imm-text-2:      #9daaa3;   /* 次要文字 */
    --c-imm-text-3:      #7d8b84;   /* 注脚 / 占位 */
    --c-imm-jade:        #8fbfa9;   /* 青玉：只用于进度与「进行中」 */
    --c-imm-track:       rgba(236, 229, 216, 0.10);
    --c-imm-danger:      #e0928a;   /* 警示文字：只用于不可撤销说明 */
    --c-imm-danger-soft: rgba(224, 146, 138, 0.10);   /* 警示块底 */
    --c-imm-mask:        rgba(4, 8, 7, 0.72);
    --c-imm-shadow:      0 24rpx 80rpx rgba(0, 0, 0, 0.55);

    /* ---------- 颜色：原生导航与 tabBar（与 theme.json 一一对应） ---------- */
    /* 四个主页面是恒定深色的仙箓皮肤，原生栏与 tabBar 必须同色，
       否则浅色系统下会拼出一条米白横条；明暗两套都取同一组值。 */
    --c-nav:             #0c1311;   /* @navBgColor */
    --c-tab:             #0c1311;   /* @tabBgColor */
    --c-tab-text:        #7d8a83;   /* @tabColor */
    --c-tab-active:      #cfae6d;   /* @tabSelectedColor */

    /* ---------- 字号阶梯（rpx，1sp ≈ 2rpx） ---------- */
    --fs-caption:        22rpx;     /* 角标 / 注脚，下限 */
    --fs-note:           24rpx;     /* 辅助说明 */
    --fs-body-sm:        26rpx;     /* 密集文本：指南条目 */
    --fs-body:           28rpx;     /* 正文 */
    --fs-subhead:        30rpx;     /* 区块标题 */
    --fs-h3:             32rpx;     /* 卡片标题 / 数值 */
    --fs-h2:             34rpx;     /* 小节标题 */
    --fs-lead:           40rpx;     /* 姓名 / 强调标题 */
    --fs-h1:             54rpx;     /* 页面大标题 */
    --fs-display:        76rpx;     /* 战力等大数字 */

    /* ---------- 行高 ---------- */
    --lh-tight:          1.25;
    --lh-head:           1.4;
    --lh-body:           1.65;
    --lh-loose:          1.7;

    /* ---------- 间距栅格（4rpx 基准） ---------- */
    --sp-1:              4rpx;
    --sp-2:              8rpx;
    --sp-3:              12rpx;
    --sp-4:              16rpx;
    --sp-5:              20rpx;
    --sp-6:              24rpx;
    --sp-8:              32rpx;
    --sp-10:             40rpx;
    --sp-12:             48rpx;
    --sp-16:             64rpx;
    --page-x:            28rpx;     /* 页面左右留白 */
    --page-top:          28rpx;
    --page-bottom:       60rpx;     /* 页面底部留白（不含安全区） */
    --card-pad:          28rpx;     /* 卡片内边距 */
    --card-gap:          24rpx;     /* 卡片间距 */
    --section-gap:       40rpx;     /* 区块间距 */
    --bar-height:        152rpx;    /* 吸底条占位高度 */

    /* ---------- 圆角 ---------- */
    --r-xs:              8rpx;
    --r-sm:              12rpx;
    --r-md:              16rpx;
    --r-lg:              24rpx;
    --r-xl:              28rpx;
    --r-pill:            999rpx;

    /* ---------- 阴影 ---------- */
    --sh-card:           0 6rpx 18rpx rgba(80, 68, 40, 0.05);
    --sh-bar:            0 -8rpx 24rpx rgba(40, 52, 44, 0.08);
    --sh-modal:          0 20rpx 60rpx rgba(30, 40, 34, 0.22);
    --sh-none:           none;

    /* ---------- 层级 ---------- */
    --z-base:            0;
    --z-sticky:          40;
    --z-countdown:       80;
    --z-mask:            90;
    --z-settle:          100;

    /* ---------- 触控 ---------- */
    --touch:             88rpx;     /* 主操作最小高度 */
    --touch-sm:          76rpx;     /* 次操作 */
    --touch-xs:          68rpx;     /* 卡片内紧凑操作 / 文字链 */

    /* ---------- 动效 ---------- */
    --dur-fast:          120ms;
    --dur-slow:          320ms;
    --ease:              cubic-bezier(0.2, 0.8, 0.2, 1);

    /* ---------- 安全区 ---------- */
    --safe-bottom:       env(safe-area-inset-bottom);
}

/* 暗色：只重定义令牌，页面样式一行都不用改。 */
@media (prefers-color-scheme: dark) {
    page {
        --c-bg:              #141a18;
        --c-surface:         #1e2723;
        --c-surface-2:       #24302a;
        --c-surface-3:       #1a221e;
        --c-surface-ink:     #24453c;
        --c-on-ink:          #e8eee9;
        --c-on-ink-2:        #9fb8aa;
        --c-border:          #33403a;
        --c-border-strong:   #4a5a51;
        --c-divider:         #2b3832;
        --c-text:            #e8eee9;
        --c-text-2:          #9aa79f;
        --c-text-3:          #7d8b83;
        --c-placeholder:     #7d8b83;

        --c-primary:         #2f6b5b;
        --c-primary-soft:    #24453c;
        --c-primary-on:      #f2f7f3;
        --c-primary-text:    #7fc9ae;
        --c-gold:            #8a6a2c;
        --c-gold-soft:       #3a3020;
        --c-gold-text:       #e0bb72;
        --c-danger:          #8f3b34;
        --c-danger-text:     #e89b92;
        --c-success:         #3d8c74;
        --c-success-text:    #9fd7bd;
        --c-neutral:         #9aa79f;
        --c-neutral-soft:    #2b3832;
        --c-link:            #8fd0b7;
        --c-track:           #33403a;
        --c-fill:            #6fc0a2;
        --c-mask:            rgba(0, 0, 0, 0.68);
        --c-ink-scrim:       rgba(0, 0, 0, 0.28);
        --c-ink-track:       rgba(255, 253, 247, 0.18);
        --c-ink-divider:     rgba(255, 253, 247, 0.16);
        --c-gold-bright:     #d8b775;

        /* 仙箓皮肤恒定深色：暗色模式下也保持同一套墨底金线，不做二次翻转。 */
        --c-imm-bg:          #0c1311;
        --c-imm-bg-2:        #101917;
        --c-imm-panel:       #151f1c;
        --c-imm-panel-2:     #1a2521;
        --c-imm-tile:        #16211d;
        --c-imm-line:        #2a3833;
        --c-imm-line-soft:   #1f2a26;
        --c-imm-gold:        #cfae6d;
        --c-imm-gold-deep:   #b08f52;
        --c-imm-gold-dim:    #5d4c2b;
        --c-imm-gold-soft:   rgba(207, 174, 109, 0.10);
        --c-imm-text:        #ece5d8;
        --c-imm-text-2:      #9daaa3;
        --c-imm-text-3:      #7d8b84;
        --c-imm-jade:        #8fbfa9;
        --c-imm-track:       rgba(236, 229, 216, 0.10);
        --c-imm-danger:      #e0928a;
        --c-imm-danger-soft: rgba(224, 146, 138, 0.10);
        --c-imm-mask:        rgba(4, 8, 7, 0.72);
        --c-imm-shadow:      0 24rpx 80rpx rgba(0, 0, 0, 0.55);

        --c-nav:             #0c1311;
        --c-tab:             #0c1311;
        --c-tab-text:        #7d8a83;
        --c-tab-active:      #cfae6d;

        --sh-card:           none;
        --sh-bar:            none;
        --sh-modal:          0 20rpx 60rpx rgba(0, 0, 0, 0.5);
    }
}
