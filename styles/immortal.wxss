/* ==========================================================================
   仙箓皮肤 · Immortal Skin
   --------------------------------------------------------------------------
   全部页面（主页 / 功法 / 人物 + 说明、日志、仙门、秘境、仙榜、称号簿）
   共用的视觉底座。规则五条：

     1. 纸与墨两档打底：宣纸做底、白纸做卡、墨褐做字。层级靠「纸压纸」的明度差
        与 1rpx 淡褐描边，不靠阴影堆叠。
     2. 彩色是信息，不是装饰：五支颜料色各绑一个系统（朱砂 = 主操作 / 当前项、
        石青 = 灵力 / 信息、石绿 = 进度、藤黄 = 灵石 / 贵重、绛紫 = 稀有）。
        同一屏同一个含义只给一种颜色；没有语义的地方一律墨褐，不为了好看上色。
     3. 卡片成组出现（.imm-list + .imm-row），不做一叠各带边框的独立小盒。
     4. 标题不做字间加空格、不加 ✦ 装饰；层级靠字号与字重，不靠字距。
     5. 按钮只有两种：朱砂实心（主操作）与细描边（次操作），高度统一 88 / 64rpx，
        line-height 锁 1，避免微信按钮默认行高把两枚按钮撑成不一样高。

   只引用 --c-imm-* / --sp-* 等令牌，不写裸色值；变更配色只改 tokens.wxss。
   ========================================================================== */

.pg--imm {
    --c-bg: var(--c-imm-bg);
    --c-surface: var(--c-imm-panel);
    --c-surface-2: var(--c-imm-panel-2);
    --c-surface-3: var(--c-imm-tile);
    --c-border: var(--c-imm-line);
    --c-border-strong: var(--c-imm-gold-dim);
    --c-divider: var(--c-imm-line-soft);
    --c-text: var(--c-imm-text);
    --c-text-2: var(--c-imm-text-2);
    --c-text-3: var(--c-imm-text-3);
    --c-placeholder: var(--c-imm-text-3);
    --c-primary: var(--c-imm-primary);
    --c-primary-on: var(--c-imm-panel);
    --c-primary-text: var(--c-imm-primary);
    --c-gold: var(--c-imm-gold);
    --c-success: var(--c-imm-jade);
    --c-success-text: var(--c-imm-jade);
    --c-danger: var(--c-imm-danger);
    --c-primary-soft: var(--c-imm-primary-soft);
    --c-gold-text: var(--c-imm-gold-text);
    --c-gold-soft: var(--c-imm-gold-soft);
    --c-link: var(--c-imm-azure);
    --c-track: var(--c-imm-track);
    --c-fill: var(--c-imm-jade);
    --c-neutral: var(--c-imm-text-2);
    --c-neutral-soft: var(--c-imm-panel-2);
    --c-danger-text: var(--c-imm-danger);
    --c-mask: var(--c-imm-mask);
    --c-surface-ink: var(--c-imm-text);
    --c-on-ink: var(--c-imm-panel);
    --c-on-ink-2: var(--c-imm-gold-dim);
    --c-ink-track: var(--c-imm-track);
    --c-ink-divider: var(--c-imm-line-soft);
    --c-ink-scrim: var(--c-imm-gold-soft);
    /* 底色走 background-color 兜住，顶部那层微亮单独挂在 background-image 上：
       它即便解析失败，页面仍是完整的一块墨，不会塌成「白底黑字的纯文本流」。 */
    background-color: var(--c-imm-bg);
    background-image: linear-gradient(to bottom, var(--c-imm-bg-2), transparent 360rpx);
    color: var(--c-imm-text);
    min-height: 100vh;
    padding-bottom: calc(var(--page-bottom) + var(--safe-bottom));
}

/* ---------- 页头：不再有返回、标题，也没有单独一行动作 ----------
   返回箭头与标题都由小程序原生导航栏承担，页面里再画一遍就是两层导航；
   「说明」原本占着顶部一行、右边一个字，把首屏上方整条留白——
   现在沉到页尾（.pg__foot），首屏直接接第一块面板。 */

/* 页头下一句引导：只有真需要一句的时候才用，默认不出现。 */
.imm-lead {
    display: block;
    color: var(--c-imm-text-3);
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body);
    margin: calc(0rpx - var(--sp-4)) 0 var(--sp-6);
}

/* ---------- 面板：白纸压宣纸 + 1rpx 淡褐描边 ---------- */
.imm-panel {
    box-sizing: border-box;
    border: 1rpx solid var(--c-imm-line);
    border-radius: var(--r-lg);
    background-color: var(--c-imm-panel);
    box-shadow: var(--sh-card);
    padding: var(--sp-6);
    margin-top: var(--sp-5);
}

.imm-panel__label {
    display: block;
    color: var(--c-imm-text-3);
    font-size: var(--fs-caption);
    letter-spacing: 4rpx;
}

.imm-panel__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-bottom: var(--sp-5);
}

.imm-panel__head .imm-panel__label { margin-bottom: 0; }

/* 境界大卡：名字 + 进度 + 两个关键数值 */
.imm-realm {
    display: block;
    color: var(--c-imm-text);
    font-size: var(--fs-lead);
    font-weight: 700;
    letter-spacing: 2rpx;
    margin-top: var(--sp-3);
}

.imm-bar {
    height: 8rpx;
    border-radius: var(--r-pill);
    background: var(--c-imm-track);
    overflow: hidden;
    margin-top: var(--sp-5);
}

.imm-bar__fill {
    height: 100%;
    border-radius: var(--r-pill);
    background: var(--c-imm-jade);
}

.imm-stats {
    display: flex;
    margin-top: var(--sp-5);
    padding-top: var(--sp-5);
    border-top: 1rpx solid var(--c-imm-line-soft);
}

.imm-stat { flex: 1; }

.imm-stat + .imm-stat {
    padding-left: var(--sp-6);
    border-left: 1rpx solid var(--c-imm-line-soft);
}

.imm-stat__label {
    display: block;
    color: var(--c-imm-text-3);
    font-size: var(--fs-caption);
    letter-spacing: 2rpx;
}

.imm-stat__value {
    display: block;
    color: var(--c-imm-text);
    font-size: var(--fs-h2);
    font-weight: 700;
    margin-top: var(--sp-2);
}

/* 三个数值按语义分色：战力是墨、灵力石青、灵石藤黄。
   分色不是为了好看，是让「哪一格是灵力」不用读字——主页每一屏都看这行。
   藤黄做文字必须走 --c-imm-gold-text（暗一档），--c-imm-gold 在纸上只有 2.5:1。 */
.imm-stat__value--power { color: var(--c-imm-text); }
.imm-stat__value--qi { color: var(--c-imm-azure); }
.imm-stat__value--stone { color: var(--c-imm-gold-text); }

/* 「96 / 174」里的分母：比主数小一号、压成灰，让上限读起来是注脚而不是第二个数。 */
.imm-stat__cap {
    color: var(--c-imm-text-3);
    font-size: var(--fs-caption);
    font-weight: 400;
}
/* 灵石那一格可点：主页唯一能花钱的地方。按压反馈交给统一的 .pressable，
   这里只把内边距补成负值，让热区比数字本身大一圈——数字那点高度不好按。 */
.imm-stat--tap {
    margin: -6rpx 0;
    padding: 6rpx 0;
}

/* 「兑」字小印：贴着标签，字号压到 caption 下一档，不抢灵石那个数。 */
.imm-stat__mark {
    margin-left: var(--sp-2);
    padding: 0 6rpx;
    border: 1rpx solid var(--c-imm-gold-dim);
    border-radius: 4rpx;
    color: var(--c-imm-primary);
    font-size: 18rpx;
    letter-spacing: 0;
}

/* 兑换弹层里的一句话劝告：解释「为什么换不了」，不是报错。 */
.exchange__hint {
    display: block;
    margin-top: var(--sp-4);
    line-height: 1.6;
    color: var(--c-imm-text-3);
}

/* 一行提示：一句话说下一步，不做胶囊盒 */
.imm-hint {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-top: var(--sp-5);
    padding: var(--sp-4) var(--sp-5);
    border-left: 4rpx solid var(--c-imm-primary);
    border-radius: 0 var(--r-sm) var(--r-sm) 0;
    background: var(--c-imm-primary-soft);
    color: var(--c-imm-text-2);
    font-size: var(--fs-body-sm);
    line-height: var(--lh-head);
}

.imm-hint__pin { color: var(--c-imm-primary); flex: none; }

/* ---------- 宫格：一整块 3×2 细线格，而不是六个小盒 ---------- */
/* 宫格：三个入口一行。现在只有五个入口（藏经阁并进了功法页），
   所以第一行 3 个、第二行 2 个并居中；最后一行只有两格，右侧那条竖线要收掉，
   否则右边会多出一道悬空的边框。 */
.imm-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--sp-5);
    border: 1rpx solid var(--c-imm-line);
    border-radius: var(--r-lg);
    background: var(--c-imm-tile);
    overflow: hidden;
}

.imm-tile {
    width: 33.3333%;
    box-sizing: border-box;
    border-right: 1rpx solid var(--c-imm-line-soft);
    border-bottom: 1rpx solid var(--c-imm-line-soft);
}

/* 六格：3 列 × 2 行，正好排满。末格右边框由 nth-child(3n) 收掉，
   最后一行三格都没有下边框——按「末两格」写会把第二行的第一格留一条线。 */
.imm-tile:nth-child(3n) { border-right: 0; }
.imm-tile:nth-last-child(-n + 3) { border-bottom: 0; }

.imm-tile__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 176rpx;
}

.imm-tile__glyph {
    color: var(--c-imm-text);
    font-size: 46rpx;
    font-weight: 500;
    line-height: 1;
}

/* 六格六色：tone 由 data/navigation.js 的 TILES 给，缺省落到墨褐。
   一个汉字一个色相，扫一眼就知道哪格是仙门、哪格是秘境，不用读四个字。 */
.imm-tile__glyph--cinnabar { color: var(--c-imm-primary); }
.imm-tile__glyph--azure { color: var(--c-imm-azure); }
.imm-tile__glyph--violet { color: var(--c-imm-violet); }
.imm-tile__glyph--gold { color: var(--c-imm-gold-text); }
.imm-tile__glyph--jade { color: var(--c-imm-jade); }
.imm-tile__glyph--ink { color: var(--c-imm-text-2); }

.imm-tile__label {
    color: var(--c-imm-text-2);
    font-size: var(--fs-body-sm);
    margin-top: var(--sp-3);
}

/* ---------- 分段切换：容器内一块底，两个格子等分 ---------- */
.imm-tabs {
    display: flex;
    padding: 4rpx;
    border: 1rpx solid var(--c-imm-line);
    border-radius: var(--r-md);
    background: var(--c-imm-bg-2);
}

.imm-tab {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 68rpx;
    border-radius: var(--r-sm);
    color: var(--c-imm-text-3);
    font-size: var(--fs-body-sm);
}

.imm-tab--on {
    background: var(--c-imm-primary-soft);
    color: var(--c-imm-primary);
    font-weight: 600;
}

/* ---------- 成组列表：一个外框，行内用发丝线分隔 ---------- */
.imm-list {
    border: 1rpx solid var(--c-imm-line);
    border-radius: var(--r-lg);
    background: var(--c-imm-panel);
    overflow: hidden;
    margin-top: var(--sp-5);
}

.imm-row {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    padding: var(--sp-5) var(--sp-6);
}

.imm-row + .imm-row { border-top: 1rpx solid var(--c-imm-line-soft); }

.imm-row--on {
    background: var(--c-imm-primary-soft);
    box-shadow: inset 4rpx 0 0 var(--c-imm-primary);
}

.imm-row--on .imm-row__name { color: var(--c-imm-primary); }

.imm-row__body { flex: 1; min-width: 0; }

.imm-row__name {
    display: block;
    color: var(--c-imm-text);
    font-size: var(--fs-h3);
    font-weight: 600;
}

.imm-row__sub {
    display: block;
    color: var(--c-imm-text-3);
    font-size: var(--fs-caption);
    margin-top: var(--sp-1);
}

.imm-row__value {
    color: var(--c-imm-primary);
    font-size: var(--fs-h3);
    font-weight: 600;
}

.imm-row__mark {
    width: 72rpx;
    height: 72rpx;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1rpx solid var(--c-imm-line);
    border-radius: var(--r-sm);
    color: var(--c-imm-primary);
    font-size: var(--fs-h3);
}

.imm-row__rank {
    width: 48rpx;
    flex: none;
    text-align: center;
    color: var(--c-imm-text-3);
    font-size: var(--fs-body-sm);
}

.imm-row__rank--top { color: var(--c-imm-gold-text); font-weight: 700; }

/* 列表内的迷你进度：比主进度条更细，只在有进度时出现 */
.imm-bar--thin { height: 6rpx; margin-top: var(--sp-2); }

/* 小标签：中性底 + 次要字，不抢主色 */
.imm-chip {
    display: inline-flex;
    align-items: center;
    padding: 2rpx var(--sp-3);
    border: 1rpx solid var(--c-imm-line);
    border-radius: var(--r-sm);
    color: var(--c-imm-text-2);
    font-size: var(--fs-caption);
    line-height: 1.6;
}

.imm-chip--jade { border-color: var(--c-imm-line); color: var(--c-imm-jade); }
.imm-chip--info { border-color: var(--c-imm-line); color: var(--c-imm-azure); }
.imm-chip--gold { border-color: var(--c-imm-gold-dim); color: var(--c-imm-gold-text); }

/* ---------- 属性格：2×2 细线格，与宫格同一套语言 ---------- */
.imm-attrs {
    display: flex;
    flex-wrap: wrap;
    margin-top: var(--sp-5);
    border: 1rpx solid var(--c-imm-line);
    border-radius: var(--r-lg);
    background: var(--c-imm-panel);
    overflow: hidden;
}

.imm-attr {
    width: 50%;
    box-sizing: border-box;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: var(--sp-4) var(--sp-5);
    border-bottom: 1rpx solid var(--c-imm-line-soft);
}

.imm-attr:nth-child(odd) { border-right: 1rpx solid var(--c-imm-line-soft); }
.imm-attr:nth-last-child(-n + 2) { border-bottom: 0; }

.imm-attr__name {
    color: var(--c-imm-text-3);
    font-size: var(--fs-body-sm);
}

.imm-attr__value {
    color: var(--c-imm-text);
    font-size: var(--fs-h3);
    font-weight: 600;
}

/* ---------- 修炼台 ---------- */
.imm-stage {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 380rpx;
    border: 1rpx solid var(--c-imm-line);
    border-radius: var(--r-lg);
    background: radial-gradient(circle at 50% 45%, var(--c-imm-panel-2), var(--c-imm-bg) 78%);
    margin-top: var(--sp-5);
    overflow: hidden;
}

.imm-stage__score {
    color: var(--c-imm-text-3);
    font-size: var(--fs-caption);
    letter-spacing: 2rpx;
    margin-bottom: var(--sp-5);
}

/* 键值行：左边名目、右边数值 */
.imm-strip {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    color: var(--c-imm-text-3);
    font-size: var(--fs-caption);
}

.imm-strip + .imm-strip { margin-top: var(--sp-3); }

.imm-strip__value { color: var(--c-imm-text); font-size: var(--fs-body-sm); }

/* ---------- 按钮：两种，高度固定，行高锁 1 ---------- */
.imm-btn,
.imm-btn--ghost {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    height: var(--touch);
    margin: 0;
    padding: 0 var(--sp-6);
    border: 0;
    border-radius: var(--r-md);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 2rpx;
}

/* 朱砂实心按钮用 background-color，不用 linear-gradient：
   渐变里再套 var() 一旦任何一个变量解析失败，整条 background 会被判为无效，
   按钮就退化成「一行没有底色的字」——真机上这种整条声明失效的坑很难查。
   层次感改由 1rpx 亮边 + 内阴影给，不依赖渐变。 */
.imm-btn {
    /* 底色放在 background-color、明暗层次单独挂在 background-image 上。
       两者分开写是必须的：若把渐变塞进 background 简写、色标又直接写变量，
       任何一个变量在个别环境里解析失败，整条 background 会被判为无效，
       按钮就退化成「一行没有底色的字」——真机上极难排查。 */
    background-color: var(--c-imm-primary);
    background-image: linear-gradient(to bottom, var(--c-imm-primary), var(--c-imm-primary-deep));
    color: var(--c-imm-panel);
    border: 1rpx solid var(--c-imm-primary);
}

.imm-btn--ghost {
    background: transparent;
    border: 1rpx solid var(--c-imm-line);
    color: var(--c-imm-text-2);
    font-weight: 500;
}

.imm-btn--sm {
    height: 64rpx;
    padding: 0 var(--sp-4);
    border-radius: var(--r-sm);
    font-size: var(--fs-note);
    letter-spacing: 1rpx;
}

.imm-btn--danger {
    border-color: var(--c-imm-line);
    color: var(--c-imm-danger);
}

.imm-btn--block { width: 100%; }
/* 禁用态：原生 button[disabled] 会把底色刷成浅灰，深色主题里会冒出一块亮斑。
   这里只压不透明度、换成面板底，让「按不了」读起来是暗下去，不是忽然变亮。 */
.imm-btn[disabled] {
    background-color: var(--c-imm-panel);
    background-image: none;
    border-color: var(--c-imm-line);
    color: var(--c-imm-text-3);
    opacity: 0.55;
}
.imm-btn--off {
    background: transparent;
    border: 1rpx solid var(--c-imm-line);
    color: var(--c-imm-text-3);
}

.imm-btn-row {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    margin-top: var(--sp-5);
}

.imm-btn-row > .imm-btn,
.imm-btn-row > .imm-btn--ghost { flex: 1; }

.pg--imm .modal__actions > .imm-btn,
.pg--imm .modal__actions > .imm-btn--ghost { flex: 1; }

.imm-empty {
    display: block;
    text-align: center;
    color: var(--c-imm-text-3);
    font-size: var(--fs-body-sm);
    padding: var(--sp-10) 0;
}

.pg--imm .pg__foot {
    margin-top: var(--sp-8);
    text-align: center;
    color: var(--c-imm-text-3);
}

/* 次要文字链（「展开」「离开」）用次文字色，既看得见是能点的，又不去抢金色主操作 */
.pg--imm .text-link.text-link--muted { color: var(--c-imm-text-2); }

/* 旧基础层的按钮在深色里重挂一次语义色，避免绿底 / 绿字混进墨金体系。 */
.pg--imm .btn--ghost {
    color: var(--c-imm-text-2);
    border-color: var(--c-imm-line);
}

.pg--imm .btn--plain {
    background: var(--c-imm-panel-2);
    color: var(--c-imm-text);
}
.pg--imm .text-link { color: var(--c-imm-primary); }

/* ---------- 说明 / 日志 / 称号共用的折叠分节 ---------- */
.help-sec {
    border: 1rpx solid var(--c-imm-line);
    border-radius: var(--r-md);
    background: var(--c-imm-panel);
    overflow: hidden;
    margin-top: var(--sp-4);
}

.help-sec__head {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    min-height: var(--touch);
    padding: 0 var(--sp-6);
    color: var(--c-imm-text);
}

.help-sec__idx {
    width: var(--sp-5);
    color: var(--c-imm-text-3);
    font-size: var(--fs-caption);
}

.help-sec__title {
    font-size: var(--fs-h3);
    font-weight: 600;
}

.help-sec__arrow {
    width: var(--sp-6);
    text-align: right;
    color: var(--c-imm-text-3);
    font-size: var(--fs-h3);
}

.help-sec__body {
    padding: var(--sp-5) var(--sp-6) var(--sp-6);
    border-top: 1rpx solid var(--c-imm-line-soft);
    color: var(--c-imm-text-2);
}

/* ---------- 深色下的弹层与标签：全局 .modal / .tag 是浅色口径 ---------- */
.pg--imm .modal {
    border: 1rpx solid var(--c-imm-line);
    background: var(--c-imm-panel);
    box-shadow: var(--c-imm-shadow);
}

.pg--imm .modal__title { color: var(--c-imm-text); }
.pg--imm .modal__sub { color: var(--c-imm-text-3); }

.pg--imm .tag {
    border: 1rpx solid var(--c-imm-line);
    background: transparent;
    color: var(--c-imm-text-2);
}

.pg--imm .tag--gold { border-color: var(--c-imm-gold-dim); color: var(--c-imm-gold-text); }
.pg--imm .tag--jade { border-color: var(--c-imm-line); color: var(--c-imm-jade); }

.pg--imm .divider { background: var(--c-imm-line-soft); }

.pg--imm .state__glyph { color: var(--c-imm-gold-dim); }
.pg--imm .state__desc { color: var(--c-imm-text-3); }
.pg--imm .state__title { color: var(--c-imm-text); }

/* 说明页 / 日志页顶部的小节标签 */
.imm-sec-title {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    color: var(--c-imm-text-3);
    font-size: var(--fs-caption);
    letter-spacing: 4rpx;
    margin: var(--sp-6) 0 var(--sp-2);
}

.imm-sec-title::after {
    content: "";
    flex: 1;
    height: 1rpx;
    background: var(--c-imm-line-soft);
}

/* ---------- 对手行：切磋与秘境共用 ---------- */
/* 名字与身份标记同行，下面是风味句、数值行、掉落行。
   卡片堆叠改成分组列表后，行内必须自己撑住四行信息的间距。
   这一组住在皮肤层，是因为「仙门切磋」与「秘境探索」是两页、两段数据，
   但「一个人/一处地方的战力与状态」是同一套排版，各写一份必然有一页先改。 */

.riv-head {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
}

.riv-desc {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* 风味句退到注脚色，战力与状态词提亮一档：
   两行同色同号时，四行字会糊成一段，看不出哪行是能决策的信息。 */
.riv-meta {
    display: flex;
    align-items: baseline;
    gap: var(--sp-5);
    margin-top: var(--sp-3);
    color: var(--c-imm-text-2);
    font-size: var(--fs-caption);
}

.riv-tone--good { color: var(--c-imm-jade); }
.riv-tone--warn { color: var(--c-imm-gold-text); }

.riv-drop {
    display: block;
    margin-top: var(--sp-2);
    color: var(--c-imm-gold-text);
    font-size: var(--fs-caption);
}

.riv-note {
    display: block;
    margin-top: var(--sp-2);
    color: var(--c-imm-text-3);
    font-size: var(--fs-caption);
}

/* 行内按钮不参与压缩，也不让名字把按钮挤成两行 */
.imm-row > .imm-btn { flex: none; }

/* 属性格第三行：这一项管什么。四项各有一件正事，写出来才知道该练谁。 */
.imm-attr__role {
    display: block;
    margin-top: var(--sp-1);
    color: var(--c-imm-text-3);
    font-size: var(--fs-caption);
}
