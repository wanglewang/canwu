/* 全局基础层：只定义「跨页面复用」的类，颜色 / 尺寸一律取自 styles/tokens.wxss。
   页面私有样式放各自 .wxss；玩法盘面主题放 styles/scene.wxss，不要往这里堆。 */
@import "./styles/tokens.wxss";
@import "./styles/immortal.wxss";
@import "./styles/scene.wxss";

page {
    min-height: 100%;
    background: var(--c-bg);
    color: var(--c-text);
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
    -webkit-font-smoothing: antialiased;
}

button {
    border-radius: var(--r-sm);
}

button::after {
    border: none;
}

/* ---------- 页面骨架 ---------- */
.pg {
    box-sizing: border-box;
    min-height: 100vh;
    padding: var(--page-top) var(--page-x) calc(var(--page-bottom) + env(safe-area-inset-bottom));
}

/* 页头：眉标 / 标题 / 一句说明；右上角可选挂一个文字动作，结构各页一致。 */
.pg__head {
    display: flex;
    flex-direction: column;
    margin: var(--sp-2) 0 var(--sp-6);
}

.pg__head-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    min-height: var(--sp-8);   /* 有右上动作时由 .text-link 的热区撑开 */
}

.pg__head-action {
    margin-top: 0;
    flex-shrink: 0;
}

.pg__foot {
    margin-top: var(--sp-8);
    text-align: center;
    color: var(--c-text-3);
    font-size: var(--fs-caption);
    letter-spacing: var(--sp-1);
}

/* ---------- 卡片与分隔 ---------- */
.card {
    box-sizing: border-box;
    padding: var(--card-pad);
    margin-bottom: var(--card-gap);
    border: 2rpx solid var(--c-border);
    border-radius: var(--r-lg);
    background: var(--c-surface);
    box-shadow: var(--sh-card);
}

.card--flat { box-shadow: var(--sh-none); }

.card--tight {
    padding: var(--sp-5) var(--sp-6);
}

.card--ink {
    background: var(--c-surface-ink);
    border-color: var(--c-surface-ink);
    color: var(--c-on-ink);
}

.divider {
    height: 2rpx;
    background: var(--c-divider);
    margin: var(--sp-5) 0;
}

/* ---------- 文字层级 ---------- */
.serif {
    font-family: "Songti SC", "STSong", "SimSun", serif;
}

.eyebrow {
    color: var(--c-gold-text);
    font-size: var(--fs-caption);
    font-weight: 600;
    letter-spacing: 5rpx;
}

.h1 {
    font-size: var(--fs-h1);
    font-weight: 700;
    line-height: var(--lh-tight);
    letter-spacing: var(--sp-1);
}

.h2 {
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-head);
}

.h3 {
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: var(--lh-head);
}

.body {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
}

.muted {
    color: var(--c-text-2);
    font-size: var(--fs-note);
    line-height: var(--lh-body);
}

.tiny {
    color: var(--c-text-3);
    font-size: var(--fs-caption);
    line-height: var(--lh-body);
}

.jade { color: var(--c-primary-text); }
.gold { color: var(--c-gold-text); }
.red  { color: var(--c-danger-text); }

.quote {
    color: var(--c-text-2);
    font-size: var(--fs-body-sm);
    line-height: var(--lh-loose);
}

/* ---------- 行与间距工具（只用栅格值，禁止随手写 13rpx / 18rpx） ---------- */
.row { display: flex; align-items: center; }
.row--between { display: flex; align-items: center; justify-content: space-between; }
.row--center { display: flex; align-items: center; justify-content: center; }
.row--wrap { display: flex; flex-wrap: wrap; }

.grow { flex: 1; min-width: 0; }
.gap { margin-right: var(--sp-3); }
.mt4 { margin-top: var(--sp-1); }
.mt8 { margin-top: var(--sp-2); }
.mt12 { margin-top: var(--sp-3); }
.mt16 { margin-top: var(--sp-4); }
.mt20 { margin-top: var(--sp-5); }
.mt24 { margin-top: var(--sp-6); }
.mt32 { margin-top: var(--sp-8); }
.mb8 { margin-bottom: var(--sp-2); }
.mb12 { margin-bottom: var(--sp-3); }
.mb16 { margin-bottom: var(--sp-4); }

/* ---------- 区块 ---------- */
.section { margin-top: var(--section-gap); }

.section__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-bottom: var(--sp-4);
}

.section__title {
    font-size: var(--fs-subhead);
    font-weight: 600;
    letter-spacing: var(--sp-1);
}

.section__sub {
    color: var(--c-text-2);
    font-size: var(--fs-caption);
    flex-shrink: 0;
}

/* ---------- 按钮 ---------- */
.btn {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-height: var(--touch);
    padding: 0 var(--sp-6);
    margin: 0;
    border: 2rpx solid transparent;
    border-radius: var(--r-md);
    font-size: var(--fs-body);
    font-weight: 600;
    line-height: var(--lh-tight);
    letter-spacing: var(--sp-1);
    transition: opacity var(--dur-fast) var(--ease);
}

.btn--primary { background: var(--c-primary); color: var(--c-primary-on); }
.btn--gold { background: var(--c-gold); color: var(--c-primary-on); }
.btn--red { background: var(--c-danger); color: var(--c-primary-on); }
.btn--ghost { background: transparent; color: var(--c-primary-text); border-color: var(--c-border-strong); }
.btn--plain { background: var(--c-surface-2); color: var(--c-text); }
.btn--warn { background: var(--c-danger-soft); color: var(--c-danger-text); border-color: var(--c-danger); }
.btn--block { width: 100%; }
.btn--small { min-height: var(--touch-sm); padding: 0 var(--sp-5); font-size: var(--fs-body-sm); }
.btn--compact { min-height: var(--touch-xs); padding: 0 var(--sp-5); font-size: var(--fs-note); }
.btn[disabled] { opacity: 0.45; }

.btn-row {
    display: flex;
    gap: var(--sp-4);
    margin-top: var(--sp-5);
}

/* .btn-row 自身带 20rpx 上边距，会覆盖 .mt12/.mt16，用修饰类显式指定 */
.btn-row--tight { margin-top: var(--sp-3); }
.btn-row--mid { margin-top: var(--sp-4); }
.btn-row--flush { margin-top: 0; }

.btn-row > .btn { flex: 1; }

.link-row {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--sp-5);
    margin-top: var(--sp-4);
}

/* 文字型点击入口：至少 68rpx 的可点高度，避免只有字宽能点中 */
.text-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-xs);
    padding: 0 var(--sp-2);
    color: var(--c-link);
    font-size: var(--fs-note);
    line-height: var(--lh-head);
}

.text-link--muted { color: var(--c-text-2); }

.icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-height: var(--touch-icon);
    padding: 0 var(--sp-5);
    border: 2rpx solid var(--c-border-strong);
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--c-text-2);
    font-size: var(--fs-caption);
    line-height: 1;
}

/* ---------- 按压反馈：可点 view 统一 hover-class="pressable--on" ---------- */
.pressable {
    transition: opacity var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
}

.pressable--on {
    opacity: 0.86;
    transform: scale(0.995);
}

/* ---------- 统一状态占位：加载 / 空 / 错误，不让页面白屏 ---------- */
.state {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 260rpx;
    padding: var(--sp-10) var(--sp-6);
    border: 2rpx dashed var(--c-border);
    border-radius: var(--r-lg);
    background: var(--c-surface);
    text-align: center;
}

.state--inline {
    min-height: 160rpx;
    padding: var(--sp-6);
}

.state__glyph {
    font-size: var(--fs-lead);
    color: var(--c-gold-text);
    line-height: 1;
}

.state__title {
    margin-top: var(--sp-3);
    color: var(--c-text);
    font-size: var(--fs-subhead);
    font-weight: 600;
}

.state__desc {
    margin-top: var(--sp-2);
    color: var(--c-text-2);
    font-size: var(--fs-note);
    line-height: var(--lh-body);
}

.state__action {
    margin-top: var(--sp-6);
    min-width: 240rpx;
}

/* ---------- 吸底主操作条 ---------- */
.sticky-bar {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: var(--z-sticky);
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    padding: var(--sp-4) var(--page-x) calc(var(--sp-4) + env(safe-area-inset-bottom));
    background: var(--c-surface);
    border-top: 2rpx solid var(--c-border);
    box-shadow: var(--sh-bar);
}

.sticky-bar > .btn { flex: 1; }

/* 局内工具条：按钮靠右不铺满，避免和盘面抢视线 */
.sticky-bar--tools {
    justify-content: flex-end;
    gap: var(--sp-3);
}

.sticky-bar--tools > .btn {
    flex: 0 0 auto;
    min-width: 208rpx;
}

.sticky-bar__side {
    font-size: var(--fs-caption);
    color: var(--c-text-2);
    text-align: right;
}

/* 提高优先级，避免被文件末尾的 .pg 安全区规则覆盖 */
.pg.pg--with-bar {
    padding-bottom: calc(var(--bar-height) + env(safe-area-inset-bottom));
}

/* ---------- 标签 ---------- */
.tag {
    display: inline-flex;
    align-items: center;
    padding: var(--sp-1) var(--sp-3);
    border-radius: var(--r-pill);
    font-size: var(--fs-caption);
    line-height: var(--lh-body);
    background: var(--c-neutral-soft);
    color: var(--c-neutral);
}

.tag--jade { background: var(--c-primary-soft); color: var(--c-primary-text); }
.tag--gold { background: var(--c-gold-soft); color: var(--c-gold-text); }
.tag--red { background: var(--c-danger-soft); color: var(--c-danger-text); }
.tag--grey { background: var(--c-neutral-soft); color: var(--c-text-2); }
.tag--dark { background: var(--c-ink-track); color: var(--c-on-ink); }

/* ---------- 进度条 ---------- */
.bar {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: var(--sp-3);
    border-radius: var(--r-pill);
    background: var(--c-track);
}

.bar__fill {
    height: 100%;
    border-radius: var(--r-pill);
    background: var(--c-fill);
}

.bar--dark { background: var(--c-ink-track); }
.bar--dark .bar__fill { background: var(--c-gold-bright); }

/* ---------- 数值 ---------- */
.stat-grid { display: flex; flex-wrap: wrap; }

.stat {
    box-sizing: border-box;
    width: 25%;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--sp-3) 0;
}

.stat__label { color: var(--c-text-2); font-size: var(--fs-caption); }
.stat__value { margin-top: var(--sp-2); font-size: var(--fs-h3); font-weight: 700; }

.big-number {
    font-size: var(--fs-display);
    font-weight: 700;
    line-height: 1;
    letter-spacing: var(--sp-1);
}

/* ---------- 弹层 ---------- */
.mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: var(--z-mask);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-12);
    background: var(--c-mask);
}

.modal {
    box-sizing: border-box;
    width: 100%;
    max-height: 82vh;
    overflow-y: auto;
    padding: var(--sp-10) var(--sp-8);
    border-radius: var(--r-xl);
    background: var(--c-surface);
    border: 2rpx solid var(--c-border);
    box-shadow: var(--sh-modal);
}

.modal__title {
    font-size: var(--fs-lead);
    font-weight: 700;
    text-align: center;
    letter-spacing: var(--sp-1);
}

.modal__sub {
    margin-top: var(--sp-2);
    text-align: center;
    color: var(--c-text-2);
    font-size: var(--fs-note);
}

.modal__body { margin-top: var(--sp-6); }

.modal__actions {
    display: flex;
    gap: var(--sp-4);
    margin-top: var(--sp-8);
}

.modal__actions > .btn { flex: 1; }

/* ---------- 评级与结果行 ---------- */
.grade {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 136rpx;
    height: 136rpx;
    margin: 0 auto;
    border-radius: 50%;
    font-size: var(--fs-display);
    font-weight: 700;
    line-height: 1;
    color: var(--c-on-ink);
}

.empty-state {
    padding: var(--sp-16) var(--sp-5);
    text-align: center;
    color: var(--c-text-3);
    font-size: var(--fs-body-sm);
}

.res-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding: var(--sp-3) 0;
    border-bottom: 2rpx solid var(--c-divider);
}

.res-note { padding: var(--sp-1) 0; }

.pr-tiny { color: var(--c-on-ink-2); }

/* ---------- 表单 / 码输入 ---------- */
.code-box {
    box-sizing: border-box;
    padding: var(--sp-4) var(--sp-5);
    border-radius: var(--r-sm);
    background: var(--c-surface-2);
    color: var(--c-primary-text);
    font-size: var(--fs-body-sm);
    font-weight: 600;
    letter-spacing: var(--sp-1);
    word-break: break-all;
}

.code-input {
    box-sizing: border-box;
    width: 100%;
    height: var(--touch-sm);
    padding: 0 var(--sp-5);
    border: 2rpx solid var(--c-border);
    border-radius: var(--r-sm);
    background: var(--c-surface);
    color: var(--c-text);
    font-size: var(--fs-note);
}

.code-ph {
    color: var(--c-placeholder);
    font-size: var(--fs-note);
}

/* ---------- 深色卡内部：显式工具类，不用通配覆盖，保住文字层次 ---------- */
.on-ink { color: var(--c-on-ink); }
.on-ink-2 { color: var(--c-on-ink-2); }

.card--ink .divider { background: var(--c-ink-divider); }

.card--ink .bar { background: var(--c-ink-track); }

/* ---------- 登录页分支（唯一不使用 .pg 的页面） ---------- */
.login-page {
    padding-bottom: calc(var(--sp-16) + env(safe-area-inset-bottom));
}

/* ---------- 暗色模式 ----------
   绝大多数适配已在 tokens.wxss 通过重定义变量完成；这里只兜底评级圆章
   这类由内联 style 注入底色、需要固定亮字的元素。 */
@media (prefers-color-scheme: dark) {
    .grade { color: var(--c-on-ink); }
}
