<view class="pg pg--with-bar">
  <view class="pg__head">
    <text class="eyebrow">洞 府</text>
    <text class="h1 serif">参悟</text>
    <text class="muted mt8">等是保底，练才是加速。</text>
    <text class="guide-link text-link mt8" bindtap="onGoGuide">修行指南 ›</text>
  </view>

  <view wx:if="{{syncTone !== 'ok'}}" class="alert-bar alert-bar--{{syncTone}}" bindtap="onRetrySync">
    <text class="alert-bar__text">{{syncLabel}}</text>
    <text class="alert-bar__action">重试 ›</text>
  </view>

  <view wx:if="{{viewState === 'loading'}}" class="card">
    <text class="muted">正在推演气机…</text>
  </view>
  <view wx:elif="{{viewState === 'error'}}" class="card">
    <text class="h3">读取存档失败</text>
    <button class="btn btn--primary mt16" bindtap="refresh">重试</button>
  </view>

  <block wx:if="{{viewState === 'ready' && ov}}">
    <view class="card card--ink hero-card">
      <view class="row--between">
        <text class="tag tag--dark">{{ov.worldLabel}} · {{ov.worldName}}</text>
        <text class="tag tag--dark">{{ov.equippedTitleName}}</text>
      </view>
      <view class="hero-id">
        <portrait variant="{{ov.portrait}}" realm="{{ov.realmIndex}}" size="small" />
        <view class="hero-id__text">
          <text class="serif hero-name">{{ov.roleName}}</text>
          <text class="tag tag--gold">{{ov.realmName}}</text>
        </view>
      </view>
      <view class="hero-power mt16">
        <text class="tiny hero-label">战 力</text>
        <text class="big-number hero-num">{{ov.power}}</text>
      </view>
      <view class="divider hero-divider"></view>
      <view class="stat-grid">
        <view class="stat" wx:for="{{ov.attrs}}" wx:key="key">
          <text class="stat__label hero-label">{{item.name}}</text>
          <text class="stat__value hero-num">{{item.value}}</text>
        </view>
      </view>
      <view class="divider hero-divider"></view>
      <view class="row--between">
        <text class="tiny hero-label">{{ov.resource}} {{ov.qi}}</text>
        <text class="tiny hero-label">{{ov.currency}} {{ov.stone}}</text>
        <text wx:if="{{ov.buff.active}}" class="tag tag--dark">挂机 ×{{ov.buff.multiplier}} · {{ov.buff.minutes}} 分</text>
      </view>
    </view>

    <view class="card">
      <view class="section__head">
        <text class="section__title">今日参悟</text>
        <text class="section__sub">{{ov.daily.count}} / {{ov.daily.target}} 次</text>
      </view>
      <view class="bar">
        <view class="bar__fill" style="width:{{dailyPercent}}%"></view>
      </view>
      <button wx:if="{{!ov.daily.claimed && ov.daily.count >= ov.daily.target}}" class="btn btn--gold btn--block mt16" bindtap="onClaimDaily">领取份例 · 灵气 +{{ov.daily.qi}} / 灵石 +{{ov.daily.stone}}</button>
      <text wx:elif="{{ov.daily.claimed}}" class="tag tag--jade mt16">今日份例已领</text>
      <text wx:else class="tiny mt12">再参悟 {{ov.daily.target - ov.daily.count}} 次，可领今日份例。</text>
    </view>

    <view class="card">
      <view class="section__head">
        <text class="section__title">境界 · {{ov.realmName}}</text>
        <text class="section__sub">{{ov.realmIndex + 1}} / {{ov.realmCount}}</text>
      </view>
      <block wx:if="{{!ov.breakthrough.maxed}}">
        <text class="body">下一境「{{ov.breakthrough.nextName}}」需战力 {{ov.breakthrough.need}}，当前 {{ov.breakthrough.power}}。</text>
        <view class="bar mt12">
          <view class="bar__fill" style="width:{{breakPercent}}%;background:#b8893b"></view>
        </view>
        <button wx:if="{{ov.breakthrough.available}}" class="btn btn--gold btn--block mt16" bindtap="onBreakthrough">冲击 {{ov.breakthrough.nextName}}</button>
      </block>
      <text wx:else class="body">已至当前最高境界。青云界之外，还有别的世界。</text>
    </view>

    <view class="section">
      <view class="section__head">
        <text class="section__title">就差一点</text>
        <text class="section__sub text-link" bindtap="onGoSkills">全部功法 ›</text>
      </view>
      <view class="card card--tight" wx:for="{{quickSkills}}" wx:key="id">
        <view class="row--between">
          <view>
            <text class="h3">{{item.name}}</text>
            <text class="tiny">{{item.methodName}}</text>
          </view>
          <text class="tag" style="color:{{item.tierColor}}">{{item.tierName}}</text>
        </view>
        <view class="bar mt12">
          <view class="bar__fill" style="width:{{item.percent}}%;background:{{item.tierColor}}"></view>
        </view>
        <view class="row--between mt12">
          <text class="tiny">{{item.nextText}}</text>
          <button class="btn btn--ghost btn--small" data-id="{{item.id}}" bindtap="onPractice">去参悟</button>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section__head">
        <text class="section__title">近况</text>
        <text class="section__sub text-link" bindtap="onGoProfile">道牒 ›</text>
      </view>
      <view class="card" wx:if="{{ov.log.length > 0}}">
        <view class="log-line" wx:for="{{ov.log}}" wx:key="at">
          <text class="tiny">· {{item.text}}</text>
        </view>
      </view>
      <view wx:else class="card"><text class="muted">还没有动静，先去参悟一局吧。</text></view>
    </view>

    <view class="section">
      <view class="section__head">
        <text class="section__title">世界</text>
        <text class="section__sub text-link" bindtap="onToggleWorld">{{worldOpen ? '收起' : '此界之外 · 展开 ›'}}</text>
      </view>
      <block wx:if="{{worldOpen}}">
        <view class="card card--tight world-row" wx:for="{{worlds}}" wx:key="id">
          <view class="grow">
            <view class="row">
              <text class="h3">{{item.label}} · {{item.name}}</text>
              <text wx:if="{{item.enabled}}" class="tag tag--jade">进行中</text>
              <text wx:else class="tag tag--grey">敬请期待</text>
            </view>
            <text class="tiny mt8">{{item.intro}}</text>
          </view>
        </view>
      </block>
    </view>
  </block>

  <view wx:if="{{viewState === 'ready' && ov}}" class="sticky-bar">
    <button class="btn btn--primary btn--block" bindtap="onQuickPractice">{{quickLabel}}</button>
  </view>

  <view class="mask" wx:if="{{showOffline && offline}}">
    <view class="modal">
      <text class="eyebrow">闭 关 收 获</text>
      <text class="modal__title serif mt12">你不在的时候，也没闲着</text>
      <text class="modal__sub">离线 {{offline.duration}} · 最多累计 8 小时</text>
      <view class="modal__body">
        <view class="res-line">
          <text class="muted">灵气</text>
          <text class="h3 jade">+{{offline.qi}}</text>
        </view>
        <view class="res-line">
          <text class="muted">{{offline.skillName}} 熟练度</text>
          <text class="h3 jade">+{{offline.prof}}</text>
        </view>
      </view>
      <text wx:if="{{offline.capped}}" class="tiny mt12">超过 8 小时的部分不累计，回来练一局更快。</text>
      <text wx:if="{{offline.buffMinutes > 0}}" class="tiny mt8">其中 {{offline.buffMinutes}} 分钟带着挂机加成。</text>
      <view class="modal__actions">
        <button class="btn btn--primary btn--block" bindtap="closeOffline">收下，去练一局</button>
      </view>
    </view>
  </view>

  <view class="pg__foot">参 悟 · 不玩也在变强，玩了明显更快</view>
</view>
