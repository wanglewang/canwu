<view class="pg pg--imm pg--with-bar">
  <view class="imm-head">
    <text class="imm-head__slot"></text>
    <text class="imm-head__title">参悟</text>
    <text class="imm-head__action pressable" hover-class="pressable--on" bindtap="onGoHelp">说明</text>
  </view>

  <!-- 只在同步出问题时出现，正常状态不占任何文字。 -->
  <view wx:if="{{syncTone !== 'ok'}}" class="alert-bar alert-bar--{{syncTone}} pressable" hover-class="pressable--on" bindtap="onRetrySync">
    <text class="alert-bar__text">{{syncLabel}}</text>
    <text class="alert-bar__action">{{copy.actions.retry}} ›</text>
  </view>

  <view wx:if="{{viewState === 'loading'}}" class="state">
    <text class="state__glyph">◇</text>
    <text class="state__desc">{{copy.loading}}</text>
  </view>
  <view wx:elif="{{viewState === 'error'}}" class="state">
    <text class="state__title">{{copy.errorTitle}}</text>
    <text class="state__desc">{{copy.errorDesc}}</text>
    <button class="imm-btn imm-btn--block" bindtap="refresh">{{copy.actions.retry}}</button>
  </view>

  <block wx:if="{{viewState === 'ready' && ov}}">
    <view class="imm-panel">
      <view class="imm-panel__head">
        <text class="imm-panel__label">{{ov.roleName}}</text>
        <text class="imm-chip">境界 {{ov.realmIndex + 1}} / {{ov.realmCount}}</text>
      </view>
      <text class="imm-realm">{{ov.realmName}}</text>
      <view class="imm-bar"><view class="imm-bar__fill" style="width:{{breakPercent}}%"></view></view>
      <view class="imm-strip">
        <text>突破 {{ov.breakthrough.maxed ? '已至大圆满' : '所需战力 ' + ov.breakthrough.need}}</text>
        <text class="imm-strip__value">{{breakPercent}}%</text>
      </view>
      <view class="imm-stats">
        <view class="imm-stat">
          <text class="imm-stat__label">战 力</text>
          <text class="imm-stat__value">{{ov.power}}</text>
        </view>
        <view class="imm-stat">
          <text class="imm-stat__label">灵 气</text>
          <text class="imm-stat__value">{{ov.qi}}</text>
        </view>
        <view class="imm-stat">
          <text class="imm-stat__label">灵 石</text>
          <text class="imm-stat__value">{{ov.stone}}</text>
        </view>
      </view>
    </view>

    <view class="imm-hint">
      <text class="imm-hint__pin">◆</text>
      <text class="grow">{{hintText}}</text>
    </view>

    <view wx:if="{{dailyReady}}" class="imm-list">
      <view class="imm-row pressable" hover-class="pressable--on" bindtap="onClaimDaily">
        <view class="imm-row__body">
          <text class="imm-row__name">{{copy.sections.today}}</text>
          <text class="imm-row__sub">{{dailyGain}}</text>
        </view>
        <text class="imm-row__value">领取 ›</text>
      </view>
    </view>

    <view class="imm-grid">
      <view class="imm-tile" wx:for="{{tiles}}" wx:key="key">
        <view class="imm-tile__inner pressable" hover-class="pressable--on" data-key="{{item.key}}" bindtap="onTile">
          <text class="imm-tile__glyph">{{item.glyph}}</text>
          <text class="imm-tile__label">{{item.label}}</text>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{viewState === 'ready' && ov}}" class="sticky-bar">
    <button class="imm-btn imm-btn--block" bindtap="onQuickPractice">{{quickLabel}}</button>
  </view>

  <view class="mask" wx:if="{{showOffline && offline}}">
    <view class="modal">
      <text class="modal__title">闭关收获</text>
      <text class="modal__sub">离线 {{offline.duration}} · 最多累计 8 小时</text>
      <view class="modal__body">
        <view class="res-line">
          <text class="muted">灵气</text>
          <text class="h3 jade">+{{offline.qi}}</text>
        </view>
        <view class="res-line">
          <text class="muted">{{offline.skillName}} 熟练度</text>
          <text class="h3 jade">+{{offline.prof}}</text>
        </view>
      </view>
      <view class="modal__actions">
        <button class="imm-btn imm-btn--block" bindtap="closeOffline">{{copy.actions.confirm}}</button>
      </view>
    </view>
  </view>
</view>
