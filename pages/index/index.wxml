<view class="pg pg--imm pg--t-{{themeTone}} pg--with-bar">
  <!-- 只在同步出问题时出现，正常状态不占任何文字。 -->
  <view wx:if="{{syncTone !== 'ok'}}" class="alert-bar alert-bar--{{syncTone}} pressable" hover-class="pressable--on" bindtap="onRetrySync">
    <text class="alert-bar__text">{{syncLabel}}</text>
    <text class="alert-bar__action">{{copy.actions.retry}} ›</text>
  </view>

  <view wx:if="{{viewState === 'loading'}}" class="state">
    <text class="state__glyph">◇</text>
    <text class="state__desc">{{copy.loading}}</text>
  </view>
  <view wx:elif="{{viewState === 'error'}}" class="state">
    <text class="state__title">{{copy.errorTitle}}</text>
    <text class="state__desc">{{copy.errorDesc}}</text>
    <button class="imm-btn imm-btn--block" bindtap="refresh">{{copy.actions.retry}}</button>
  </view>

  <block wx:if="{{viewState === 'ready' && ov}}">
    <view class="imm-panel">
      <view class="imm-panel__head">
        <text class="imm-panel__label">{{ov.roleName}}</text>
        <text class="imm-chip">境界 {{ov.realmIndex + 1}} / {{ov.realmCount}}</text>
      </view>
      <text class="imm-realm">{{ov.realmName}}</text>
      <view class="imm-bar"><view class="imm-bar__fill" style="width:{{breakPercent}}%"></view></view>
      <view class="imm-strip">
        <text>突破 {{ov.breakthrough.maxed ? '已至大圆满' : '战力'}}</text>
        <text class="imm-strip__value">{{ov.breakthrough.maxed ? '—' : ov.power + ' / ' + ov.breakthrough.need}}</text>
      </view>
      <view wx:if="{{rankText}}" class="imm-strip">
        <text>{{copy.labels.rank}}</text>
        <text class="imm-strip__value imm-strip__value--rank">{{rankText}}{{rankGapText}}</text>
      </view>
      <view class="imm-stats">
        <view class="imm-stat">
          <text class="imm-stat__label">战 力</text>
          <text class="imm-stat__value">{{ov.power}}</text>
        </view>
        <view class="imm-stat">
          <text class="imm-stat__label">灵 力</text>
          <text class="imm-stat__value">{{ov.qi}}<text class="imm-stat__cap">/{{ov.qiMax}}</text></text>
        </view>
        <!-- 灵石是主页唯一能花的东西：点这一格开兑换。标一个「兑」字，
             否则没人会想到数字能点。 -->
        <view class="imm-stat imm-stat--tap pressable" hover-class="pressable--on" bindtap="onOpenExchange">
          <text class="imm-stat__label">灵 石<text class="imm-stat__mark">兑</text></text>
          <text class="imm-stat__value">{{ov.stone}}</text>
        </view>
      </view>
    </view>

    <view class="imm-hint">
      <text class="imm-hint__pin">◆</text>
      <text class="grow">{{hintText}}</text>
    </view>

    <view wx:if="{{idleReady}}" class="imm-list">
      <view class="imm-row pressable" hover-class="pressable--on" bindtap="onMeditate">
        <view class="imm-row__body">
          <text class="imm-row__name">闭关打坐</text>
          <text class="imm-row__sub">{{idleText}}</text>
        </view>
        <text class="imm-row__value">{{copy.actions.claim}} ›</text>
      </view>
    </view>

    <view class="imm-list">
      <view wx:if="{{dailyReady}}" class="imm-row pressable" hover-class="pressable--on" bindtap="onClaimDaily">
        <view class="imm-row__body">
          <text class="imm-row__name">{{copy.sections.today}}</text>
          <text class="imm-row__sub">{{dailyGain}}</text>
        </view>
        <text class="imm-row__value">{{dailyAction}}</text>
      </view>
      <!-- 未凑满时这一行也在：玩家得看得见「今天走了几局」，才知道还差几次。 -->
      <view wx:else class="imm-row">
        <view class="imm-row__body">
          <text class="imm-row__name">{{copy.sections.today}}</text>
          <text class="imm-row__sub">{{copy.labels.todayDone}} {{dailyCount}} / {{dailyTarget}} · {{copy.labels.dailyLeft}} {{dailyLeft}} {{copy.labels.times}}</text>
        </view>
      </view>
    </view>

    <view class="imm-grid">
      <view class="imm-tile" wx:for="{{tiles}}" wx:key="key">
        <view class="imm-tile__inner pressable" hover-class="pressable--on" data-key="{{item.key}}" bindtap="onTile">
          <text class="imm-tile__glyph">{{item.glyph}}</text>
          <text class="imm-tile__label">{{item.label}}</text>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{viewState === 'ready' && ov}}" class="sticky-bar">
    <button class="imm-btn imm-btn--block" bindtap="onQuickPractice">{{quickLabel}}</button>
  </view>

  <view class="mask" wx:if="{{showOffline && offline}}">
    <view class="modal">
      <text class="modal__title">闭关收获</text>
      <text class="modal__sub">离线 {{offline.duration}} · 最多累计 8 小时</text>
      <view class="modal__body">
        <view class="res-line">
          <text class="muted">灵力</text>
          <text class="h3 jade">+{{offline.qi}}<text class="imm-stat__cap"> / {{offline.qiCap}}</text></text>
        </view>
        <view wx:if="{{offline.overflowText}}" class="res-line">
          <text class="muted">{{offline.overflowText}}</text>
        </view>
      </view>
      <view class="modal__actions">
        <button class="imm-btn imm-btn--block" bindtap="closeOffline">{{copy.actions.claim}}</button>
      </view>
    </view>
  </view>

  <!-- 灵石兑灵力：只此一向。反向（灵力换灵石）永远不开——挂机时长印钱是所有刷法的入口，
       这一条写在 data/economy.js 的文件头。 -->
  <view class="mask" wx:if="{{showExchange && exchange}}" bindtap="onCloseExchange">
    <view class="modal" catchtap="noop">
      <text class="modal__title">灵石兑灵力</text>
      <text class="modal__sub">1 枚灵石 = {{exchange.rate}} 点灵力 · 换来即刻可用</text>
      <view class="modal__body">
        <view class="res-line">
          <text class="muted">灵石</text>
          <text class="h3">{{exchange.stone}} 枚</text>
        </view>
        <view class="res-line">
          <text class="muted">灵力</text>
          <text class="h3 jade">{{exchange.qi}} / {{exchange.cap}}</text>
        </view>
        <view class="res-line">
          <text class="muted">气海空位</text>
          <text class="h3">{{exchange.room}} 点</text>
        </view>
        <text class="tiny muted exchange__hint">{{exchange.hint}}</text>
      </view>
      <view class="modal__actions">
        <button class="imm-btn imm-btn--ghost" bindtap="onCloseExchange">收起</button>
        <button class="imm-btn" disabled="{{!exchange.ready}}" bindtap="onExchange">兑 1 枚 · +{{exchange.rate}}</button>
      </view>
    </view>
  </view>

  <view class="pg__foot">
    <text class="text-link text-link--muted pressable" hover-class="pressable--on" bindtap="onGoHelp">本页说明 ›</text>
  </view>
</view>
