.hero-card {
    padding: 32rpx;
}

.hero-name {
    font-size: 40rpx;
    font-weight: 700;
    color: #fffdf7;
    margin-right: 16rpx;
}

.hero-label {
    color: #b9c9bf;
}

.hero-num {
    color: #fffdf7;
}

.hero-power {
    display: flex;
    flex-direction: column;
}

.hero-divider {
    background: rgba(255, 253, 247, 0.16);
}

.log-line {
    padding: 8rpx 0;
    border-bottom: 2rpx solid #f4efe3;
}

.log-line:last-child {
    border-bottom: none;
}

.world-row {
    opacity: 1;
}

.world-row .tag {
    margin-left: 14rpx;
}

.guide-link {
    display: inline-flex;
    align-items: center;
    min-height: 64rpx;
    padding: 0 10rpx;
    font-size: 24rpx;
    color: #2f6b5b;
}

.hero-id {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-top: 16rpx;
}

.hero-id__text {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-left: 8rpx;
}

.alert-bar {
    display: flex;
    flex-direction: row;
    align-items: center;
    box-sizing: border-box;
    padding: 18rpx 22rpx;
    margin-bottom: 20rpx;
    border-radius: 14rpx;
    border: 2rpx solid #e3ddcd;
    background: #fffdf7;
}

.alert-bar--warn {
    border-color: #d8b775;
    background: #fbf3e2;
}

.alert-bar--error {
    border-color: #b4453c;
    background: #f9ebe8;
}

.alert-bar__text {
    flex: 1;
    font-size: 23rpx;
    color: #5d6358;
    line-height: 1.5;
}

.alert-bar--error .alert-bar__text { color: #8f3b34; }

.alert-bar__action {
    font-size: 22rpx;
    color: #2f6b5b;
    margin-left: 12rpx;
}
