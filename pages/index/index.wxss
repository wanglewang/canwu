/* 主页：一张境界卡 + 一行提示 + 一整块六宫格。除此之外不放任何说明文字。 */
.pg--imm .sticky-bar {
    background: var(--c-imm-bg);
    border-top: 1rpx solid var(--c-imm-line-soft);
    box-shadow: var(--sh-none);
}

.pg--imm .alert-bar {
    border: 1rpx solid var(--c-imm-gold-dim);
    background: var(--c-imm-gold-soft);
    color: var(--c-imm-text);
}

.pg--imm .alert-bar__text { color: var(--c-imm-text); }
.pg--imm .alert-bar__action { color: var(--c-imm-gold); }

/* 突破进度那一行的左字比右侧百分比更重要一点 */
.imm-strip + .imm-strip { margin-top: var(--sp-2); }
