/* 说明页只定义自己的行内排版，折叠分节骨架在 styles/immortal.wxss 全局共用。 */

/* 导航栏只说「说明」，这行补上「说明的是哪一页」；
   它不是页内标题，不做居中与字距，跟着正文左对齐。 */
.help-topic {
    display: block;
    color: var(--c-imm-gold);
    font-size: var(--fs-lead);
    font-weight: 600;
    margin-top: var(--sp-3);
}

.pg--imm .imm-lead { margin-top: var(--sp-2); }

.help-line {
    display: flex;
    align-items: flex-start;
    margin-top: var(--sp-4);
}

.help-line__dot {
    width: var(--sp-6);
    color: var(--c-imm-gold);
    font-size: var(--fs-body);
}

.help-line__text {
    color: var(--c-imm-text-2);
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body);
}

.help-term {
    display: flex;
    align-items: flex-start;
    margin-top: var(--sp-4);
}

.help-term__name {
    width: 168rpx;
    flex: none;
    color: var(--c-imm-gold);
    font-size: var(--fs-body-sm);
}

.help-term__desc {
    color: var(--c-imm-text-2);
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body);
}
