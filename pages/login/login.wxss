/* 登录页：唯一不使用 .pg 的品牌页，根容器挂 .pg--imm 接入全站墨金映射，
   间距 / 字号 / 颜色仍取自全局令牌；json 里不写死导航栏配色。 */
.login-page {
    min-height: 100vh;
    padding: var(--sp-16) var(--sp-10);
    /* 页面 wxss 的 padding 简写会盖掉全局兜底，安全区必须在这里再写一次 */
    padding-bottom: calc(var(--sp-16) + env(safe-area-inset-bottom));
    box-sizing: border-box;
    background: var(--c-bg);
    color: var(--c-text);
}

.login-brand { margin-bottom: var(--sp-12); }

/* 品牌字用旧金，与四页的标题体系一致；原先取的是--c-primary-text（青玉） */
.login-brand-name {
    display: block;
    font-size: var(--fs-h1);
    font-weight: 600;
    letter-spacing: var(--sp-2);
    color: var(--c-imm-gold);
}

.login-brand-sub {
    display: block;
    margin-top: var(--sp-4);
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body);
    color: var(--c-text-2);
}

/* 微信登录 = 主操作：金色实心，高度与行高和全站按钮同口径（微信按钮默认行高 2.55 会撑高） */
.btn-wechat {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    width: 100%;
    height: var(--touch);
    padding: 0 var(--sp-6);
    background: linear-gradient(to bottom, var(--c-imm-gold), var(--c-imm-gold-dim));
    color: var(--c-imm-bg);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1;
    letter-spacing: var(--sp-1);
    border-radius: var(--r-md);
}

.btn-wechat::after { border: none; }

.login-hint {
    display: block;
    margin-top: var(--sp-4);
    text-align: center;
    font-size: var(--fs-note);
    color: var(--c-text-2);
}

.login-alt {
    margin-top: var(--sp-16);
    padding: var(--sp-5);
    min-height: var(--touch-xs);
    text-align: center;
}

.login-alt-text {
    font-size: var(--fs-body-sm);
    color: var(--c-link);
    text-decoration: underline;
}

.login-email { margin-top: var(--sp-2); }

.login-note {
    margin-top: var(--sp-8);
    padding: var(--sp-6) var(--sp-8);
    background: var(--c-surface);
    border-radius: var(--r-lg);
    font-size: var(--fs-note);
    line-height: var(--lh-loose);
    color: var(--c-text-2);
}

.login-error {
    display: block;
    margin-top: var(--sp-6);
    font-size: var(--fs-body-sm);
    color: var(--c-danger-text);
}

.login-busy {
    display: block;
    margin-top: var(--sp-6);
    font-size: var(--fs-body-sm);
    color: var(--c-link);
}
