.login-page {
    min-height: 100vh;
    padding: 64rpx 40rpx;
    box-sizing: border-box;
    background: #f2eee4;
}

.login-brand {
    margin-bottom: 48rpx;
}

.login-brand-name {
    display: block;
    font-size: 52rpx;
    font-weight: 500;
    letter-spacing: 8rpx;
    color: #2f6b5b;
}

.login-brand-sub {
    display: block;
    margin-top: 16rpx;
    font-size: 26rpx;
    line-height: 1.6;
    color: #8a8f83;
}

.btn-wechat {
    margin-top: 8rpx;
    background: #2f6b5b;
    color: #fffdf7;
    font-size: 30rpx;
    letter-spacing: 2rpx;
    border-radius: 14rpx;
}

.btn-wechat::after {
    border: none;
}

.login-hint {
    display: block;
    margin-top: 18rpx;
    text-align: center;
    font-size: 24rpx;
    color: #8a8f83;
}

.login-alt {
    margin-top: 56rpx;
    padding: 20rpx;
    text-align: center;
}

.login-alt-text {
    font-size: 26rpx;
    color: #2f6b5b;
    text-decoration: underline;
}

.login-email {
    margin-top: 8rpx;
}

.login-note {
    margin-top: 36rpx;
    padding: 24rpx 28rpx;
    background: #fffdf7;
    border-radius: 18rpx;
    font-size: 24rpx;
    line-height: 1.7;
    color: #6f7569;
}

.login-error {
    display: block;
    margin-top: 24rpx;
    font-size: 26rpx;
    color: #b4453c;
}

.login-busy {
    display: block;
    margin-top: 24rpx;
    font-size: 26rpx;
    color: #2f6b5b;
}
