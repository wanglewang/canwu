.login-page {
    min-height: 100vh;
    padding: 64rpx 40rpx;
    box-sizing: border-box;
    background: #f2eee4;
}

.login-brand {
    margin-bottom: 48rpx;
}

.login-brand-name {
    display: block;
    font-size: 52rpx;
    font-weight: 500;
    letter-spacing: 8rpx;
    color: #2f6b5b;
}

.login-brand-sub {
    display: block;
    margin-top: 16rpx;
    font-size: 26rpx;
    line-height: 1.6;
    color: #8a8f83;
}

.login-note {
    margin-top: 36rpx;
    padding: 24rpx 28rpx;
    background: #fffdf7;
    border-radius: 18rpx;
    font-size: 24rpx;
    line-height: 1.7;
    color: #6f7569;
}

.login-error {
    display: block;
    margin-top: 24rpx;
    font-size: 26rpx;
    color: #b4453c;
}

.login-busy {
    display: block;
    margin-top: 24rpx;
    font-size: 26rpx;
    color: #2f6b5b;
}
