/* 登录页：唯一不使用 .pg 的品牌页，但间距 / 字号 / 颜色仍取自全局令牌，
   且不再在 json 里写死浅色导航栏（暗色下会变成白条）。 */
.login-page {
    min-height: 100vh;
    padding: var(--sp-16) var(--sp-10);
    /* 页面 wxss 的 padding 简写会盖掉全局兜底，安全区必须在这里再写一次 */
    padding-bottom: calc(var(--sp-16) + env(safe-area-inset-bottom));
    box-sizing: border-box;
    background: var(--c-bg);
}

.login-brand { margin-bottom: var(--sp-12); }

.login-brand-name {
    display: block;
    font-size: var(--fs-h1);
    font-weight: 500;
    letter-spacing: var(--sp-2);
    color: var(--c-primary-text);
}

.login-brand-sub {
    display: block;
    margin-top: var(--sp-4);
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body);
    color: var(--c-text-2);
}

.btn-wechat {
    margin-top: var(--sp-2);
    min-height: var(--touch);
    background: var(--c-primary);
    color: var(--c-primary-on);
    font-size: var(--fs-subhead);
    letter-spacing: var(--sp-1);
    border-radius: var(--r-md);
}

.btn-wechat::after { border: none; }

.login-hint {
    display: block;
    margin-top: var(--sp-4);
    text-align: center;
    font-size: var(--fs-note);
    color: var(--c-text-2);
}

.login-alt {
    margin-top: var(--sp-16);
    padding: var(--sp-5);
    min-height: var(--touch-xs);
    text-align: center;
}

.login-alt-text {
    font-size: var(--fs-body-sm);
    color: var(--c-link);
    text-decoration: underline;
}

.login-email { margin-top: var(--sp-2); }

.login-note {
    margin-top: var(--sp-8);
    padding: var(--sp-6) var(--sp-8);
    background: var(--c-surface);
    border-radius: var(--r-lg);
    font-size: var(--fs-note);
    line-height: var(--lh-loose);
    color: var(--c-text-2);
}

.login-error {
    display: block;
    margin-top: var(--sp-6);
    font-size: var(--fs-body-sm);
    color: var(--c-danger-text);
}

.login-busy {
    display: block;
    margin-top: var(--sp-6);
    font-size: var(--fs-body-sm);
    color: var(--c-link);
}
