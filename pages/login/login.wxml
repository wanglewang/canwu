<view class="login-page">
    <view class="login-brand">
        <text class="login-brand-name">参悟</text>
        <text class="login-brand-sub">登录后接续你的修行</text>
    </view>

    <button class="btn-wechat" bindtap="onWechatLogin" disabled="{{busy}}" loading="{{busy}}">微信一键登录</button>
    <text class="login-hint">无需密码，用当前微信身份开始</text>

    <view class="login-alt" bindtap="toggleEmail">
        <text class="login-alt-text">{{showEmail ? '收起邮箱登录' : '使用邮箱验证码登录'}}</text>
    </view>
    <view class="login-email" wx:if="{{showEmail}}">
        <login-panel bind:signedin="onSignedIn" />
    </view>

    <view class="login-note">
        <text>已有本机进度？登录后到「道牒」页导出存档码，再导入即可。</text>
    </view>
    <text class="login-error" wx:if="{{reason}}">{{reason}}</text>
    <text class="login-error" wx:if="{{error}}">{{error}}</text>
    <text class="login-busy" wx:if="{{busy}}">正在读取云端存档…</text>
</view>
