/* 功法页：一张紧凑列表 + 一个图鉴弹窗。
   每张卡片固定三行：正名 + 品阶 / 一行元信息 / 进度条，右侧动作按钮宽度锁死。
   名字与元信息一律 nowrap + ellipsis：中文一旦被 flex 压到一字宽就会竖排，
   真机上整张卡片会被撑成半屏高，这里从根上挡住。 */
.imm-row > .imm-row__body {
    flex: 1 1 0;
    width: 0;
    min-width: 0;
}

.imm-row > .sk-act {
    flex: none;
    width: 160rpx;
    padding: 0 var(--sp-2);
    white-space: nowrap;
}

.sk-line {
    display: flex;
    align-items: center;
    min-width: 0;
}

.sk-name {
    flex: 1 1 0;
    min-width: 0;
    display: block;
    color: var(--c-imm-text);
    font-size: var(--fs-h3);
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.sk-tier {
    flex: none;
    margin-left: var(--sp-3);
}

.sk-meta {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* 藏经阁分区第三行：代价或获取途径。用金色弱一档，和上面那行「玩法 · 盘面」分开读。 */
.sk-cost {
    display: block;
    color: var(--c-imm-gold-dim);
    font-size: var(--fs-caption);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* 身家条贴着标签走：上下留白比常规 panel 小一半，免得把列表挤下去。 */
.sk-wallet {
    padding: var(--sp-4) var(--sp-5);
}

/* 阶段只分三档，颜色全由语义令牌给：未入门弱化、大成以上旧金，常规仍是青玉。 */
.imm-bar--dim .imm-bar__fill { background: var(--c-imm-text-3); }
.imm-bar--gold .imm-bar__fill { background: var(--c-imm-gold); }

/* ---------- 图鉴弹窗 ---------- */
.modal--codex { padding: var(--sp-8); }

.codex__text {
    display: block;
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body);
    color: var(--c-imm-text-2);
    margin-top: var(--sp-4);
}

.codex__block {
    margin-top: var(--sp-6);
    padding-top: var(--sp-5);
    border-top: 1rpx solid var(--c-imm-line-soft);
}

.codex__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
}

.codex__title {
    display: block;
    color: var(--c-imm-text);
    font-size: var(--fs-body);
    font-weight: 600;
}

.codex__more {
    color: var(--c-imm-gold);
    font-size: var(--fs-caption);
    padding: var(--sp-1) 0 var(--sp-1) var(--sp-4);
}

.codex__note {
    display: block;
    color: var(--c-imm-text-3);
    font-size: var(--fs-caption);
    line-height: var(--lh-body);
    margin-top: var(--sp-2);
}

.codex__value {
    color: var(--c-imm-gold);
    font-size: var(--fs-body);
    font-weight: 600;
    flex: none;
}

.codex__step {
    display: flex;
    gap: var(--sp-2);
    color: var(--c-imm-text-2);
    font-size: var(--fs-caption);
    line-height: var(--lh-body);
    margin-top: var(--sp-2);
}

.codex__dot { color: var(--c-imm-gold-dim); flex: none; }

.codex__term {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    margin-top: var(--sp-2);
}

.codex__term .imm-chip { flex: none; }

.codex__kv {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-top: var(--sp-3);
}

.codex__warn { color: var(--c-danger-text); }
