/* 功法页私有样式：原先这里手写了整套暗色覆盖，现在统一由 tokens.wxss 重定义变量，
   页面不再维护第二套色板。 */
.skill-card { margin-bottom: var(--sp-4); }

.skill-card--dim { background: var(--c-surface-3); }

.skill-type { margin-left: var(--sp-3); }

.skill-rank {
    margin-left: var(--sp-2);
    font-size: var(--fs-caption);
}

.skill-best {
    margin-left: var(--sp-3);
    color: var(--c-text-2);
}

.tag--warn {
    margin-left: var(--sp-2);
    background: var(--c-danger-soft);
    color: var(--c-danger-text);
}

.warn-line {
    display: block;
    color: var(--c-danger-text);
    line-height: var(--lh-body);
}

.chain-card { padding-bottom: var(--sp-4); }

.chain-row {
    border-top: 2rpx solid var(--c-divider);
    padding-top: var(--sp-3);
}

.chain-row__label {
    display: block;
    font-size: var(--fs-note);
    color: var(--c-text-2);
    margin-bottom: var(--sp-2);
}

.chain-node {
    display: inline-block;
    margin: 0 var(--sp-2) var(--sp-2) 0;
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--r-xs);
    background: var(--c-neutral-soft);
    color: var(--c-text-2);
    font-size: var(--fs-caption);
    line-height: var(--lh-body);
}

.chain-node--got {
    background: var(--c-primary-soft);
    color: var(--c-success-text);
}

.chain-node--empty {
    background: transparent;
    border: 2rpx dashed var(--c-border-strong);
    color: var(--c-text-3);
}

.rank-detail {
    border: 2rpx solid var(--c-border);
    border-radius: var(--r-sm);
    padding: var(--sp-4) var(--sp-5);
    background: var(--c-surface-2);
}
