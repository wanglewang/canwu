/* 功法页：一张列表 + 一个图鉴弹窗。列表每行只有名字、进度、品阶与一个动作。 */
.skill-name {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
}

.skill-name .imm-chip { flex: none; }

/* ---------- 图鉴弹窗 ---------- */
.modal--codex { padding: var(--sp-8); }

.codex__text {
    display: block;
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body);
    color: var(--c-imm-text-2);
    margin-top: var(--sp-4);
}

.codex__block {
    margin-top: var(--sp-6);
    padding-top: var(--sp-5);
    border-top: 1rpx solid var(--c-imm-line-soft);
}

.codex__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
}

.codex__title {
    display: block;
    color: var(--c-imm-text);
    font-size: var(--fs-body);
    font-weight: 600;
}

.codex__more {
    color: var(--c-imm-gold);
    font-size: var(--fs-caption);
    padding: var(--sp-1) 0 var(--sp-1) var(--sp-4);
}

.codex__note {
    display: block;
    color: var(--c-imm-text-3);
    font-size: var(--fs-caption);
    line-height: var(--lh-body);
    margin-top: var(--sp-2);
}

.codex__value {
    color: var(--c-imm-gold);
    font-size: var(--fs-body);
    font-weight: 600;
    flex: none;
}

.codex__step {
    display: flex;
    gap: var(--sp-2);
    color: var(--c-imm-text-2);
    font-size: var(--fs-caption);
    line-height: var(--lh-body);
    margin-top: var(--sp-2);
}

.codex__dot { color: var(--c-imm-gold-dim); flex: none; }

.codex__term {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    margin-top: var(--sp-2);
}

.codex__term .imm-chip { flex: none; }

.codex__kv {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-top: var(--sp-3);
}

.codex__warn { color: var(--c-danger-text); }
