<view class="pg">
  <view class="pg__head">
    <text class="eyebrow">藏 经 阁</text>
    <text class="h1 serif">功法</text>
    <text class="muted mt8">十三门功法，十族玩法，品阶定收益。</text>
  </view>

  <view wx:if="{{ov}}" class="card card--ink">
    <view class="row--between">
      <text class="tiny pr-tiny">已习 {{ov.unlockedCount}} / {{ov.skillTotal}} 门</text>
      <text class="tiny pr-tiny">{{ov.resource}} {{ov.qi}} · {{ov.currency}} {{ov.stone}}</text>
    </view>
    <view class="row--wrap mt16">
      <text class="tag tag--dark" wx:for="{{legend}}" wx:key="key">{{item.name}} {{item.threshold}}</text>
    </view>
  </view>

  <view class="card chain-card">
    <view class="row--between">
      <text class="section__title">功法谱系</text>
      <text class="tag tag--grey">黄 → 天</text>
    </view>
    <view wx:for="{{families}}" wx:key="type" class="chain-row mt12">
      <view class="row--between">
        <text class="chain-row__label">{{item.label}}</text>
        <text class="tiny">{{item.kindLabel}}</text>
      </view>
      <view class="row--wrap mt8">
        <text wx:for="{{item.slots}}" wx:for-item="node" wx:key="id" class="chain-node {{node.empty ? 'chain-node--empty' : ''}} {{node.unlocked ? 'chain-node--got' : ''}}">{{node.tierName}} · {{node.name}}</text>
      </view>
    </view>
  </view>

  <block wx:for="{{cards}}" wx:key="id">
    <view wx:if="{{item.showHeader}}" class="section">
      <view class="section__head">
        <text class="section__title">{{item.groupTitle}}</text>
        <text class="section__sub">{{item.groupSub}}</text>
      </view>
    </view>
    <view class="card card--tight skill-card {{item.dim ? 'skill-card--dim' : ''}}" data-id="{{item.id}}" bindtap="openDetail">
      <view class="row--between">
        <view class="row">
          <text class="h3">{{item.name}}</text>
          <text class="tag tag--grey skill-type">{{item.type}}</text>
          <text class="tag skill-rank" style="background:{{item.tierColor}};color:#fffdf7">{{item.tierLabel}} {{item.starsText}}</text>
        </view>
        <text wx:if="{{item.unlocked}}" class="tag" style="color:{{item.profTierColor}}">{{item.profTierName}}</text>
        <text wx:elif="{{item.canBuy}}" class="tag tag--gold">可兑换</text>
        <text wx:else class="tag tag--grey">未得</text>
      </view>
      <text class="tiny mt8">{{item.desc}}</text>
      <view class="row mt8">
        <text class="tag tag--jade">{{item.gameName}}</text>
        <text wx:if="{{item.bestText}}" class="tiny skill-best">最佳 {{item.bestText}}</text>
      </view>
      <view class="row mt8">
        <text class="tiny">{{item.rewardText}}</text>
        <text wx:if="{{item.decayed}}" class="tag tag--warn">衰减中</text>
      </view>
      <block wx:if="{{item.unlocked}}">
        <view class="bar mt12">
          <view class="bar__fill" style="width:{{item.percent}}%;background:{{item.profTierColor}}"></view>
        </view>
        <view class="row--between mt8">
          <text class="tiny">{{item.prof}} 熟练度</text>
          <text class="tiny">{{item.nextText}}</text>
        </view>
      </block>
      <block wx:elif="{{item.canBuy}}">
        <view class="row--between mt12">
          <text class="tiny">{{item.costText}}</text>
          <text class="tag {{item.affordable ? 'tag--jade' : 'tag--grey'}}">{{item.affordable ? '资源已足' : '资源不足'}}</text>
        </view>
        <text wx:if="{{!item.realmOk}}" class="tiny warn-line mt8">需「{{item.needRealmName}}」境界方能修习</text>
      </block>
      <text wx:else class="tiny mt12">{{item.sourceText}}</text>
    </view>
  </block>

  <view class="mask" wx:if="{{showDetail && detail}}" bindtap="closeDetail">
    <view class="modal" catchtap="noop">
      <view class="row--between">
        <text class="tag tag--grey">{{detail.type}}</text>
        <text class="tag" style="background:{{detail.tierColor}};color:#fffdf7">{{detail.tierLabel}} {{detail.starsText}}</text>
      </view>
      <text class="modal__title serif mt12">{{detail.name}}</text>
      <text class="modal__sub">{{detail.gameName}}</text>

      <view class="rank-detail mt12">
        <view class="row--between">
          <text class="tag tag--gold">{{detail.tierLabel}} · {{detail.rewardText}}</text>
          <text class="tiny">{{detail.maxRealmName}}以内不衰减</text>
        </view>
        <text wx:if="{{detail.decayed}}" class="warn-line mt8">{{detail.decayText}}</text>
        <text wx:if="{{detail.bestText}}" class="tiny mt8">最佳 {{detail.bestText}}</text>
      </view>

      <view class="modal__body">
        <text class="body">{{detail.desc}}</text>
        <text class="quote mt12">{{detail.flavor}}</text>
        <view class="divider"></view>
        <view class="res-line">
          <text class="muted">属性加成</text>
          <text class="h3 jade">{{detail.bonusText}}</text>
        </view>
        <view class="res-line">
          <text class="muted">大成特效</text>
          <text class="h3 {{detail.effectUnlocked ? 'gold' : 'muted'}}">{{detail.effectText}}</text>
        </view>
        <view class="res-line">
          <text class="muted">获取方式</text>
          <text class="tiny">{{detail.sourceText}}</text>
        </view>
        <block wx:if="{{detail.unlocked}}">
          <view class="res-line">
            <text class="muted">熟练度</text>
            <text class="h3">{{detail.prof}} · {{detail.profTierName}}</text>
          </view>
          <view class="bar mt12">
            <view class="bar__fill" style="width:{{detail.percent}}%;background:{{detail.profTierColor}}"></view>
          </view>
          <text class="tiny mt8">{{detail.nextText}}</text>
        </block>
      </view>

      <view class="modal__actions">
        <button class="btn btn--plain" bindtap="closeDetail">关闭</button>
        <button wx:if="{{detail.unlocked}}" class="btn btn--primary" bindtap="onPractice">去参悟</button>
        <button wx:elif="{{detail.canBuy}}" class="btn btn--gold" disabled="{{!canAfford || !detail.realmOk}}" bindtap="onBuy">{{detail.realmOk ? '兑换' : '境界不足'}}</button>
      </view>
    </view>
  </view>

  <view class="pg__foot">一 门 一 法 · 各 有 门 道</view>
</view>
