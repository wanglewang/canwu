<view class="pg pg--imm">
  <view class="imm-tabs">
    <view class="imm-tab {{tab === 'learned' ? 'imm-tab--on' : ''}} pressable" hover-class="pressable--on" data-tab="learned" bindtap="onTab">{{copy.skillsTabs.learned}} {{learnedCount}}</view>
    <view class="imm-tab {{tab === 'shop' ? 'imm-tab--on' : ''}} pressable" hover-class="pressable--on" data-tab="shop" bindtap="onTab">{{copy.skillsTabs.shop}} {{shopCount}}</view>
  </view>

  <!-- 藏经阁分区才报身家：已持玉简里看的是熟练度，不是还有多少灵气。 -->
  <view wx:if="{{tab === 'shop'}}" class="imm-panel sk-wallet">
    <view class="imm-stats">
      <view class="imm-stat">
        <text class="imm-stat__label">灵 气</text>
        <text class="imm-stat__value">{{qi}}</text>
      </view>
      <view class="imm-stat">
        <text class="imm-stat__label">灵 石</text>
        <text class="imm-stat__value">{{stone}}</text>
      </view>
      <view class="imm-stat">
        <text class="imm-stat__label">未 得</text>
        <text class="imm-stat__value">{{shopCount}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{!ov}}" class="state">
    <text class="state__glyph">◇</text>
    <text class="state__desc">{{copy.loading}}</text>
  </view>

  <view wx:elif="{{cards.length === 0}}" class="imm-panel">
    <text class="imm-empty">{{copy.emptySkills}}</text>
  </view>

  <view wx:else class="imm-list">
    <view class="imm-row pressable" hover-class="pressable--on" wx:for="{{cards}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
      <view class="imm-row__mark">{{item.mark}}</view>
      <view class="imm-row__body">
        <view class="sk-line">
          <text class="sk-name">{{item.cardName}}</text>
          <text class="imm-chip sk-tier">{{item.tierLabel}}</text>
        </view>
        <text class="imm-row__sub sk-meta">{{item.metaText}}</text>
        <!-- 藏经阁分区：这一行只回答「怎么拿到」——能换的写代价，不能换的写获取途径。 -->
        <text wx:if="{{item.costText}}" class="imm-row__sub sk-cost">{{item.costText}}</text>
        <view wx:if="{{item.percent > 0}}" class="imm-bar imm-bar--thin {{item.barTone}}">
          <view class="imm-bar__fill" style="width:{{item.percent}}%"></view>
        </view>
      </view>
      <button wx:if="{{item.actionText}}" class="imm-btn--ghost imm-btn--sm sk-act" data-id="{{item.id}}" catchtap="onCardAction">{{item.actionText}}</button>
    </view>
  </view>

  <!-- 图鉴：还没拿到的也能查全本，锁的只有开练。分节短、可展开，不再一口气堆全文。 -->
  <view class="mask" wx:if="{{showDetail && detail}}" bindtap="closeDetail">
    <view class="modal modal--codex" catchtap="noop">
      <view class="row--between">
        <text class="imm-chip">{{detail.type}}</text>
        <text class="imm-chip {{detail.unlocked ? 'imm-chip--jade' : ''}}">{{detail.stateText}}</text>
      </view>
      <text class="modal__title">{{detail.name}}</text>
      <text class="modal__sub">{{detail.methodName}} · {{detail.gameName}} · {{detail.tierLabel}}</text>

      <text class="body codex__text">{{detail.desc}}</text>
      <text class="quote codex__text">{{detail.flavor}}</text>

      <view class="codex__block">
        <view class="codex__head">
          <text class="codex__title">{{copy.sections.codexPlay}}</text>
          <text class="codex__more" bindtap="onToggleGuide">{{guideOpen ? copy.actions.collapse : copy.actions.expand}}</text>
        </view>
        <text class="codex__text">{{detail.previewRule}}</text>
        <text class="codex__note">{{detail.previewInline}}</text>
        <block wx:if="{{guideOpen && detail.guide}}">
          <view class="codex__step" wx:for="{{detail.guide.steps}}" wx:for-item="line" wx:key="*this">
            <text class="codex__dot">·</text>
            <text class="grow">{{line}}</text>
          </view>
          <view class="codex__term" wx:for="{{detail.guide.terms}}" wx:for-item="t" wx:key="name">
            <text class="imm-chip grow">{{t.name}}</text>
            <text class="codex__note grow">{{t.desc}}</text>
          </view>
          <text class="codex__note">{{detail.guide.scoring}}</text>
          <text class="codex__note">{{detail.guide.tip}}</text>
        </block>
      </view>

      <view class="codex__block">
        <text class="codex__title">{{copy.sections.codexGain}}</text>
        <view class="codex__kv" wx:for="{{detail.gainLines}}" wx:for-item="line" wx:key="label">
          <text class="codex__note grow">{{line.label}}</text>
          <text class="codex__value">{{line.value}}</text>
        </view>
        <block wx:if="{{detail.stageRules.length > 0}}">
          <view class="codex__kv" wx:for="{{detail.stageRules}}" wx:for-item="r" wx:key="name">
            <text class="codex__note grow">{{r.atName}} · {{r.name}}</text>
            <text class="codex__note">{{r.desc}}</text>
          </view>
        </block>
      </view>

      <view class="codex__block">
        <text class="codex__title">{{copy.sections.codexUnlock}}</text>
        <block wx:if="{{!detail.unlocked}}">
          <view class="codex__kv">
            <text class="codex__note grow">{{detail.unlock.label}}</text>
            <text class="imm-chip">{{detail.unlock.text}}</text>
          </view>
          <text wx:if="{{detail.unlock.hint}}" class="codex__note">{{detail.unlock.hint}}</text>
          <view wx:if="{{detail.unlock.percent > 0}}" class="imm-bar imm-bar--thin">
            <view class="imm-bar__fill" style="width:{{detail.unlock.percent}}%"></view>
          </view>
          <!-- 门槛只挡「还没到」：已到门槛但超了收益上限的（金丹练黄阶），照样能修习，只是收益打折。 -->
          <text wx:if="{{!detail.realmReady}}" class="codex__note codex__warn">需「{{detail.needRealmName}}」境界方能修习</text>
        </block>
        <block wx:else>
          <view class="codex__kv">
            <text class="codex__note grow">{{detail.prof}} 熟练度 · {{detail.profTierName}}</text>
            <text class="codex__note">{{detail.nextText}}</text>
          </view>
          <view class="imm-bar imm-bar--thin">
            <view class="imm-bar__fill" style="width:{{detail.percent}}%"></view>
          </view>
          <text class="codex__note">连 {{detail.sStreakGoal}} 局 S 直接晋一段 · 已连 {{detail.sStreak}} 局</text>
          <text wx:if="{{detail.bestText}}" class="codex__note">最佳 {{detail.bestText}}</text>
          <!-- 已习得的门如果境界吃亏，说清「还能练，只是只剩三成」，不要让人以为这门作废了。 -->
          <text wx:if="{{detail.decayed}}" class="codex__note codex__warn">{{detail.decayText}}</text>
        </block>
      </view>

      <view class="modal__actions">
        <button class="imm-btn--ghost" bindtap="closeDetail">{{copy.actions.close}}</button>
        <button class="imm-btn" disabled="{{detail.primary.disabled}}" bindtap="onPrimary">{{detail.primary.text}}</button>
      </view>
    </view>
  </view>

  <view class="pg__foot">
    <text class="text-link text-link--muted pressable" hover-class="pressable--on" bindtap="onGoHelp">本页说明 ›</text>
  </view>
</view>
