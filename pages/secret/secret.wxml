<view class="pg pg--imm">
  <view wx:if="{{ov}}" class="imm-panel">
    <view class="imm-panel__head">
      <text class="imm-panel__label">{{copy.sections.myPower}}</text>
      <text class="imm-chip">{{ov.equippedTitleName}}</text>
    </view>
    <text class="imm-realm">{{ov.power}}</text>
    <view class="imm-strip">
      <text>{{ov.realmName}} · {{ov.roleName}}</text>
      <text>不掉功法，只产资源</text>
    </view>
  </view>
  <view wx:else class="state">
    <text class="state__glyph">◇</text>
    <text class="state__desc">{{copy.loading}}</text>
  </view>

  <view class="imm-sec-title">{{copy.sections.secrets}}</view>
  <view class="imm-list">
    <view class="imm-row" wx:for="{{secrets}}" wx:key="id">
      <view class="imm-row__body">
        <view class="riv-head">
          <text class="imm-row__name">{{item.name}}</text>
          <text class="imm-chip {{item.cleared ? 'imm-chip--jade' : ''}}">{{item.cleared ? copy.states.walked : copy.states.unwalked}}</text>
        </view>
        <text class="imm-row__sub riv-desc">{{item.desc}}</text>
        <view class="riv-meta">
          <text>战力 {{item.power}}</text>
          <text class="riv-tone--{{item.hintTone}}">{{item.hint}}</text>
        </view>
        <text class="riv-note">{{item.cleared ? '再走一遍收益不变' : '首次走通再 +5 灵石'}} · <text class="myst-gain">灵气 +{{item.qi}} · 灵石 +{{item.stone}}</text></text>
      </view>
      <button class="imm-btn imm-btn--sm imm-btn--ghost" data-id="{{item.id}}" bindtap="onFight">{{item.cleared ? copy.actions.reenter : copy.actions.enterSecret}}</button>
    </view>
  </view>

  <duel-result show="{{showResult}}" result="{{result}}" bind:close="closeResult" />

  <view class="pg__foot">
    <text class="text-link text-link--muted pressable" hover-class="pressable--on" bindtap="onGoHelp">本页说明</text>
    <text class="pg__foot__sep">·</text>
    <text class="text-link text-link--muted pressable" hover-class="pressable--on" bindtap="onGoGuide">完整规则 ›</text>
  </view>
</view>
