/* 道牒页：身份卡走 .imm-idcard（墨底 + 细金线，见 styles/immortal.wxss 的语义变量），
   旧版浅底道牒卡的 .idcard 一族已随改版删掉。 */

.share-canvas {
    position: fixed;
    top: -3000px;
    left: 0;
    width: 600px;
    height: 880px;
}

.role-editor__preview {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-top: var(--sp-6);
}

.role-editor__name {
    margin-left: var(--sp-6);
    font-size: var(--fs-h3);
    color: var(--c-text);
    font-weight: 500;
}

.role-editor__input {
    box-sizing: border-box;
    width: 100%;
    height: var(--touch-sm);
    padding: 0 var(--sp-5);
    background: var(--c-surface-2);
    border: 2rpx solid var(--c-border-strong);
    border-radius: var(--r-sm);
    font-size: var(--fs-body);
    color: var(--c-text);
}

.sync-bar {
    display: flex;
    flex-direction: row;
    align-items: center;
    box-sizing: border-box;
    padding: var(--sp-4) var(--sp-6);
    margin-bottom: var(--sp-4);
    border-radius: var(--r-md);
    border: 2rpx solid var(--c-border);
    background: var(--c-surface);
}

.sync-bar__dot {
    width: var(--sp-3);
    height: var(--sp-3);
    border-radius: 50%;
    margin-right: var(--sp-3);
    background: var(--c-success);
    flex-shrink: 0;
}

.sync-bar--warn .sync-bar__dot { background: var(--c-gold); }
.sync-bar--error .sync-bar__dot { background: var(--c-danger); }

.sync-bar__text {
    flex: 1;
    font-size: var(--fs-caption);
    color: var(--c-text-2);
}

.sync-bar--error .sync-bar__text { color: var(--c-danger-text); }

.ach__glyph {
    display: inline-block;
    width: 44rpx;
    height: 44rpx;
    line-height: 44rpx;
    text-align: center;
    border-radius: var(--r-xs);
    margin-right: var(--sp-3);
    background: var(--c-neutral-soft);
    color: var(--c-text-3);
    font-size: var(--fs-note);
}

.ach__glyph--on {
    background: var(--c-primary);
    color: var(--c-on-ink);
}

.ach__progress {
    font-size: var(--fs-caption);
    color: var(--c-text-2);
    margin-left: var(--sp-4);
    flex-shrink: 0;
}

/* ---------- 人物页改版：身份卡 + 属性格 + 突破清单，低频区块折叠 ---------- */
.imm-idcard {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    padding: var(--sp-6);
    border: 1rpx solid var(--c-imm-line);
    border-radius: var(--r-lg);
    background-color: var(--c-imm-panel);
    background-image: linear-gradient(to bottom, var(--c-imm-panel-2), transparent 240rpx);
}

.imm-idcard__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.imm-idcard__name {
    color: var(--c-imm-text);
    font-size: var(--fs-lead);
    font-weight: 700;
    letter-spacing: 2rpx;
}

.imm-idcard__line {
    color: var(--c-imm-text-2);
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body);
}

.imm-idcard__edit {
    color: var(--c-imm-gold);
    font-size: var(--fs-note);
    margin-top: var(--sp-2);
}

.imm-check {
    display: flex;
    align-items: center;
    margin-top: var(--sp-4);
}

.imm-check__mark {
    width: var(--sp-6);
    flex: none;
    color: var(--c-imm-text-3);
    font-size: var(--fs-body);
}

/* 勾 / 叉都用细线字符，不用 emoji：墨金底上彩色 emoji 会跳出来抢视线 */
.imm-check__mark--on { color: var(--c-imm-jade); }
.imm-check__mark--off { color: var(--c-imm-danger); }

/* 主修三门只是参考项，用中性点；只有战力那一行才是勾叉 */
.imm-check__mark--ref { color: var(--c-imm-text-3); }

/* 未达标的条件文字压暗一档，让「还差哪几项」一眼分得出来 */
.imm-check--off .imm-check__text { color: var(--c-imm-text-2); }

.imm-check__text {
    color: var(--c-imm-text);
    font-size: var(--fs-body-sm);
}

.fold-row {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    padding: var(--sp-4) 0;
    border-bottom: 1rpx solid var(--c-imm-line-soft);
}

.fold-row__name {
    display: block;
    color: var(--c-imm-text);
    font-size: var(--fs-body-sm);
}

.fold-row__desc {
    display: block;
    color: var(--c-imm-text-2);
    font-size: var(--fs-note);
    line-height: var(--lh-body);
    margin-top: var(--sp-1);
}

.world-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--sp-4);
}

.world-row__name {
    color: var(--c-imm-text);
    font-size: var(--fs-body-sm);
}

.world-row__state {
    color: var(--c-imm-gold);
    font-size: var(--fs-note);
}

.pg--imm .sync-bar {
    background: var(--c-imm-panel-2);
    border: 1rpx solid var(--c-imm-gold-dim);
    color: var(--c-imm-text);
}

.pg--imm .role-editor__input {
    background: var(--c-imm-panel-2);
    color: var(--c-imm-text);
}
