.idcard {
    box-sizing: border-box;
    padding: 16rpx;
    margin-bottom: 22rpx;
    border-radius: 28rpx;
    background: #f2eee4;
    border: 2rpx solid #e3ddcd;
}

.idcard__inner {
    box-sizing: border-box;
    min-height: 780rpx;
    padding: 44rpx 36rpx;
    border: 3rpx solid #b8893b;
    border-radius: 20rpx;
    background: #2f4a41;
    display: flex;
    flex-direction: column;
}

.idcard__eyebrow {
    color: #d8b775;
    font-size: 22rpx;
    letter-spacing: 4rpx;
}

.idcard__name {
    font-size: 48rpx;
    font-weight: 700;
    color: #fffdf7;
    margin-right: 16rpx;
}

.idcard__title {
    margin-top: 8rpx;
    color: #c9d6cd;
    font-size: 24rpx;
}

.idcard__label {
    margin-top: 36rpx;
    color: #d8b775;
    font-size: 21rpx;
    letter-spacing: 4rpx;
}

.idcard__power {
    color: #fffdf7;
    font-family: "Songti SC", "SimSun", serif;
    font-size: 104rpx;
    font-weight: 700;
    line-height: 1.1;
}

.idcard__rule {
    height: 2rpx;
    background: rgba(255, 253, 247, 0.2);
    margin: 20rpx 0;
}

.idcard__attrs {
    color: #c9d6cd;
    font-size: 24rpx;
}

.idcard__skill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12rpx 0;
    border-bottom: 2rpx solid rgba(255, 253, 247, 0.1);
}

.idcard__skill-name {
    color: #fffdf7;
    font-size: 27rpx;
    font-weight: 600;
}

.idcard__skill-tier {
    font-size: 23rpx;
}

.idcard__empty {
    color: #9fb3a7;
    font-size: 24rpx;
    padding: 16rpx 0;
}

.idcard__stats {
    color: #c9d6cd;
    font-size: 23rpx;
}

.idcard__code {
    margin-top: 12rpx;
    color: #9fb3a7;
    font-size: 20rpx;
    word-break: break-all;
}

.idcard__slogan {
    margin-top: auto;
    padding-top: 28rpx;
    color: #9fb3a7;
    font-size: 21rpx;
    letter-spacing: 2rpx;
}

.share-canvas {
    position: fixed;
    top: -3000px;
    left: 0;
    width: 600px;
    height: 880px;
}

.title-card,
.world-card {
    margin-bottom: 14rpx;
}

.idcard__hero {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.idcard__hero-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
}

.idcard__edit {
    display: inline-flex;
    align-items: center;
    min-height: 64rpx;
    padding: 0 8rpx;
    margin-top: 10rpx;
    color: #d8b775;
    font-size: 23rpx;
}

.role-editor__preview {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-top: 24rpx;
}

.role-editor__name {
    margin-left: 24rpx;
    font-size: 32rpx;
    color: #2f4a41;
    font-weight: 500;
}

.role-editor__input {
    box-sizing: border-box;
    width: 100%;
    height: 78rpx;
    padding: 0 20rpx;
    background: #f7f3e8;
    border: 2rpx solid #ddd5c2;
    border-radius: 12rpx;
    font-size: 28rpx;
    color: #2f4a41;
}

.idcard__avatar {
    width: 192rpx;
    height: 218rpx;
    border-radius: 20rpx;
    border: 3rpx solid #d8b775;
    background: #24453c;
    flex-shrink: 0;
}

.role-editor__avatar {
    width: 108rpx;
    height: 122rpx;
    border-radius: 14rpx;
    border: 2rpx solid #b8893b;
    background: #f2eee4;
    flex-shrink: 0;
}

.sync-bar {
    display: flex;
    flex-direction: row;
    align-items: center;
    box-sizing: border-box;
    padding: 16rpx 22rpx;
    margin-bottom: 18rpx;
    border-radius: 14rpx;
    border: 2rpx solid #e3ddcd;
    background: #fffdf7;
}

.sync-bar__dot {
    width: 14rpx;
    height: 14rpx;
    border-radius: 50%;
    margin-right: 14rpx;
    background: #3d8c74;
    flex-shrink: 0;
}

.sync-bar--warn .sync-bar__dot { background: #b8893b; }
.sync-bar--error .sync-bar__dot { background: #b4453c; }

.sync-bar__text {
    flex: 1;
    font-size: 23rpx;
    color: #5d6358;
}

.sync-bar--error .sync-bar__text { color: #b4453c; }

.sync-bar__action {
    font-size: 22rpx;
    color: #2f6b5b;
    margin-left: 12rpx;
}

.ach__glyph {
    display: inline-block;
    width: 44rpx;
    height: 44rpx;
    line-height: 44rpx;
    text-align: center;
    border-radius: 10rpx;
    margin-right: 14rpx;
    background: #ece9df;
    color: #9a9a8b;
    font-size: 24rpx;
}

.ach__glyph--on {
    background: #2f6b5b;
    color: #f2eee4;
}

.ach__progress {
    font-size: 23rpx;
    color: #8a8f83;
    margin-left: 16rpx;
    flex-shrink: 0;
}
