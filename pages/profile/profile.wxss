/* 道牒页：道牒卡是一张「名片」，明暗都保持深绿金边（--c-idcard / --c-idcard-edge），
   其余面板与列表一律走语义变量，暗色下不再出现浅底浅字。 */
.idcard {
    box-sizing: border-box;
    padding: var(--sp-4);
    margin-bottom: var(--card-gap);
    border-radius: var(--r-xl);
    background: var(--c-bg);
    border: 2rpx solid var(--c-border);
}

.idcard__inner {
    box-sizing: border-box;
    min-height: 780rpx;
    padding: var(--sp-12) var(--sp-8);
    border: 3rpx solid var(--c-idcard-edge);
    border-radius: var(--r-md);
    background: var(--c-idcard);
    display: flex;
    flex-direction: column;
}

.idcard__eyebrow {
    color: var(--c-gold-bright);
    font-size: var(--fs-caption);
    letter-spacing: var(--sp-1);
}

.idcard__name {
    font-size: var(--fs-h1);
    font-weight: 700;
    color: var(--c-on-ink);
    margin-right: var(--sp-4);
}

.idcard__title {
    margin-top: var(--sp-2);
    color: var(--c-on-ink-2);
    font-size: var(--fs-note);
}

.idcard__label {
    margin-top: var(--sp-8);
    color: var(--c-gold-bright);
    font-size: var(--fs-caption);
    letter-spacing: var(--sp-1);
}

.idcard__power {
    color: var(--c-on-ink);
    font-family: "Songti SC", "SimSun", serif;
    font-size: 104rpx;
    font-weight: 700;
    line-height: 1.1;
}

.idcard__rule {
    height: 2rpx;
    background: var(--c-ink-divider);
    margin: var(--sp-5) 0;
}

.idcard__attrs {
    color: var(--c-on-ink-2);
    font-size: var(--fs-note);
}

.idcard__skill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--sp-3) 0;
    border-bottom: 2rpx solid var(--c-ink-divider);
}

.idcard__skill-name {
    color: var(--c-on-ink);
    font-size: var(--fs-body-sm);
    font-weight: 600;
}

.idcard__skill-tier { font-size: var(--fs-caption); }

.idcard__empty {
    color: var(--c-on-ink-2);
    font-size: var(--fs-note);
    padding: var(--sp-4) 0;
}

.idcard__stats {
    color: var(--c-on-ink-2);
    font-size: var(--fs-caption);
}

.idcard__code {
    margin-top: var(--sp-3);
    color: var(--c-on-ink-2);
    font-size: var(--fs-caption);
    word-break: break-all;
}

.idcard__slogan {
    margin-top: auto;
    padding-top: var(--sp-8);
    color: var(--c-on-ink-2);
    font-size: var(--fs-caption);
    letter-spacing: var(--sp-1);
}

.share-canvas {
    position: fixed;
    top: -3000px;
    left: 0;
    width: 600px;
    height: 880px;
}

.title-card,
.world-card { margin-bottom: var(--sp-4); }

.idcard__hero {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.idcard__hero-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
}

.idcard__edit {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-xs);
    padding: 0 var(--sp-2);
    margin-top: var(--sp-2);
    color: var(--c-gold-bright);
    font-size: var(--fs-caption);
}

.role-editor__preview {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-top: var(--sp-6);
}

.role-editor__name {
    margin-left: var(--sp-6);
    font-size: var(--fs-h3);
    color: var(--c-text);
    font-weight: 500;
}

.role-editor__input {
    box-sizing: border-box;
    width: 100%;
    height: var(--touch-sm);
    padding: 0 var(--sp-5);
    background: var(--c-surface-2);
    border: 2rpx solid var(--c-border-strong);
    border-radius: var(--r-sm);
    font-size: var(--fs-body);
    color: var(--c-text);
}

.idcard__avatar {
    width: 192rpx;
    height: 218rpx;
    border-radius: var(--r-md);
    border: 3rpx solid var(--c-gold-bright);
    background: var(--c-surface-ink);
    flex-shrink: 0;
}

.role-editor__avatar {
    width: 108rpx;
    height: 122rpx;
    border-radius: var(--r-md);
    border: 2rpx solid var(--c-gold);
    background: var(--c-bg);
    flex-shrink: 0;
}

.sync-bar {
    display: flex;
    flex-direction: row;
    align-items: center;
    box-sizing: border-box;
    padding: var(--sp-4) var(--sp-6);
    margin-bottom: var(--sp-4);
    border-radius: var(--r-md);
    border: 2rpx solid var(--c-border);
    background: var(--c-surface);
}

.sync-bar__dot {
    width: var(--sp-3);
    height: var(--sp-3);
    border-radius: 50%;
    margin-right: var(--sp-3);
    background: var(--c-success);
    flex-shrink: 0;
}

.sync-bar--warn .sync-bar__dot { background: var(--c-gold); }
.sync-bar--error .sync-bar__dot { background: var(--c-danger); }

.sync-bar__text {
    flex: 1;
    font-size: var(--fs-caption);
    color: var(--c-text-2);
}

.sync-bar--error .sync-bar__text { color: var(--c-danger-text); }

.sync-bar__action {
    font-size: var(--fs-caption);
    color: var(--c-link);
    margin-left: var(--sp-3);
}

.ach__glyph {
    display: inline-block;
    width: 44rpx;
    height: 44rpx;
    line-height: 44rpx;
    text-align: center;
    border-radius: var(--r-xs);
    margin-right: var(--sp-3);
    background: var(--c-neutral-soft);
    color: var(--c-text-3);
    font-size: var(--fs-note);
}

.ach__glyph--on {
    background: var(--c-primary);
    color: var(--c-on-ink);
}

.ach__progress {
    font-size: var(--fs-caption);
    color: var(--c-text-2);
    margin-left: var(--sp-4);
    flex-shrink: 0;
}

/* 音效开关：文字竖排，按钮靠右，和「账号·存档」区的双按钮区分开 */
.sfx-text {
    display: flex;
    flex-direction: column;
}

/* ---------- 人物页改版：身份卡 + 属性格 + 突破清单，低频区块折叠 ---------- */
.imm-idcard {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    padding: var(--sp-6);
    border: 1rpx solid var(--c-imm-line);
    border-radius: var(--r-lg);
    background-color: var(--c-imm-panel);
    background-image: linear-gradient(to bottom, var(--c-imm-panel-2), transparent 240rpx);
}

.imm-idcard__avatar {
    width: 132rpx;
    height: 132rpx;
    flex: none;
    border-radius: var(--r-pill);
    border: 1rpx solid var(--c-imm-line);
}

.imm-idcard__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.imm-idcard__name {
    color: var(--c-imm-text);
    font-size: var(--fs-lead);
    font-weight: 700;
    letter-spacing: 2rpx;
}

.imm-idcard__line {
    color: var(--c-imm-text-2);
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body);
}

.imm-idcard__edit {
    color: var(--c-imm-gold);
    font-size: var(--fs-note);
    margin-top: var(--sp-2);
}

.imm-check {
    display: flex;
    align-items: center;
    margin-top: var(--sp-4);
}

.imm-check__mark {
    width: var(--sp-6);
    flex: none;
    color: var(--c-imm-text-3);
    font-size: var(--fs-body);
}

.imm-check__mark--on { color: var(--c-imm-jade); }

.imm-check__text {
    color: var(--c-imm-text);
    font-size: var(--fs-body-sm);
}

.fold-row {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    padding: var(--sp-4) 0;
    border-bottom: 1rpx solid var(--c-imm-line-soft);
}

.fold-row__name {
    display: block;
    color: var(--c-imm-text);
    font-size: var(--fs-body-sm);
}

.fold-row__desc {
    display: block;
    color: var(--c-imm-text-2);
    font-size: var(--fs-note);
    line-height: var(--lh-body);
    margin-top: var(--sp-1);
}

.world-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--sp-4);
}

.world-row__name {
    color: var(--c-imm-text);
    font-size: var(--fs-body-sm);
}

.world-row__state {
    color: var(--c-imm-gold);
    font-size: var(--fs-note);
}

.pg--imm .sync-bar {
    background: var(--c-imm-panel-2);
    border: 1rpx solid var(--c-imm-gold-dim);
    color: var(--c-imm-text);
}

.pg--imm .role-editor__input {
    background: var(--c-imm-panel-2);
    color: var(--c-imm-text);
}
