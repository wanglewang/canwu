<view class="pg pg--imm">
  <view class="imm-head">
    <text class="imm-head__action pressable" hover-class="pressable--on" bindtap="onGoHelp">说明</text>
  </view>

  <view wx:if="{{!ov}}" class="state">
    <text class="state__glyph">◇</text>
    <text class="state__desc">{{copy.loading}}</text>
  </view>

  <block wx:else>
    <view class="imm-panel">
      <text class="imm-panel__label">身家</text>
      <view class="imm-stats">
        <view class="imm-stat">
          <text class="imm-stat__label">灵 气</text>
          <text class="imm-stat__value">{{qi}}</text>
        </view>
        <view class="imm-stat">
          <text class="imm-stat__label">灵 石</text>
          <text class="imm-stat__value">{{stone}}</text>
        </view>
        <view class="imm-stat">
          <text class="imm-stat__label">已 藏</text>
          <text class="imm-stat__value">{{learnedCount}} / {{totalCount}}</text>
        </view>
      </view>
    </view>

    <view class="imm-sec-title">可 换 功 法</view>

    <view class="imm-list">
      <view class="imm-row" wx:for="{{items}}" wx:key="id">
        <view class="imm-row__body">
          <text class="imm-row__name">{{item.name}}</text>
          <text class="imm-row__sub">{{item.tierLabel}} · {{item.sub}}</text>
          <text class="imm-row__sub">{{item.costText}}</text>
        </view>
        <button wx:if="{{item.buttonKind === 'buy'}}" class="imm-btn imm-btn--sm" data-id="{{item.id}}" bindtap="onBuy">兑换</button>
        <text wx:else class="imm-chip {{item.unlocked ? 'imm-chip--jade' : ''}}">{{item.actionText}}</text>
      </view>
    </view>
  </block>
</view>
