/* 修行指南：长文本列表，行高与分隔符都用全局令牌，暗色下不再出现浅色横线。 */
.guide-line {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    padding: var(--sp-2) 0;
    border-bottom: 2rpx solid var(--c-divider);
}

.guide-line:last-child { border-bottom: none; }

.guide-dot {
    width: var(--fs-body-sm);
    flex: none;
    color: var(--c-gold-text);
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body);
}

.guide-line .body {
    font-size: var(--fs-body-sm);
    line-height: var(--lh-loose);
}
