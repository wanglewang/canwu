.guide-line {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    padding: 10rpx 0;
    border-bottom: 2rpx solid #f4efe3;
}

.guide-line:last-child {
    border-bottom: none;
}

.guide-dot {
    width: 26rpx;
    flex: none;
    color: #b8893b;
    font-size: 26rpx;
    line-height: 1.6;
}

.guide-line .body {
    font-size: 25rpx;
    line-height: 1.7;
}
