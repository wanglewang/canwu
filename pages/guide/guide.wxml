<view class="pg pg--imm">
  <view class="imm-head">
    <text class="imm-head__action pressable" hover-class="pressable--on" bindtap="onGoHelp">说明</text>
  </view>

  <view class="card guide-toc">
    <view class="row--between">
      <text class="eyebrow">{{copy.sections.guideToc}}</text>
      <text class="text-link text-link--muted" bindtap="onToggleAll">{{showAll ? copy.actions.oneSection : copy.actions.expandAll}}</text>
    </view>
    <view class="row--wrap mt12">
      <text wx:for="{{sections}}" wx:key="title" class="toc-chip {{item.open ? 'toc-chip--on' : ''}}" data-index="{{index}}" bindtap="onJump">{{item.short}}</text>
    </view>
  </view>

  <view class="section" wx:for="{{sections}}" wx:key="title" id="{{item.id}}">
    <view class="section__head pressable" hover-class="pressable--on" data-index="{{index}}" bindtap="onToggleSection">
      <text class="section__title">{{item.title}}</text>
      <text class="section__sub">{{item.open || showAll ? copy.actions.collapse : copy.actions.expand}}</text>
    </view>
    <text class="tiny mt8">{{item.sub}}</text>
    <view class="card mt12" wx:if="{{item.open || showAll}}">
      <view class="guide-line" wx:for="{{item.lines}}" wx:for-item="line" wx:key="*this">
        <text class="guide-dot">·</text>
        <text class="body grow">{{line}}</text>
      </view>
    </view>
  </view>

  <view class="pg__foot">{{copy.footGuide}}</view>
</view>
