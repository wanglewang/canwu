<view class="pg pg--imm">
  <view class="imm-head">
    <text class="imm-head__back pressable" hover-class="pressable--on" bindtap="onBack">‹</text>
    <text class="imm-head__title serif">论 道</text>
    <text class="imm-head__action pressable" hover-class="pressable--on" bindtap="onGoHelp">说明</text>
  </view>

  <view wx:if="{{ov}}" class="card card--ink">
    <view class="row--between">
      <text class="tiny pr-tiny">{{ov.realmName}} · {{ov.roleName}}</text>
      <text class="tag tag--dark">{{ov.equippedTitleName}}</text>
    </view>
    <view class="row--between mt16">
      <text class="tiny pr-tiny">战 力</text>
      <text class="big-number hero-num">{{ov.power}}</text>
    </view>
  </view>
  <view wx:else class="state">
    <text class="state__glyph">◇</text>
    <text class="state__desc">{{copy.loading}}</text>
  </view>

  <view class="section">
    <view class="section__head">
      <text class="section__title">同门与来客</text>
    </view>
    <view class="card card--tight fight-card" wx:for="{{npcs}}" wx:key="id">
      <view class="row--between">
        <text class="h3">{{item.name}}</text>
        <text class="tag {{item.cleared ? 'tag--jade' : 'tag--grey'}}">{{item.cleared ? '已首胜' : item.title}}</text>
      </view>
      <text class="tiny mt8">{{item.desc}}</text>
      <view class="row--between mt12">
        <text class="tiny">战力 {{item.power}} · <text class="{{item.hintTone === 'good' ? 'jade' : 'gold'}}">{{item.hint}}</text></text>
        <button class="btn {{item.cleared ? 'btn--plain' : 'btn--primary'}} btn--compact" data-id="{{item.id}}" bindtap="onFight">{{item.cleared ? '再打一场' : '挑战'}}</button>
      </view>
      <view class="row--between mt8">
        <text class="tiny">灵气 +{{item.qi}} / 灵石 +{{item.stone}}</text>
        <text wx:if="{{item.dropName}}" class="tiny gold">首胜掉落《{{item.dropName}}》</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section__head">
      <view class="row"><text class="section__title">秘境探索</text><term term-key="mijing" /></view>
    </view>
    <view class="card card--tight fight-card" wx:for="{{secrets}}" wx:key="id">
      <view class="row--between">
        <text class="h3">{{item.name}}</text>
        <text class="tag {{item.hintTone === 'good' ? 'tag--jade' : 'tag--grey'}}">{{item.hint}}</text>
      </view>
      <text class="tiny mt8">{{item.desc}}</text>
      <view class="row--between mt12">
        <text class="tiny">战力 {{item.power}} · 灵气 +{{item.qi}} / 灵石 +{{item.stone}}</text>
        <button class="btn btn--ghost btn--compact" data-id="{{item.id}}" bindtap="onFight">入秘境</button>
      </view>
    </view>
  </view>

  <view class="section" id="board">
    <view class="section__head">
      <text class="section__title">论道榜单 · 真实道友</text>
      <text class="section__sub">{{board.length}} 位在榜</text>
    </view>
    <view class="state state--inline" wx:if="{{boardError}}">
      <text class="state__desc">{{boardError}}</text>
      <button class="btn btn--plain btn--small state__action" bindtap="onRefreshBoard">{{copy.actions.refresh}}</button>
    </view>
    <block wx:else>
      <view class="card card--tight board-row" wx:for="{{board}}" wx:key="uid">
        <view class="row--between">
          <view class="row">
            <text class="board-rank">{{item.rank}}</text>
            <text class="h3">{{item.name}}</text>
            <text wx:if="{{item.isMe}}" class="tag tag--jade">我</text>
          </view>
          <text class="board-power">{{item.power}}</text>
        </view>
        <text class="tiny mt8">{{item.realmName}} · 道相 {{item.portrait}}</text>
      </view>
      <view wx:if="{{board.length === 0}}" class="card card--tight">
        <text class="tiny">{{copy.emptyBoard}}</text>
      </view>
      <view class="card" wx:if="{{rival}}">
        <text class="h3">与你最接近的道友</text>
        <text class="tiny mt8">{{rival.name}} · {{rival.realmName}} · 战力 {{rival.power}}</text>
        <button class="btn btn--primary btn--small btn--block mt12" bindtap="onFightRival">与之论道</button>
      </view>
      <view class="btn-row btn-row--tight">
        <button class="btn btn--plain" bindtap="onRefreshBoard">{{boardLoading ? '正在刷新…' : '刷新榜单'}}</button>
        <button class="btn btn--ghost" open-type="share">邀道友上榜</button>
      </view>
    </block>
  </view>

  <view class="section">
    <view class="section__head">
      <view class="row"><text class="section__title">{{copy.sections.battleCode}}</text><term term-key="code" /></view>
      <text class="section__sub text-link" bindtap="onToggleCode">{{codeOpen ? copy.actions.collapse : copy.actions.expand}}</text>
    </view>
    <block wx:if="{{codeOpen}}">
      <view class="card">
        <text class="h3">我的战力码</text>
        <view class="code-box mt12">{{myCode}}</view>
        <button class="btn btn--primary btn--small btn--block mt12" bindtap="onCopyCode">复制我的战力码</button>
        <view class="divider"></view>
        <view class="row"><text class="h3">挑战朋友的镜像</text><term term-key="mirror" /></view>
        <input class="code-input mt12" value="{{inputCode}}" bindinput="onInputCode" placeholder="粘贴 CW1- 开头的战力码" placeholder-class="code-ph" />
        <view class="btn-row">
          <button class="btn btn--plain btn--small" bindtap="onPasteCode">从剪贴板读取</button>
          <button class="btn btn--gold btn--small" bindtap="onMirrorFight">打镜像</button>
        </view>
      </view>
    </block>
  </view>

  <view class="mask" wx:if="{{showResult && result}}" bindtap="closeResult">
    <view class="modal" catchtap="noop">
      <text class="modal__title serif">{{result.headline}}</text>
      <text class="modal__sub">{{result.subline}}</text>

      <view class="battle-score mt24">
        <view class="battle-score__side">
          <text class="tiny">我方挥出</text>
          <text class="battle-num {{result.winTone}}">{{result.playerRoll}}</text>
        </view>
        <text class="battle-vs">对</text>
        <view class="battle-score__side">
          <text class="tiny">对方接下</text>
          <text class="battle-num">{{result.enemyRoll}}</text>
        </view>
      </view>
      <text class="quote mt16">{{result.line}}</text>

      <view class="modal__body" wx:if="{{result.effects.length > 0}}">
        <text class="tag tag--gold">触发特效</text>
        <view class="res-note mt8" wx:for="{{result.effects}}" wx:key="name">
          <text class="tiny">· {{item.name}}：{{item.text}}</text>
        </view>
      </view>

      <view class="modal__body">
        <view class="res-line" wx:for="{{result.lines}}" wx:key="k">
          <text class="muted">{{item.k}}</text>
          <text class="h3 jade">{{item.v}}</text>
        </view>
      </view>

      <view class="modal__body" wx:if="{{result.titles.length > 0}}">
        <text class="tag tag--gold">新称号</text>
        <view class="row--wrap mt8">
          <text class="tag tag--jade" wx:for="{{result.titles}}" wx:key="*this">{{item}}</text>
        </view>
      </view>

      <view class="modal__actions">
        <button class="btn btn--primary btn--block" bindtap="closeResult">{{copy.actions.confirm}}</button>
      </view>
    </view>
  </view>

</view>
