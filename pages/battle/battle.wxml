<view class="pg pg--imm">
  <view class="imm-head">
    <text class="imm-head__action pressable" hover-class="pressable--on" bindtap="onGoHelp">说明</text>
  </view>

  <view wx:if="{{ov}}" class="imm-panel">
    <view class="imm-panel__head">
      <text class="imm-panel__label">我的战力</text>
      <text class="imm-chip">{{ov.equippedTitleName}}</text>
    </view>
    <text class="imm-realm">{{ov.power}}</text>
    <view class="imm-strip">
      <text>{{ov.realmName}} · {{ov.roleName}}</text>
      <text class="text-link" bindtap="onGoBoard">战力仙榜 ›</text>
    </view>
  </view>
  <view wx:else class="state">
    <text class="state__glyph">◇</text>
    <text class="state__desc">{{copy.loading}}</text>
  </view>

  <view class="imm-sec-title">同门与来客</view>
  <view class="imm-list">
    <view class="imm-row" wx:for="{{npcs}}" wx:key="id">
      <view class="imm-row__body">
        <view class="riv-head">
          <text class="imm-row__name">{{item.name}}</text>
          <text class="imm-chip {{item.cleared ? 'imm-chip--jade' : ''}}">{{item.cleared ? '已首胜' : item.title}}</text>
        </view>
        <text class="imm-row__sub riv-desc">{{item.desc}}</text>
        <view class="riv-meta">
          <text>战力 {{item.power}}</text>
          <text class="riv-tone--{{item.hintTone}}">{{item.hint}}</text>
        </view>
        <text wx:if="{{item.dropName && !item.cleared}}" class="riv-drop">首胜掉落《{{item.dropName}}》</text>
        <text wx:elif="{{item.dropName}}" class="riv-note">首胜功法已得，再战只给灵气与灵石</text>
        <text wx:else class="riv-note">灵气 +{{item.qi}} · 灵石 +{{item.stone}}</text>
      </view>
      <button class="imm-btn imm-btn--sm {{item.cleared ? 'imm-btn--ghost' : ''}}" data-id="{{item.id}}" bindtap="onFight">{{item.cleared ? '再战' : '挑战'}}</button>
    </view>
  </view>

  <view class="imm-sec-title">秘境探索</view>
  <view class="imm-list">
    <view class="imm-row" wx:for="{{secrets}}" wx:key="id">
      <view class="imm-row__body">
        <view class="riv-head">
          <text class="imm-row__name">{{item.name}}</text>
          <text class="imm-chip {{item.cleared ? 'imm-chip--jade' : ''}}">{{item.cleared ? '已走过' : item.title}}</text>
        </view>
        <text class="imm-row__sub riv-desc">{{item.desc}}</text>
        <view class="riv-meta">
          <text>战力 {{item.power}}</text>
          <text class="riv-tone--{{item.hintTone}}">{{item.hint}}</text>
        </view>
        <text class="riv-note">只产灵气与灵石 · 灵气 +{{item.qi}} / 灵石 +{{item.stone}}</text>
      </view>
      <button class="imm-btn imm-btn--sm imm-btn--ghost" data-id="{{item.id}}" bindtap="onFight">入秘境</button>
    </view>
  </view>

  <view class="imm-sec-title">约战</view>
  <view class="imm-list">
    <view class="imm-row pressable" hover-class="pressable--on" bindtap="onToggleCode">
      <view class="imm-row__body">
        <text class="imm-row__name">{{copy.sections.battleCode}}</text>
        <text class="imm-row__sub">不用同时在线：给对方一个码，打的是他的镜像</text>
      </view>
      <text class="imm-row__value">{{codeOpen ? '收起' : '展开'}}</text>
    </view>
  </view>

  <view wx:if="{{codeOpen}}" class="imm-panel">
    <text class="imm-panel__label">我的战力码</text>
    <view class="code-box mt12">{{myCode}}</view>
    <button class="imm-btn imm-btn--block mt12" bindtap="onCopyCode">复制我的战力码</button>
    <view class="imm-strip mt16">
      <text>打朋友的镜像</text>
      <text class="imm-strip__value">粘贴对方发来的码</text>
    </view>
    <input class="code-input mt12" value="{{inputCode}}" bindinput="onInputCode" placeholder="CW1- 开头的战力码" placeholder-class="code-ph" />
    <view class="imm-btn-row">
      <button class="imm-btn imm-btn--ghost imm-btn--sm" bindtap="onPasteCode">读剪贴板</button>
      <button class="imm-btn imm-btn--sm" bindtap="onMirrorFight">打镜像</button>
    </view>
  </view>

  <view class="mask" wx:if="{{showResult && result}}" bindtap="closeResult">
    <view class="modal" catchtap="noop">
      <text class="modal__title">{{result.headline}}</text>
      <text class="modal__sub">{{result.subline}}</text>

      <view class="battle-score mt24">
        <view class="battle-score__side">
          <text class="tiny">我方挥出</text>
          <text class="battle-num {{result.winTone}}">{{result.playerRoll}}</text>
        </view>
        <text class="battle-vs">对</text>
        <view class="battle-score__side">
          <text class="tiny">对方接下</text>
          <text class="battle-num">{{result.enemyRoll}}</text>
        </view>
      </view>
      <text class="quote mt16">{{result.line}}</text>

      <view class="modal__body" wx:if="{{result.effects.length > 0}}">
        <text class="tag tag--gold">触发特效</text>
        <view class="res-note mt8" wx:for="{{result.effects}}" wx:key="name">
          <text class="tiny">· {{item.name}}：{{item.text}}</text>
        </view>
      </view>

      <view class="modal__body">
        <view class="res-line" wx:for="{{result.lines}}" wx:key="k">
          <text class="muted">{{item.k}}</text>
          <text class="h3 jade">{{item.v}}</text>
        </view>
      </view>

      <view class="modal__body" wx:if="{{result.titles.length > 0}}">
        <text class="tag tag--gold">新称号</text>
        <view class="row--wrap mt8">
          <text class="tag tag--jade" wx:for="{{result.titles}}" wx:key="*this">{{item}}</text>
        </view>
      </view>

      <view class="modal__actions">
        <button class="imm-btn imm-btn--block" bindtap="closeResult">{{copy.actions.confirm}}</button>
      </view>
    </view>
  </view>

  <view class="pg__foot">
    <text class="text-link text-link--muted" bindtap="onGoGuide">看对手与奖励的完整规则 ›</text>
  </view>
</view>
