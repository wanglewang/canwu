<view class="pg pg--imm">
  <view wx:if="{{ov}}" class="imm-panel">
    <view class="imm-panel__head">
      <text class="imm-panel__label">{{copy.sections.myPower}}</text>
      <text class="imm-chip">{{ov.equippedTitleName}}</text>
    </view>
    <text class="imm-realm">{{ov.power}}</text>
    <view class="imm-strip">
      <text>{{ov.realmName}} · {{ov.roleName}}</text>
      <text class="text-link" bindtap="onGoBoard">战力仙榜 ›</text>
    </view>
  </view>
  <view wx:else class="state">
    <text class="state__glyph">◇</text>
    <text class="state__desc">{{copy.loading}}</text>
  </view>

  <view class="imm-sec-title">{{copy.sections.rivals}}</view>
  <view class="imm-list">
    <view class="imm-row" wx:for="{{npcs}}" wx:key="id">
      <view class="imm-row__body">
        <view class="riv-head">
          <text class="imm-row__name">{{item.name}}</text>
          <text class="imm-chip {{item.cleared ? 'imm-chip--jade' : ''}}">{{item.cleared ? '已首胜' : item.title}}</text>
        </view>
        <text class="imm-row__sub riv-desc">{{item.desc}}</text>
        <view class="riv-meta">
          <text>战力 {{item.power}}</text>
          <text class="riv-tone--{{item.hintTone}}">{{item.hint}}</text>
        </view>
        <text wx:if="{{item.dropName && !item.cleared}}" class="riv-drop">首胜掉落《{{item.dropName}}》</text>
        <text wx:elif="{{item.dropName}}" class="riv-note">首胜功法已得，再战只给灵气与灵石</text>
        <text wx:else class="riv-note">灵气 +{{item.qi}} · 灵石 +{{item.stone}}</text>
      </view>
      <button class="imm-btn imm-btn--sm {{item.cleared ? 'imm-btn--ghost' : ''}}" data-id="{{item.id}}" bindtap="onFight">{{item.cleared ? copy.actions.rechallenge : copy.actions.challenge}}</button>
    </view>
  </view>

  <view class="imm-sec-title">{{copy.sections.duel}}</view>
  <view class="imm-list">
    <view class="imm-row pressable" hover-class="pressable--on" bindtap="onToggleCode">
      <view class="imm-row__body">
        <text class="imm-row__name">{{copy.sections.battleCode}}</text>
        <text class="imm-row__sub">不用同时在线：给对方一个码，打的是他的镜像</text>
      </view>
      <text class="imm-row__value">{{codeOpen ? '收起' : '展开'}}</text>
    </view>
  </view>

  <view wx:if="{{codeOpen}}" class="imm-panel">
    <text class="imm-panel__label">我的战力码</text>
    <view class="code-box mt12">{{myCode}}</view>
    <button class="imm-btn imm-btn--block mt12" bindtap="onCopyCode">复制我的战力码</button>
    <view class="imm-strip mt16">
      <text>打朋友的镜像</text>
      <text class="imm-strip__value">粘贴对方发来的码</text>
    </view>
    <input class="code-input mt12" value="{{inputCode}}" bindinput="onInputCode" placeholder="CW1- 开头的战力码" placeholder-class="code-ph" />
    <view class="imm-btn-row">
      <button class="imm-btn imm-btn--ghost imm-btn--sm" bindtap="onPasteCode">读剪贴板</button>
      <button class="imm-btn imm-btn--sm" bindtap="onMirrorFight">打镜像</button>
    </view>
  </view>

  <duel-result show="{{showResult}}" result="{{result}}" bind:close="closeResult" />

  <!-- 两条都是"看规则"：合成一行，别在页尾排两段同类链接。 -->
  <view class="pg__foot">
    <text class="text-link text-link--muted pressable" hover-class="pressable--on" bindtap="onGoHelp">本页说明</text>
    <text class="pg__foot__sep">·</text>
    <text class="text-link text-link--muted pressable" hover-class="pressable--on" bindtap="onGoGuide">完整规则 ›</text>
  </view>
</view>
