/* 论道页私有样式。code-box / code-input / code-ph 用全局基础层，不在这里重复定义。 */
.hero-num { color: var(--c-on-ink); }

.fight-card { margin-bottom: var(--sp-4); }

.fight-card .btn {
    flex-shrink: 0;
    margin-left: var(--sp-3);
}

.battle-score {
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: var(--sp-6) 0;
    border-radius: var(--r-md);
    background: var(--c-surface-2);
}

.battle-score__side {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.battle-num {
    margin-top: var(--sp-2);
    font-size: var(--fs-h1);
    font-weight: 700;
    line-height: 1;
    color: var(--c-text);
    animation: riseIn 420ms ease-out both;
}

.battle-vs {
    color: var(--c-text-3);
    font-size: var(--fs-note);
}

@keyframes riseIn {
    from { opacity: 0; transform: translateY(var(--sp-4)); }
    to { opacity: 1; transform: translateY(0); }
}

.board-row { padding: var(--sp-4) var(--sp-6); }

.board-rank {
    display: inline-block;
    min-width: 46rpx;
    margin-right: var(--sp-3);
    font-size: var(--fs-body-sm);
    color: var(--c-gold-text);
    font-weight: 500;
}

.board-power {
    font-size: var(--fs-subhead);
    color: var(--c-primary-text);
    font-weight: 500;
}
