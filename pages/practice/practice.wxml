<view class="pg pg--imm {{barMode ? 'pg--with-bar' : ''}} {{sceneOn && started && !showResult ? 'pg--scene' : ''}}" style="--acc:{{theme.accent}};--soft:{{theme.soft}};--ink:{{theme.ink}};--bg:{{theme.bg}};--frame:{{theme.frame}};--glow:{{stage.glow}};--deep:{{stage.deep}};--well:{{stage.well}}">

  <!-- 沉浸舞台三层：远层静态 / 中层循环 / 近层判定信息。只在样板玩法开局后出现。 -->
  <view wx:if="{{sceneOn && started && !showResult}}" class="scene">
    <view class="scene__sky"></view>
    <view class="scene__moon">
      <view class="scene__moon-halo"></view>
      <view class="scene__moon-ring"></view>
      <view class="scene__moon-core"></view>
    </view>
    <view class="scene__star scene__star--1"></view>
    <view class="scene__star scene__star--2"></view>
    <view class="scene__star scene__star--3"></view>
    <view class="scene__star scene__star--4"></view>
    <view class="scene__ridge scene__ridge--far"></view>
    <view class="scene__ridge scene__ridge--mid"></view>
    <view class="scene__ridge scene__ridge--near"></view>
    <view class="scene__ground"></view>
    <view class="scene__gate">
      <view class="scene__gate-beam"></view>
      <view class="scene__gate-post"></view>
      <view class="scene__gate-post"></view>
      <view class="scene__gate-lamp"></view>
      <view class="scene__gate-lamp scene__gate-lamp--r"></view>
    </view>
    <view class="scene__clouds">
      <view class="scene__cloud scene__cloud--1"></view>
      <view class="scene__cloud scene__cloud--2"></view>
      <view class="scene__cloud scene__cloud--3"></view>
    </view>
    <view class="scene__qi">
      <view wx:for="{{qiDots}}" wx:key="id" class="scene__qi-dot" style="left:{{item.x}}%;top:{{item.y}}%;opacity:{{item.o}}"></view>
    </view>
  </view>

  <view wx:if="{{!started || showResult}}" class="card card--ink pr-head">
    <view class="pr-head-row">
      <view class="row">
        <text wx:if="{{rankLabel}}" class="rank-badge rank-badge--sm" style="background:{{rankColor}}">{{rankChar}}</text>
        <text class="tag tag--dark">{{gameName}}</text>
        <!-- 黄阶／天阶这套四阶叫「品阶」，新玩家看到只是两个陌生字，就地给一个解释入口。 -->
        <term wx:if="{{rankLabel}}" term-key="rank" />
      </view>
      <!-- 长解释只有一个入口：这一门的整篇规则、本门机制、品阶与一脉都在说明页。
           准备页只留一行「这一局做什么」，局内只留两行速记——这是「去说明页看」的落点。 -->
      <text class="text-link text-link--muted pressable" hover-class="pressable--on" bindtap="onGoHelp">{{copy.actions.help}} ›</text>
    </view>
    <view class="pr-title-row">
      <text class="h1 pr-title">{{title}}</text>
      <view class="pr-seal">
        <text class="pr-seal__glyph">{{theme.motif}}</text>
      </view>
    </view>
    <text class="quote pr-desc">{{subtitle}}</text>
    <!-- 参悟与「这一门」合并成一屏之后，换门就在这一行：不必先退回功法页再点进来。 -->
    <view wx:if="{{mode === 'practice'}}" class="pr-links">
      <text class="text-link text-link--muted pressable" hover-class="pressable--on" bindtap="onToggleSwap">{{copy.actions.swap}}</text>
    </view>
    <view class="pr-prof">
      <view class="row--between">
        <!-- 段位与品阶倍率并在一行：这两个数决定「这一局值多少」，比星级和一脉实在。 -->
        <text class="tiny pr-tiny">{{tierName}} · {{prof}}<text wx:if="{{rankLabel}}"> · {{rankLabel}} {{rankRewardText}}</text></text>
        <text class="tiny pr-tiny">{{nextText}}</text>
      </view>
      <view class="bar bar--dark mt8">
        <view class="bar__fill" style="width:{{percent}}%;background:{{tierColor}}"></view>
      </view>
      <!-- 连 S 从一整张卡收成一行：圆点留着（不用读字也知道差几局），
           文案直接写「晋哪一段 · 开哪一档」，玩家那句「3 局 S 解锁难度」就是这里来的。 -->
      <view wx:if="{{streakDots.length}}" class="row streak-line mt8">
        <view wx:for="{{streakDots}}" wx:key="id" class="streak-dot {{item.on ? 'streak-dot--on' : ''}}"></view>
        <text class="tiny">{{streakText}}</text>
      </view>
      <!-- 下一段给什么：只写「还差 114」等于只给了个数字，练到头才发现没好处。 -->
      <text wx:if="{{nextBenefit}}" class="tiny pr-tier-next">{{nextBenefit}}</text>
    </view>
    <!-- 留在本页时这一行还在：随时能把刚收起的结算明细叫回来重看，不必再打一局。 -->
    <view wx:if="{{recordBrief && !showResult}}" class="pr-record pressable" hover-class="pressable--on" bindtap="onOpenRecord">
      <text class="tiny">{{recordBrief}}</text>
      <text class="text-link tiny">{{copy.actions.reviewRecord}} ›</text>
    </view>
    <text wx:elif="{{bestText}}" class="tiny mt8">{{bestText}}</text>
  </view>

  <!-- 开局卡：一行规则 + 难度，一屏读完。
       规则全文、盘上符号、本门机制都不在这里——它们是说明页的事，
       首屏只回答两个问题：这一局做什么、打多难。 -->
  <view wx:if="{{!started && !showResult}}" class="card">
    <view class="row--between">
      <text class="section__title">{{copy.sections.rule}}</text>
      <text class="tiny">{{twistName}}</text>
    </view>
    <text class="body mt8">{{ruleText}}</text>

    <block wx:if="{{showDifficulty}}">
      <view class="divider"></view>
      <view class="row--between">
        <text class="section__title">难度</text>
        <text class="tiny">{{diffName}} · {{diffMultText}}</text>
      </view>
      <view class="diff-row mt12">
        <view wx:for="{{diffList}}" wx:key="key" class="diff-chip {{item.current ? 'diff-chip--on' : ''}} {{item.unlocked ? '' : 'diff-chip--lock'}}" data-d="{{item.key}}" bindtap="onDifficulty">
          <text class="diff-chip__name">{{item.name}}</text>
          <!-- 已解锁但刻意选低档：胶囊上直接给折后半数，别让人以为还是 ×1.30。 -->
          <text class="diff-chip__mult">{{item.below ? item.realMultText : item.multText}}</text>
          <text wx:if="{{!item.unlocked}}" class="diff-chip__need">{{item.lockedText}}</text>
        </view>
      </view>
      <!-- 折减只在真的选了低档时出现一行：说清折什么、S 算不算、该回哪一档。 -->
      <text wx:if="{{belowCapText}}" class="warn-note mt8">{{belowCapText}}</text>
      <!-- 高档位不只有倍率：这一档实际收紧了哪几处（亮起时长 / 口诀轮数…），一一摆出来。 -->
      <text wx:if="{{diffBrief}}" class="tiny diff-brief">{{diffBrief}}</text>
      <!-- S 线随难度档变：局内只报「还差几分」，这一行给出本档总分门槛与评级口径。 -->
      <text wx:if="{{goalText}}" class="tiny diff-brief">{{goalText}}</text>
      <!-- 收益口径：只奖不罚，开局前就写清本局会不会吃到换门加成。 -->
      <text class="tiny diff-brief">{{repeatNote}}</text>
    </block>

    <block wx:if="{{stageRules.length}}">
      <view class="divider"></view>
      <!-- 本门新法默认折叠：开关要能在开局前改，但几条规则不该铺在首屏。
           这里原来还挂过一个 term 角标，渲染出来是「本门新法?」紧挨同名小标题，
           一屏两遍同名；解释交给说明页的名词速查。 -->
      <view class="row--between pressable" hover-class="pressable--on" bindtap="onToggleStage">
        <text class="section__title">本门新法</text>
        <text class="text-link text-link--muted">{{stageOpen ? copy.actions.collapse : stageSummary}}<text wx:if="{{!stageOpen}}"> ›</text></text>
      </view>
      <!-- 折叠态给一行「已得的那几条长什么样」；未解锁的、被关掉的一律不列，
           新手第一眼看到的是「现在多了什么」，不是五条还没影的规则。 -->
      <text wx:if="{{!stageOpen && stageBrief}}" class="tiny mt8">{{stageBrief}}</text>
      <block wx:if="{{stageOpen}}">
        <!-- 展开后先答一句「这是永久被动还是只有本局」：习得是永久的，效果每局从头算。
             折叠态不放它——那时玩家要的是「现在多了什么」，不是生效范围。 -->
        <text class="tiny mt8">习得后每局生效 · 改规矩的可关</text>
        <view wx:for="{{stageRules}}" wx:key="name" class="stage-rule">
          <text class="tag {{item.tagCls}}">{{item.stateText}}</text>
          <text class="tiny grow stage-rule__text">{{item.name}} · {{item.desc}}</text>
          <!-- 关掉之后这一局就真的不触发：想专心练基础记忆的人得有退路。
               不用原生 switch：它在墨底上的未选中轨道是块白，和这套皮肤打架。 -->
          <view wx:if="{{item.toggle}}"
            class="stage-rule__toggle {{item.enabled ? 'stage-rule__toggle--on' : ''}} pressable"
            hover-class="pressable--on" data-name="{{item.name}}" data-next="{{item.enabled ? 'off' : 'on'}}"
            bindtap="onToggleTwist">{{item.enabled ? '开' : '关'}}</view>
        </view>
      </block>
    </block>

    <!-- 这一门：原「功法详情」那几段并进来，默认折起。
         点开才铺开来历、风味与练成之后——开局前要的是规则与难度，不是一篇功法小传。 -->
    <block wx:if="{{archive}}">
      <view class="divider"></view>
      <view class="row--between pressable" hover-class="pressable--on" bindtap="onToggleArchive">
        <text class="section__title">{{copy.sections.archive}}</text>
        <text class="text-link text-link--muted">{{archiveOpen ? copy.actions.collapse : copy.sections.archiveFold}}<text wx:if="{{!archiveOpen}}"> ›</text></text>
      </view>
      <block wx:if="{{archiveOpen}}">
        <text class="body mt8">{{archive.desc}}</text>
        <text class="quote pr-flavor">{{archive.flavor}}</text>
        <view class="pr-gain" wx:for="{{archive.gains}}" wx:key="label">
          <text class="tiny grow">{{item.label}}</text>
          <text class="pr-gain__v">{{item.value}}</text>
        </view>
      </block>
    </block>
  </view>

  <view wx:if="{{started && !showResult && vm}}" class="card pr-play">
    <!-- 首局手把手：不盖整屏、不遮盘面，就一张窄条说清这一手做什么。
         跳过直接进正式局——引导是「带着玩一次」，不是「读完才能玩」。 -->
    <view wx:if="{{tutorial}}" class="teach">
      <view class="row--between teach__head">
        <text class="tag tag--gold">教学 · 第 {{vm.teachStep}} / {{vm.teachTotal}} 步</text>
        <text class="text-link text-link--muted teach__skip pressable" hover-class="pressable--on" catchtap="onSkipTeach">{{copy.actions.skipTeach}} ›</text>
      </view>
      <text class="body teach__text">{{vm.teachText}}</text>
    </view>

    <view wx:if="{{!sceneOn && !tutorial}}" class="hud">
      <view class="row--between hud__top">
        <view class="hud__id">
          <text class="eyebrow hud__skill">{{title}}<text wx:if="{{diffName}}"> · {{diffName}}</text></text>
          <text class="hud__time">{{vm.timeText || '正在参悟'}}</text>
        </view>
        <view class="hud__right">
          <text wx:if="{{vm.comboText}}" class="combo-chip">{{vm.comboText}}</text>
          <text wx:if="{{vm.extras.showGradeNow}}" class="grade-chip" style="background:{{gradeNowColor}}"><text class="grade-chip__label">评级</text>{{vm.gradeNow}}</text>
          <view wx:if="{{!boardHeld}}" class="hud__quit" bindtap="onAbandon">收功</view>
        </view>
      </view>
      <view wx:if="{{vm.extras.showProgress}}" class="hud__track mt8">
        <view class="hud__fill" style="width:{{vm.progress}}%;background:{{theme.accent}}"></view>
      </view>
      <view class="row--between mt8">
        <text class="tiny grow hud__goal">{{vm.goal || vm.status}}</text>
        <text class="tag tag--jade">{{vm.scoreText}}</text>
      </view>
      <view wx:if="{{vm.extras.showHearts}}" class="hearts mt8">
        <text wx:for="{{heartList}}" wx:key="id" class="heart {{item.on ? 'heart--on' : ''}}">◆</text>
        <text class="tiny">心神 {{vm.hearts.value}} / {{vm.hearts.max}}</text>
      </view>
      <view wx:if="{{vm.extras.showMeter && vm.meter}}" class="meter mt8">
        <text class="tiny">{{vm.meter.label}} {{vm.meter.value}} / {{vm.meter.max}}</text>
        <view class="meter__track"><view class="meter__fill" style="width:{{meterPercent}}%;background:{{theme.accent}}"></view></view>
      </view>
    </view>

    <!-- 样板玩法的游戏化 HUD：香炷计息、命灯、刀势刻度、局内得分。
         这里原来把得分写成「灵石」——灵石是能换功法的资源，局内分数一分灵石都不是，
         同一局里「灵石 608」和结算「灵石 +3」会当场打架，改用与结算一致的「得分」。 -->
    <view wx:elif="{{!tutorial}}" class="scene-hud">
      <view class="scene-hud__top">
        <view class="scene-hud__id">
          <text class="scene-hud__name">{{title}} · {{diffName}}</text>
          <text class="scene-hud__incense">{{vm.progressText || vm.timeText}}</text>
        </view>
        <view class="scene-hud__right">
          <view class="scene-hud__lamps">
            <view wx:for="{{sceneLamps}}" wx:key="id" class="scene-hud__lamp {{item.on ? 'scene-hud__lamp--on' : ''}}"></view>
          </view>
          <text wx:if="{{vm.extras.showGradeNow}}" class="scene-hud__grade" style="background:{{gradeNowColor}}"><text class="grade-chip__label">评级</text>{{vm.gradeNow}}</text>
          <view wx:if="{{!boardHeld}}" class="scene-hud__quit" bindtap="onAbandon">收功</view>
        </view>
      </view>
      <view class="scene-hud__incense-track">
        <view class="scene-hud__incense-fill" style="width:{{incensePercent}}%"></view>
      </view>
      <view class="scene-hud__meter">
        <text class="scene-hud__meter-label">{{vm.meter ? vm.meter.label : '刀势'}}</text>
        <view class="scene-hud__meter-track">
          <view class="scene-hud__meter-fill" style="width:{{meterPercent}}%"></view>
          <view class="scene-hud__meter-tick" style="left:33%"></view>
          <view class="scene-hud__meter-tick" style="left:66%"></view>
        </view>
        <text class="scene-hud__combo">{{vm.comboText || '连击 0'}}</text>
      </view>
      <view class="scene-hud__score">
        <text class="scene-hud__score-label">得分</text>
        <text class="scene-hud__score-num">{{scoreNum}}</text>
        <text class="scene-hud__goal">{{vm.goal || vm.status}}</text>
      </view>
    </view>

    <text wx:if="{{vm.banner && !tutorial}}" class="banner mt12" style="{{sceneOn ? 'color:' + stage.glow + ';border-color:' + stage.deep : ''}}">{{vm.banner}}</text>

    <view wx:if="{{!tutorial && !boardHeld}}" class="pr-hint">
      <text class="tiny">{{vm.hint}}</text>
      <view wx:if="{{guide}}" class="pr-hint__terms"><text class="tiny">{{guide.inline}}</text></view>
    </view>

    <view class="stage">
      <view wx:if="{{vm.stage === 'charge' && vm.charge}}" class="charge">
        <view class="charge__track">
          <view class="charge__zone" style="left:{{vm.charge.start}}%;width:{{chargeWidth}}%"></view>
          <view class="charge__cursor" style="left:{{vm.charge.value}}%"></view>
        </view>
        <text class="tiny mt8">松手停在朱线内，越居中越好</text>
        <button class="btn btn--gold btn--block mt16" bindtouchstart="onPress" bindtouchend="onRelease" bindtouchcancel="onRelease" bindtap="onChargeTap">按住蓄力 · 松手定住</button>
      </view>

      <view wx:if="{{vm.stage === 'ring' && vm.ring}}" class="ring-area" bindtap="onCellTap">
        <view class="ring-judge"></view>
        <view class="ring-orb ring-orb--{{vm.ring.tone}}" style="transform:scale({{vm.ring.scale}});border-color:{{theme.accent}}">
          <text style="color:{{theme.ink}}">{{theme.glyph}}</text>
        </view>
        <text wx:if="{{!boardHeld}}" class="ring-tip">点按盘面 · 第 {{vm.ring.beat}} / {{vm.ring.total}} 拍</text>
      </view>

      <view wx:if="{{vm.stage === 'lane' && vm.lane}}" class="lane-rule">
        <text class="tiny">{{vm.lane.rule}} · 正采第 {{vm.lane.activeRow + 1}} / {{vm.lane.rows}} 层</text>
      </view>

      <view wx:if="{{vm.trail && started && !boardHeld}}" class="trail-hint">
        <text class="trail-hint__name">{{vm.trail.name}}</text>
        <text class="tiny">顺箭头扫斩 {{trailLen}} 桩 · {{vm.trail.rule || '反向算劈空'}}</text>
      </view>

      <view wx:if="{{(vm.stage === 'board' || vm.stage === 'lane') && vm.extras.showGrid}}" class="grid grid--c{{vm.cols}} {{vm.stage === 'lane' ? 'grid--lane' : ''}} {{vm.extras.compact ? 'grid--compact' : ''}}" style="background:{{sceneOn ? stage.well : theme.bg}}">
        <view wx:for="{{slashList}}" wx:key="key" class="grid__slash" style="transform:translate(-50%,-50%) rotate({{item.angle}}deg)">
          <view class="grid__slash-beam"></view>
        </view>
        <view wx:for="{{vm.cells}}" wx:key="key" class="{{item.cls}} cell--t{{item.tone}}" style="border-color:{{sceneOn ? stage.deep : theme.frame}}" data-index="{{index}}" bindtap="onCellTap" bindlongpress="onCellLongPress" hover-class="cell--press" hover-stay-time="60">
          <view wx:if="{{item.life}}" class="cell__life" style="animation-duration:{{item.life}}ms;animation-delay:{{item.lifeDelay}}ms"></view>
          <!-- 刀路用形状指方向：每桩一个箭头指向下一桩，收势桩是靶心。盘面不放汉字。 -->
          <view wx:if="{{item.arrow >= 0}}" class="cell__arrow" style="transform:translate(-50%,-50%) rotate({{item.arrow}}deg)">
            <view class="cell__arrow-head"></view>
            <view class="cell__arrow-shaft"></view>
          </view>
          <view wx:if="{{item.end}}" class="cell__end {{item.endLive ? 'cell__end--live' : ''}}"></view>
          <!-- 灵纹牌画的是纹样（crest），其余玩法仍是字形 / 数字。纹样由 wxss 画，
               不用字体里的 ✦ ✿：那类字符在部分安卓上会被系统换成彩色 emoji。 -->
          <view wx:if="{{item.crest}}" class="cell__crest crest--{{item.crest}}"></view>
          <text wx:else>{{item.label}}</text>
        </view>
        <!-- 收牌迸溅：收走的那一格在原位炸开一小把，颜色跟着那张牌的纹样走。
             做成盘面上的独立浮层而不是格子自己的伪元素：消消乐收完立刻掉落重排，
             格子当场换了内容，没法自己演「我被收走了」。 -->
        <view wx:for="{{sparkList}}" wx:key="id" class="spark" style="left:{{item.x}}%;top:{{item.y}}%">
          <view class="spark__core"></view>
          <view class="spark__ring" style="border-color:{{item.color}}"></view>
          <view wx:for="{{item.dots}}" wx:key="id" wx:for-item="dot" class="spark__dot" style="background:{{item.color}};width:{{dot.size}}rpx;height:{{dot.size}}rpx;margin:{{dot.mt}}rpx 0 0 {{dot.mt}}rpx;--a:{{dot.a}}deg;--d:{{dot.d}}rpx;animation-delay:{{dot.delay}}ms"></view>
        </view>
        <!-- 划刀玩法的透明触摸层：盖住静态格子，用手势坐标还原一条连续轨迹 -->
        <view wx:if="{{vm.extras.showSwipe && started && !boardHeld}}" class="swipe-layer" bindtouchstart="onBoardTouchStart" catchtouchmove="onBoardTouchMove" bindtouchend="onBoardTouchEnd" bindtouchcancel="onBoardTouchEnd"></view>
      </view>

      <!-- 华容道：块是整块滑的，用绝对定位按格摆；格子拼出来的块会被缝线切碎，
           看不出「这是一整块」，滑动的手感也就没了。 -->
      <view wx:if="{{vm.stage === 'klotski' && vm.klotski}}" class="klotski" style="background:{{sceneOn ? stage.well : theme.bg}}">
        <view class="klotski__exit" style="left:{{vm.klotski.exitC * 25}}%"></view>
        <view wx:for="{{vm.klotski.blocks}}" wx:key="id"
          class="klotski__blk klotski__blk--{{item.id}} {{item.sel ? 'klotski__blk--sel' : ''}}"
          style="left:{{item.x}}%;top:{{item.y}}%;width:{{item.w}}%;height:{{item.h}}%"
          data-i="{{index}}" bindtap="onBlockTap">
          <view wx:if="{{item.main}}" class="klotski__core"></view>
        </view>
      </view>

      <!-- 只有持续下落的玩法才挂方向键：挪石 / 转石 / 速降，其余玩法盘面下不留这一排。 -->
      <view wx:if="{{vm.extras.showPad && vm.pad && started && !boardHeld}}" class="pad {{vm.pad.digits ? 'pad--numbers' : ''}}">
        <view wx:for="{{vm.pad.keys}}" wx:key="id" class="pad__key" data-dir="{{item.dir}}" bindtap="onPad" hover-class="pad__key--press" hover-stay-time="60"><text>{{item.glyph}}</text></view>
      </view>

      <view wx:if="{{vm.stage === 'orbit' && vm.orbit}}" class="orbit">
        <view class="orbit__core">
          <text class="orbit__glyph" style="color:{{theme.ink}}">{{vm.orbit.currentText}}</text>
          <text class="tiny">当前一行</text>
          <text class="tiny">{{vm.orbit.rule}}</text>
        </view>
        <view wx:for="{{vm.orbit.lamps}}" wx:key="id" class="orbit__lamp orbit__lamp--{{index}} orbit__lamp--t{{item.tone}} {{item.cls}}" data-index="{{index}}" bindtap="onCellTap">
          <text>{{item.label}}</text>
        </view>
      </view>

      <view wx:if="{{vm.stage === 'scroll' && vm.scroll}}" class="scroll">
        <text class="tiny">第 {{vm.scroll.segment}} / {{vm.scroll.total}} 段 · 照卷轴依次踏位</text>
        <view class="scroll__ribbon">
          <view wx:for="{{vm.scroll.moves}}" wx:key="id" class="scroll__move scroll__move--{{item.state}}">
            <view class="step step--{{item.dir}}">
              <view class="step__arrow"></view>
              <view class="step__ring"></view>
            </view>
          </view>
        </view>
        <view wx:if="{{!boardHeld}}" class="scroll__keys">
          <view wx:for="{{vm.scroll.keys}}" wx:key="id" class="scroll__key scroll__key--{{item.dir}}" hover-class="scroll__key--press" data-index="{{item.index}}" bindtap="onCellTap">
            <view class="step step--{{item.dir}} step--lg">
              <view class="step__arrow"></view>
              <view class="step__ring"></view>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{vm.fx}}" class="fx fx--{{vm.fx.tone}} fx--k{{vm.fx.n}}">{{vm.fx.text}}</view>
      <!-- 命中爆发：id 变化即重建节点，CSS 动画才会重播 -->
      <view wx:for="{{burstList}}" wx:key="id" wx:for-item="burst" class="burst burst--l{{burst.level}}">
        <view wx:if="{{burst.flash}}" class="burst__flash burst__flash--{{burst.flash}}"></view>
        <view wx:for="{{burst.dots}}" wx:key="id" wx:for-item="dot" class="burst__dot" style="--a:{{dot.a}}deg;--d:{{dot.d}}rpx;animation-delay:{{dot.delay}}ms"></view>
      </view>
    </view>

  </view>

  <view wx:if="{{barMode === 'start'}}" class="sticky-bar">
    <text class="text-link text-link--muted" bindtap="onBack">{{copy.actions.leave}}</text>
    <button class="btn btn--primary" bindtap="onStart">{{copy.actions.start}}</button>
  </view>

  <!-- 本局已终、盘面留在屏上：盘面不能再点，去处全在这一条。 -->
  <view wx:if="{{barMode === 'done'}}" class="sticky-bar sticky-bar--done">
    <text class="text-link text-link--muted pressable" hover-class="pressable--on" bindtap="onOpenRecord">{{copy.actions.reviewRecord}}</text>
    <text class="text-link text-link--muted pressable" hover-class="pressable--on" bindtap="onBack">{{copy.actions.backSkills}}</text>
    <button class="btn btn--primary" bindtap="onAgain">{{copy.actions.again}}</button>
  </view>

  <view wx:if="{{barMode === 'tools'}}" class="sticky-bar sticky-bar--tools">
    <button wx:if="{{vm.extras.showUndo}}" class="btn btn--ghost btn--small" bindtap="onUndo">撤销</button>
    <button wx:if="{{vm.extras.showReset}}" class="btn btn--ghost btn--small" bindtap="onReset">{{copy.actions.resetBoard}}</button>
    <button wx:if="{{vm.extras.showHint}}" class="btn btn--plain btn--small" bindtap="onHint">{{hintLabel}}</button>
  </view>

  <view wx:if="{{countdown > 0}}" class="countdown-mask" bindtap="onSkipCountdown">
    <view class="countdown-inner">
      <text class="countdown-seal">{{theme.motif}}</text>
      <text class="countdown-num">{{countdown}}</text>
      <text class="tiny">凝神 · 起手（点一下跳过）</text>
      <text class="text-link countdown__stay pressable" hover-class="pressable--on" catchtap="onCancelCountdown">{{copy.actions.cancelStart}}</text>
    </view>
  </view>

  <!-- 换一门练：一层已持功法，点一门就整页重开（换的是「现在对着哪一门」，不动任何进度）。 -->
  <view class="mask" wx:if="{{swapOpen}}" bindtap="onToggleSwap">
    <view class="modal" catchtap="noop">
      <text class="modal__title">{{copy.sections.swapTitle}}</text>
      <text class="modal__sub">换的是这一页对着哪一门，进度一点不动</text>
      <view class="imm-list mt12">
        <view class="imm-row pressable" hover-class="pressable--on" wx:for="{{swapList}}" wx:key="id" data-id="{{item.id}}" bindtap="onSwapTo">
          <view class="imm-row__mark">{{item.mark}}</view>
          <view class="imm-row__body">
            <text class="imm-row__name">{{item.name}}</text>
            <text class="imm-row__sub">{{item.metaText}}</text>
          </view>
          <text wx:if="{{item.current}}" class="imm-chip imm-chip--jade">当前</text>
        </view>
      </view>
      <view class="modal__actions">
        <button class="imm-btn--ghost imm-btn--block" bindtap="onToggleSwap">{{copy.actions.close}}</button>
      </view>
    </view>
  </view>

  <!-- 样板玩法的结算五段演出：暗场 → 评级 → 熟练度条 → 奖励 → 按钮 -->
  <view wx:if="{{sceneOn && showResult && result}}" class="settle" bindtap="onSkipSettle">
    <view class="settle__veil"></view>
    <view class="settle__aura"></view>
    <view class="settle__panel">
      <view wx:if="{{settlePhase >= 1}}" class="settle__grade-wrap {{settleFull ? 'settle__grade-wrap--full' : ''}} {{result.grade === 'F' || result.grade === '收' ? 'settle__grade-wrap--fail' : ''}}">
        <text class="settle__grade {{result.grade === 'F' || result.grade === '收' ? 'settle__grade--fail' : ''}}">{{result.grade}}</text>
      </view>
      <block wx:if="{{settlePhase >= 2}}">
        <text class="settle__title">{{result.headline}}</text>
        <text class="settle__sub">{{result.gradeTitle}} · {{result.subline}}</text>
        <view class="settle__gain">
          <text class="settle__gain-num">{{settleGain}}</text>
          <text class="settle__gain-label">熟练度</text>
        </view>
        <view class="settle__bar"><view class="settle__bar-fill" style="width:{{settlePercent}}%"></view></view>
      </block>
      <block wx:if="{{settlePhase >= 3}}">
        <view class="settle__rewards">
          <view wx:for="{{result.lines}}" wx:key="k" class="settle__reward" style="animation-delay:{{index * 80}}ms">
            <text class="settle__reward-k">{{item.k}}</text>
            <text class="settle__reward-v">{{item.v}}</text>
          </view>
        </view>
        <view wx:for="{{result.notes}}" wx:key="*this" class="settle__notes"><text>· {{item}}</text></view>
      </block>
      <view wx:if="{{settlePhase >= 4}}" class="settle__actions">
        <button class="btn btn--plain" catchtap="onSecondary">{{result.secondary}}</button>
        <button class="btn btn--primary" catchtap="onPrimary">{{result.primary}}</button>
      </view>
      <text wx:if="{{settlePhase >= 4 && result.canStay}}" class="text-link text-link--muted settle__again pressable" hover-class="pressable--on" catchtap="onStay">{{copy.actions.stay}} ›</text>
    </view>
    <text wx:if="{{settlePhase < 4}}" class="settle__skip">点任意处跳过演出</text>
  </view>

  <view class="mask" wx:elif="{{showResult && result}}">
    <view class="modal modal--reveal">
      <view class="grade" style="background:{{result.gradeColor}}">{{result.grade}}</view>
      <text class="modal__title mt16">{{result.headline}}</text>
      <text class="modal__sub">{{result.gradeTitle}} · {{result.subline}}</text>

      <view class="modal__body" wx:if="{{result.lines.length > 0}}">
        <view class="res-line" wx:for="{{result.lines}}" wx:key="k">
          <text class="muted">{{item.k}}</text>
          <text class="h3 jade">{{item.v}}</text>
        </view>
      </view>

      <view class="modal__body" wx:if="{{result.notes.length > 0}}">
        <view class="res-note" wx:for="{{result.notes}}" wx:key="*this">
          <text class="body">· {{item}}</text>
        </view>
      </view>

      <view class="modal__body" wx:if="{{result.titles.length > 0}}">
        <text class="tag tag--gold">新称号</text>
        <view class="row--wrap mt8">
          <text class="tag tag--jade" wx:for="{{result.titles}}" wx:key="*this">{{item}}</text>
        </view>
      </view>

      <view class="modal__actions">
        <button class="btn btn--plain" bindtap="onSecondary">{{result.secondary}}</button>
        <button class="btn btn--primary" bindtap="onPrimary">{{result.primary}}</button>
      </view>
      <text wx:if="{{result.canStay}}" class="text-link text-link--muted modal__again pressable" hover-class="pressable--on" bindtap="onStay">{{copy.actions.stay}} ›</text>
    </view>
  </view>

</view>
