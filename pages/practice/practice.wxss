.pr-head {
    padding: 32rpx;
}

.pr-eyebrow {
    color: #d8b775;
}

.pr-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.pr-title {
    display: block;
    margin-top: 18rpx;
    color: #fffdf7;
}

.pr-seal {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 88rpx;
    height: 88rpx;
    margin-top: 14rpx;
    border: 4rpx solid #b8893b;
    border-radius: 18rpx;
    font-family: serif;
    font-size: 46rpx;
    transform: rotate(-6deg);
}

.pr-desc {
    display: block;
    margin-top: 12rpx;
    color: #c9d6cd;
    font-size: 25rpx;
    line-height: 1.7;
}

.pr-prof {
    margin-top: 28rpx;
}

.pr-tiny {
    color: #c9d6cd;
}

/* ---------- 局内 HUD ---------- */
.pr-play {
    padding: 26rpx 28rpx 24rpx;
}

/* 局内不再显示功法头卡，靠这一行小字交代「在练哪门、什么难度」 */
.hud__top {
    align-items: flex-start;
}

.hud__id {
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.hud__skill {
    color: #9a9a8b;
    font-size: 20rpx;
    letter-spacing: 2rpx;
}

.hud__time {
    margin-top: 4rpx;
    font-size: 40rpx;
    line-height: 1.2;
}

.hud__right {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    padding-top: 6rpx;
}

/* 收功：留在屏幕上方，离拇指热区远一点，误触代价太大 */
.hud__quit {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 56rpx;
    margin-left: 14rpx;
    padding: 0 18rpx;
    border: 2rpx solid rgba(120, 130, 120, 0.3);
    border-radius: 999rpx;
    color: #8a8f83;
    font-size: 22rpx;
    line-height: 1;
}

.hud__goal {
    line-height: 1.5;
}

.pr-hint {
    margin-top: 12rpx;
}

.pr-hint .tiny {
    line-height: 1.55;
}

/* 局内常驻一行术语速记：玩到一半看不懂符号时不用退出查说明 */
.pr-hint__terms {
    margin-top: 10rpx;
    padding: 10rpx 14rpx;
    border-left: 6rpx solid var(--acc, #3d8c74);
    border-radius: 0 8rpx 8rpx 0;
    background: var(--soft, #e9e3d4);
}

.pr-hint__terms .tiny {
    color: var(--ink, #2f6b5b);
    line-height: 1.5;
}

/* ---------- 准备页「怎么玩」 ---------- */
.guide__toggle {
    font-size: 23rpx;
}

.guide__goal {
    display: block;
    line-height: 1.7;
}

.guide__steps {
    margin-top: 16rpx;
}

.guide__step {
    display: flex;
    align-items: flex-start;
    gap: 12rpx;
    margin-top: 12rpx;
}

.guide__no {
    flex: 0 0 36rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36rpx;
    height: 36rpx;
    border-radius: 50%;
    background: var(--soft, #e9e3d4);
    color: var(--ink, #2f6b5b);
    font-size: 20rpx;
}

.guide__step .tiny,
.guide__term-desc {
    line-height: 1.6;
}

.guide__term {
    display: flex;
    align-items: flex-start;
    gap: 12rpx;
    margin-top: 14rpx;
}

.guide__term-name {
    flex: 0 0 auto;
    max-width: 240rpx;
    text-align: left;
}

.guide__note {
    padding: 14rpx 16rpx;
    border-left: 5rpx solid var(--acc, #3d8c74);
    border-radius: 0 8rpx 8rpx 0;
    background: var(--soft, #e9e3d4);
}

.guide__note .tiny {
    display: block;
    line-height: 1.6;
}

.guide__inline {
    padding: 12rpx 14rpx;
    border-radius: 8rpx;
    background: var(--soft, #e9e3d4);
}

.combo-chip {
    margin-right: 12rpx;
    font-size: 26rpx;
    font-weight: 600;
}

.grade-chip {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52rpx;
    height: 52rpx;
    border-radius: 50%;
    color: #fffdf7;
    font-size: 30rpx;
    font-weight: 700;
}

.hud__track {
    overflow: hidden;
    height: 14rpx;
    border-radius: 10rpx;
    background: var(--soft, #e9e3d4);
}

.hud__fill {
    height: 100%;
    border-radius: 10rpx;
    transition: width 0.25s ease;
}

.hearts {
    display: flex;
    align-items: center;
}

.heart {
    margin-right: 8rpx;
    color: #c9c5b7;
    font-size: 28rpx;
}

.heart--on {
    color: var(--acc, #3d8c74);
}

.hearts .tiny {
    margin-left: 8rpx;
}

.meter__track {
    overflow: hidden;
    height: 10rpx;
    margin-top: 6rpx;
    border-radius: 8rpx;
    background: var(--soft, #e9e3d4);
}

.meter__fill {
    height: 100%;
    border-radius: 8rpx;
    transition: width 0.2s ease;
}

.banner {
    display: block;
    padding: 12rpx 0;
    border-top: 2rpx solid #b8893b;
    border-bottom: 2rpx solid #b8893b;
    text-align: center;
    font-family: serif;
    font-size: 30rpx;
    letter-spacing: 4rpx;
    animation: bannerIn 0.4s ease-out;
}

/* ---------- 舞台与浮字 ---------- */
.stage {
    position: relative;
    margin-top: 8rpx;
}

.fx {
    position: absolute;
    top: 34%;
    left: 0;
    right: 0;
    z-index: 5;
    text-align: center;
    font-size: 34rpx;
    font-weight: 700;
    pointer-events: none;
}

.fx--good { color: var(--acc, #3d8c74); }
.fx--bad { color: #b4453c; }
.fx--gold { color: #b8893b; }
.fx--k0, .fx--k1 { animation: fxFloat 0.9s ease-out forwards; }

/* ---------- 蓄力停区 ---------- */
.charge {
    margin-top: 24rpx;
}

.charge__track {
    position: relative;
    overflow: hidden;
    height: 64rpx;
    border-radius: 14rpx;
    background: var(--soft, #e9e3d4);
}

.charge__zone {
    position: absolute;
    top: 0;
    bottom: 0;
    background: rgba(184, 137, 59, 0.42);
    border-left: 5rpx solid #b4453c;
    border-right: 5rpx solid #b4453c;
}

.charge__cursor {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 10rpx;
    background: var(--acc, #2f6b5b);
    transform: translateX(-5rpx);
}

/* ---------- 节律判定盘 ---------- */
.ring-area {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 440rpx;
    margin-top: 20rpx;
    border-radius: 20rpx;
    background: var(--soft, #e9e3d4);
}

.ring-judge {
    position: absolute;
    box-sizing: border-box;
    width: 200rpx;
    height: 200rpx;
    border: 6rpx solid #b4453c;
    border-radius: 50%;
    opacity: 0.65;
}

.ring-orb {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 200rpx;
    height: 200rpx;
    border: 8rpx solid var(--acc, #3d8c74);
    border-radius: 50%;
    background: var(--bg, #efe9db);
    font-family: serif;
    font-size: 56rpx;
}

.ring-orb--perfect { background: #f6e6c8; }
.ring-orb--good { background: #e2efe6; }
.ring-orb--miss { background: #f5dedb; }

.ring-tip {
    position: absolute;
    bottom: 24rpx;
    color: var(--ink, #5d6358);
    font-size: 24rpx;
}

/* ---------- 通用格子 ---------- */
.grid {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    margin-top: 24rpx;
    padding: 10rpx;
    border-radius: 18rpx;
    overflow: hidden;
}

.cell {
    box-sizing: border-box;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 5rpx solid #fffdf7;
    border-radius: 16rpx;
    background: var(--soft, #efe9db);
    color: var(--ink, #8a8f83);
    font-size: 30rpx;
    font-weight: 600;
}

.grid--c3 .cell { width: 33.3333%; height: 156rpx; }
.grid--c4 .cell { width: 25%; height: 128rpx; font-size: 26rpx; }
.grid--c6 .cell { width: 16.6666%; height: 100rpx; font-size: 24rpx; border-width: 3rpx; border-radius: 10rpx; }

.cell--lit {
    background: var(--acc, #3d8c74);
    color: #fffdf7;
    animation: litPop 0.35s ease-out;
}
.cell--off { background: #ded7c6; color: #a09e8f; }
.cell--ok { background: var(--acc, #b8893b); color: #fffdf7; }
.cell--bad { background: #b4453c; color: #fffdf7; animation: badShake 0.22s ease-out; }
.cell--hidden { background: #d5cdb9; color: #9a9a8b; }
.cell--open { background: #f7f3e8; color: var(--ink, #2f6b5b); font-weight: 700; }
.cell--flag { background: #f5ead2; color: #a2762d; }
.cell--sensed { background: #f5e2de; color: #b4453c; }
.cell--mine { background: #b4453c; color: #fffdf7; animation: badShake 0.3s ease-out; }
.cell--hint { background: #b8893b; color: #fffdf7; animation: litPop 0.5s ease-out infinite alternate; }
.cell--trail { background: var(--soft, #dcecf1); color: var(--ink, #22505f); }
.cell--gold { background: #b8893b; color: #fffdf7; }
.cell--hot { box-shadow: inset 0 0 0 6rpx rgba(255, 243, 205, 0.55); }
.cell--dead { background: #e6ddd0; color: #9b8f7f; box-shadow: inset 0 0 0 4rpx #b4453c; }
.cell--dead-lit { background: #efe6d8; }

/* ---------- 循光斩桩：刀路（划） ---------- */
.trail-hint {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-top: 20rpx;
}

.trail-hint__name {
    font-size: 32rpx;
    font-weight: 700;
    letter-spacing: 2rpx;
}

/* 刀路：已掠过的桩留一道浅光痕，光头最亮；金色是重斩长招。 */
.cell--path {
    background: rgba(74, 107, 134, 0.26);
    color: var(--ink, #254253);
    box-shadow: inset 0 0 0 3rpx rgba(74, 107, 134, 0.35);
}

.cell--pathgold {
    background: rgba(184, 137, 59, 0.3);
    color: #8a6524;
    box-shadow: inset 0 0 0 3rpx rgba(184, 137, 59, 0.45);
}

.cell--pathon {
    background: var(--acc, #4a6b86);
    color: #fffdf7;
    box-shadow: 0 0 20rpx rgba(74, 107, 134, 0.55);
    transform: scale(1.04);
}

.cell--pathgold.cell--pathon {
    background: #b8893b;
    box-shadow: 0 0 22rpx rgba(184, 137, 59, 0.65);
}

/* 双锋的虚招：同样有箭头与靶心，但整条路压暗一档。
   真假不靠猜——真招的靶心在呼吸（见 .cell__end--live），虚招是静止的。 */
.cell--pathfake {
    background: rgba(74, 107, 134, 0.1);
    color: rgba(74, 107, 134, 0.42);
    box-shadow: inset 0 0 0 3rpx rgba(74, 107, 134, 0.16);
}

/* 禁桩：红叉一目了然，划过即断势。叉用 currentColor，深色舞台跟着走。 */
.cell--ban {
    background: rgba(180, 69, 60, 0.1);
    color: rgba(180, 69, 60, 0.72);
    box-shadow: inset 0 0 0 3rpx rgba(180, 69, 60, 0.3);
}

.cell--ban::before,
.cell--ban::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 54rpx;
    height: 6rpx;
    margin-left: -27rpx;
    margin-top: -3rpx;
    border-radius: 3rpx;
    background: currentColor;
}

.cell--ban::before { transform: rotate(45deg); }
.cell--ban::after { transform: rotate(-45deg); }

.cell--cut {
    background: #fffdf7;
    color: var(--acc, #4a6b86);
    animation: hitPop 0.18s ease-out;
}

/* 刀路方向：纯 CSS 三角 + 短杆，0° 朝上，inline transform 按相邻桩方向旋转。
   不用汉字、不用 unicode 字形，颜色继承格子 currentColor，浅色 / 深色舞台都清楚。 */
.cell__arrow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 56rpx;
    height: 56rpx;
    pointer-events: none;
}

.cell__arrow-head {
    position: absolute;
    left: 50%;
    top: 2rpx;
    width: 0;
    height: 0;
    margin-left: -13rpx;
    border-left: 13rpx solid transparent;
    border-right: 13rpx solid transparent;
    border-bottom: 20rpx solid currentColor;
}

.cell__arrow-shaft {
    position: absolute;
    left: 50%;
    top: 20rpx;
    width: 6rpx;
    height: 30rpx;
    margin-left: -3rpx;
    border-radius: 3rpx;
    background: currentColor;
}

/* 收势桩：双环靶心，一眼看出「划到这里为止」 */
.cell__end {
    position: absolute;
    left: 50%;
    top: 50%;
    box-sizing: border-box;
    width: 34rpx;
    height: 34rpx;
    border: 5rpx solid currentColor;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
}

.cell__end::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10rpx;
    height: 10rpx;
    border-radius: 50%;
    background: currentColor;
    transform: translate(-50%, -50%);
}

/* 双锋：真招靶心呼吸，虚招静止。只动 opacity 与 transform，守住动效预算。 */
.cell__end--live {
    animation: endBreath 1.1s ease-in-out infinite;
}

@keyframes endBreath {
    0%, 100% { opacity: 0.4; transform: translate(-50%, -50%) scale(0.88); }
    50% { opacity: 1; transform: translate(-50%, -50%) scale(1.14); }
}

/* 斩中时按刀招角度扫过盘面的一道白光：外层定位旋转，内层做扫光动画 */
.grid__slash {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 150%;
    height: 14rpx;
    z-index: 2;
    pointer-events: none;
}

.grid__slash-beam {
    width: 100%;
    height: 100%;
    border-radius: 8rpx;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.85) 22%, #fff 50%, rgba(255, 255, 255, 0.85) 78%, transparent);
    box-shadow: 0 0 20rpx rgba(255, 255, 255, 0.85);
    transform-origin: center;
    animation: slashSweep 0.24s ease-out forwards;
}

@keyframes slashSweep {
    0% { transform: scaleX(0); opacity: 0; }
    22% { opacity: 1; }
    100% { transform: scaleX(1); opacity: 0; }
}

/* 透明触摸层：只在划刀玩法的局内出现，其它玩法的滚动与点按完全不受影响 */
.swipe-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    z-index: 3;
}

/* ---------- 循光斩桩：刀光寿命线 / 重斩 / 斩中 ---------- */
.cell__life {
    position: absolute;
    left: 10rpx;
    right: 10rpx;
    bottom: 9rpx;
    height: 6rpx;
    border-radius: 3rpx;
    background: rgba(255, 253, 247, 0.92);
    transform-origin: left center;
    animation-name: lifeDrain;
    animation-timing-function: linear;
    animation-fill-mode: forwards;
    pointer-events: none;
}

@keyframes lifeDrain {
    from { transform: scaleX(1); }
    to { transform: scaleX(0); }
}

.cell--edge {
    background: #b8893b;
    color: #fffdf7;
    box-shadow: inset 0 0 0 6rpx rgba(255, 243, 205, 0.85);
    animation: litPop 0.3s ease-out;
}

.cell--hit {
    background: #fffdf7;
    color: var(--acc, #4a6b86);
    animation: hitPop 0.18s ease-out;
}

.cell--faded {
    background: #cfc8b8;
    color: #9a9a8b;
}

@keyframes hitPop {
    0% { transform: scale(1.07); }
    100% { transform: scale(1); }
}

/* 五行分色只作用于亮起的格子，t0 留给主题主色 */
.cell--lit.cell--t1 { background: #4f8f5a; }
.cell--lit.cell--t2 { background: #c25b3f; }
.cell--lit.cell--t3 { background: #b8893b; }
.cell--lit.cell--t4 { background: #7d8398; }
.cell--lit.cell--t5 { background: #3b7a8c; }

/* ---------- 辨伪择真：真招与虚影 ---------- */
.cell--decoy {
    background: #8d8b7d;
    color: #fffdf7;
}

/* ---------- 循纹递推：竖向河道 ---------- */
.lane-rule {
    box-sizing: border-box;
    margin-top: 20rpx;
    padding: 14rpx 18rpx;
    border-left: 6rpx solid var(--acc, #3d8c74);
    border-radius: 10rpx;
    background: var(--soft, #e9e3d4);
}

.grid--lane {
    padding: 18rpx;
    background: linear-gradient(180deg, var(--soft, #e9e3d4), var(--bg, #efe9db));
}

.grid--lane .cell {
    height: 108rpx;
    border-radius: 12rpx;
}

.grid--lane .cell--fog {
    background: rgba(120, 140, 150, 0.16);
    color: transparent;
    border-style: dashed;
}

.grid--lane .cell--trail {
    background: var(--soft, #e9e3d4);
    color: var(--ink, #5d6358);
    opacity: 0.6;
}

.grid--lane .cell--stone {
    background: var(--bg, #efe9db);
    color: var(--ink, #5d6358);
    border-color: var(--acc, #3d8c74);
    font-size: 34rpx;
}

.grid--lane .cell--stone.cell--t1 { box-shadow: inset 0 -10rpx 0 rgba(79, 143, 90, 0.5); }
.grid--lane .cell--stone.cell--t2 { box-shadow: inset 0 -10rpx 0 rgba(194, 91, 63, 0.5); }
.grid--lane .cell--stone.cell--t3 { box-shadow: inset 0 -10rpx 0 rgba(184, 137, 59, 0.55); }
.grid--lane .cell--stone.cell--t4 { box-shadow: inset 0 -10rpx 0 rgba(125, 131, 152, 0.55); }
.grid--lane .cell--stone.cell--t5 { box-shadow: inset 0 -10rpx 0 rgba(59, 122, 140, 0.55); }

/* ---------- 成对翻牌：牌背 / 翻开 / 已通 ---------- */
.cell--card {
    background: var(--ink, #5d6358);
    color: var(--bg, #efe9db);
    font-family: serif;
    font-size: 38rpx;
}

.cell--flipped {
    background: var(--bg, #efe9db);
    color: var(--ink, #5d6358);
    border-color: var(--acc, #3d8c74);
    font-family: serif;
    font-size: 38rpx;
    animation: litPop 0.28s ease-out;
}

.cell--flipped.cell--t1 { color: #4f8f5a; }
.cell--flipped.cell--t2 { color: #c25b3f; }
.cell--flipped.cell--t3 { color: #a8791f; }
.cell--flipped.cell--t4 { color: #6f5b9e; }
.cell--flipped.cell--t5 { color: #3b7a8c; }

.cell--matched {
    background: var(--soft, #e9e3d4);
    color: var(--ink, #5d6358);
    opacity: 0.5;
}

/* ---------- 五行相生：五盏灯围成一环 ---------- */
.orbit {
    position: relative;
    height: 480rpx;
    margin-top: 20rpx;
    border-radius: 20rpx;
    background: var(--soft, #e9e3d4);
}

.orbit__core {
    position: absolute;
    top: 50%;
    left: 50%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 190rpx;
    height: 190rpx;
    border: 6rpx solid var(--acc, #3d8c74);
    border-radius: 50%;
    background: var(--bg, #efe9db);
    transform: translate(-50%, -50%);
}

.orbit__glyph {
    font-family: serif;
    font-size: 62rpx;
    line-height: 1.2;
}

.orbit__lamp {
    position: absolute;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 112rpx;
    height: 112rpx;
    border: 5rpx solid var(--frame, #fffdf7);
    border-radius: 50%;
    background: var(--bg, #efe9db);
    color: var(--ink, #5d6358);
    font-family: serif;
    font-size: 38rpx;
}

.orbit__lamp--0 { top: 16rpx; left: 50%; transform: translateX(-50%); }
.orbit__lamp--1 { top: 118rpx; right: 34rpx; }
.orbit__lamp--2 { right: 74rpx; bottom: 32rpx; }
.orbit__lamp--3 { bottom: 32rpx; left: 74rpx; }
.orbit__lamp--4 { top: 118rpx; left: 34rpx; }

.orbit__lamp--t1 { border-color: #4f8f5a; }
.orbit__lamp--t2 { border-color: #c25b3f; }
.orbit__lamp--t3 { border-color: #b8893b; }
.orbit__lamp--t4 { border-color: #7d8398; }
.orbit__lamp--t5 { border-color: #3b7a8c; }

.orbit__lamp.lamp--current {
    background: var(--acc, #3d8c74);
    color: #fffdf7;
    box-shadow: 0 0 0 8rpx rgba(184, 137, 59, 0.28);
}

.orbit__lamp.lamp--hit {
    background: #b8893b;
    color: #fffdf7;
    animation: litPop 0.35s ease-out;
}

/* ---------- 步法连段：卷轴 + 四个步法键 ---------- */
.scroll {
    box-sizing: border-box;
    margin-top: 20rpx;
    padding: 20rpx;
    border-radius: 18rpx;
    background: var(--soft, #e9e3d4);
}

.scroll__ribbon {
    display: flex;
    flex-wrap: wrap;
    min-height: 88rpx;
    margin-top: 16rpx;
}

.scroll__move {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 76rpx;
    height: 76rpx;
    margin: 0 10rpx 10rpx 0;
    border: 4rpx solid var(--frame, #fffdf7);
    border-radius: 12rpx;
    background: var(--bg, #efe9db);
    color: var(--ink, #5d6358);
    font-family: serif;
    font-size: 34rpx;
}

.scroll__move--active {
    border-color: var(--acc, #3d8c74);
    background: var(--acc, #3d8c74);
    color: #fffdf7;
    animation: litPop 0.35s ease-out;
}

.scroll__move--done { opacity: 0.42; }

.scroll__keys {
    display: flex;
    margin-top: 20rpx;
}

.scroll__key {
    box-sizing: border-box;
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    height: 120rpx;
    margin-right: 12rpx;
    border: 5rpx solid var(--acc, #3d8c74);
    border-radius: 16rpx;
    background: var(--bg, #efe9db);
    color: var(--ink, #5d6358);
    font-family: serif;
    font-size: 44rpx;
}

.scroll__key:last-child { margin-right: 0; }

/* ---------- 起手式 ---------- */
.countdown-mask {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(20, 26, 24, 0.82);
}

.countdown-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: #fffdf7;
}

.countdown-seal {
    font-family: serif;
    font-size: 72rpx;
    letter-spacing: 10rpx;
}

.countdown-num {
    color: #fffdf7;
    font-size: 150rpx;
    line-height: 1.4;
    animation: litPop 0.36s ease-out;
}

.countdown-inner .tiny { color: #c9d6cd; }

/* ---------- 结算 ---------- */
.modal--reveal { animation: modalReveal 0.42s ease-out; }

.res-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14rpx 0;
    border-bottom: 2rpx solid #f0ebdd;
}

.res-note { padding: 6rpx 0; }

.res-note .body { color: #5d6358; }

@keyframes litPop {
    0% { transform: scale(0.82); opacity: 0.45; }
    60% { transform: scale(1.06); opacity: 1; }
    100% { transform: scale(1); opacity: 1; }
}
@keyframes badShake {
    0%, 100% { transform: translateX(0); }
    30% { transform: translateX(-8rpx); }
    70% { transform: translateX(8rpx); }
}
@keyframes fxFloat {
    0% { opacity: 0; transform: translateY(18rpx) scale(0.9); }
    18% { opacity: 1; transform: translateY(0) scale(1); }
    75% { opacity: 1; transform: translateY(-10rpx); }
    100% { opacity: 0; transform: translateY(-46rpx); }
}
@keyframes bannerIn {
    from { opacity: 0; letter-spacing: 14rpx; }
    to { opacity: 1; letter-spacing: 4rpx; }
}
@keyframes modalReveal {
    from { opacity: 0; transform: translateY(30rpx) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
}

/* ---------- 功法品阶与进阶链 ---------- */
.rank-card {
    border: 1rpx solid rgba(0, 0, 0, 0.08);
    border-radius: 12rpx;
    padding: 20rpx 22rpx;
}
.rank-badge {
    width: 46rpx;
    height: 46rpx;
    margin-right: 12rpx;
    border-radius: 8rpx;
    color: #fffdf7;
    font-size: 26rpx;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
}
.rank-diff { display: flex; flex-direction: column; gap: 6rpx; }
.rank-chain__item {
    display: inline-block;
    margin: 0 10rpx 10rpx 0;
    padding: 8rpx 14rpx;
    border-radius: 8rpx;
    background: rgba(120, 130, 120, 0.10);
    color: var(--ink, #4a5a51);
    font-size: 22rpx;
    line-height: 1.5;
}
.rank-chain__item--now { background: var(--acc, #3d8c74); color: #fffdf7; }

/* ---------- 难度档选择 ---------- */
.warn-note {
    display: block;
    padding: 12rpx 16rpx;
    border-left: 4rpx solid #b4453c;
    border-radius: 0 8rpx 8rpx 0;
    background: rgba(180, 69, 60, 0.10);
    color: #8d3229;
    font-size: 22rpx;
    line-height: 1.65;
}
.diff-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10rpx;
}
.diff-chip {
    width: calc((100% - 20rpx) / 3);
    box-sizing: border-box;
    padding: 12rpx 8rpx;
    border: 1rpx solid rgba(0, 0, 0, 0.10);
    border-radius: 10rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rpx;
    background: rgba(255, 255, 255, 0.6);
}
.diff-chip__name { font-size: 26rpx; color: #2f3b35; font-weight: 600; }
.diff-chip__mult { font-size: 22rpx; color: #6f7b74; }
.diff-chip__need { font-size: 18rpx; color: #b4453c; }
.diff-chip--on { background: var(--acc, #3d8c74); border-color: var(--acc, #3d8c74); }
.diff-chip--on .diff-chip__name, .diff-chip--on .diff-chip__mult { color: #fffdf7; }
.diff-chip--lock { opacity: 0.55; }

@media (prefers-color-scheme: dark) {
    .hud__skill { color: #9aa79f; }
    .hud__quit { border-color: #3a4a42; color: #9aa79f; }
    .pr-hint__terms, .guide__no, .guide__note, .guide__inline { background: #26342d; }
    .pr-hint__terms .tiny, .guide__no { color: #cfd8cf; }
    .rank-card { border-color: #33403a; }
    .streak-card { border-color: #33403a; background: rgba(61, 140, 116, 0.14); }
    .streak-dot { border-color: #4a5a51; }
    .rank-chain__item { background: #2b3832; color: #cfd8cf; }
    .rank-chain__item--now { background: var(--acc, #3d8c74); color: #fffdf7; }
    .warn-note { background: rgba(180, 69, 60, 0.18); color: #f0b4ad; }
    .diff-chip { background: #26342d; border-color: #33403a; }
    .diff-chip__name { color: #e8eee9; }
    .diff-chip__mult { color: #9aa79f; }
    .diff-chip--on { background: var(--acc, #3d8c74); border-color: var(--acc, #3d8c74); }
    .diff-chip--on .diff-chip__name, .diff-chip--on .diff-chip__mult { color: #fffdf7; }
    .cell { border-color: #1e2723; }
    .cell--off, .cell--hidden { background: #2b3832; color: #9aa79f; }
    .trail-hint__name { color: #e8eee9; }
    .cell--path { background: rgba(122, 166, 196, 0.24); color: #cfe0ea; box-shadow: inset 0 0 0 3rpx rgba(122, 166, 196, 0.35); }
    .cell--pathgold { background: rgba(184, 137, 59, 0.3); color: #e8d3a6; box-shadow: inset 0 0 0 3rpx rgba(184, 137, 59, 0.45); }
    .cell--pathon { background: #4a6b86; color: #fffdf7; }
    .cell--pathgold.cell--pathon { background: #b8893b; color: #fffdf7; }
    .cell--cut { background: #e8eee9; color: #26342d; }
    .cell--pathfake { background: rgba(122, 166, 196, 0.08); color: rgba(207, 224, 234, 0.46); box-shadow: inset 0 0 0 3rpx rgba(122, 166, 196, 0.14); }
    .cell--ban { background: rgba(226, 75, 74, 0.14); color: rgba(240, 149, 149, 0.8); box-shadow: inset 0 0 0 3rpx rgba(226, 75, 74, 0.34); }
    .cell--open { background: #26342d; color: #e8eee9; }
    .cell--flag, .cell--sensed { background: #3a3a2c; color: #d8c79a; }
    .grid, .hud__track, .meter__track, .charge__track, .ring-area { background: #26342d; }
    .ring-orb { background: #1e2723; }
    .ring-orb--perfect { background: #3a3221; }
    .ring-orb--good { background: #22392f; }
    .ring-orb--miss { background: #3a2523; }
    .heart { color: #4a5a51; }
    .res-line { border-color: #33403a; }
    .cell--decoy { background: #4a5048; color: #d8ddd6; }
    .cell--card { background: #2f3d35; color: #cfd8cf; }
    .cell--flipped { background: #1e2723; color: #e8eee9; }
    .cell--matched { background: #2b3832; color: #9aa79f; }
    .lane-rule, .orbit, .scroll { background: #26342d; }
    .grid--lane { background: linear-gradient(180deg, #26342d, #1e2723); }
    .grid--lane .cell--fog { background: rgba(120, 140, 150, 0.1); }
    .grid--lane .cell--trail { background: #2b3832; }
    .grid--lane .cell--stone, .orbit__core, .orbit__lamp, .scroll__move, .scroll__key {
        background: #1e2723;
        color: #e8eee9;
    }
    .scroll__move--active, .orbit__lamp.lamp--current { background: var(--acc, #3d8c74); color: #fffdf7; }
}

/* ---------- 本门新法：熟练度阶段解锁的规则变化 ---------- */
.stage-rule {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 12rpx;
}

.stage-rule__text { line-height: 1.5; }

/* ---------- 三连 S 晋级：准备页常驻进度 ---------- */
.streak-card {
  padding: 16rpx 20rpx;
  border: 2rpx solid rgba(61, 140, 116, 0.28);
  border-radius: 14rpx;
  background: rgba(61, 140, 116, 0.06);
}

.streak-dots { display: flex; gap: 12rpx; }

.streak-dot {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #9fb2a8;
  border-radius: 50%;
  background: transparent;
  box-sizing: border-box;
}

.streak-dot--on { background: var(--acc, #3d8c74); border-color: var(--acc, #3d8c74); }

/* ---------- 三套经典玩法的盘面：矮格 / 灵纹 / 落石 / 方向键 ---------- */
/* 6 列以上、8 行的盘面要把格子压矮，否则小屏装不下；只在 vm.extras.compact 时启用。 */
.grid--compact .cell {
  height: 76rpx;
  font-size: 24rpx;
  border-width: 3rpx;
  border-radius: 10rpx;
}

.cell--chip { font-size: 34rpx; letter-spacing: 0; }
.cell--gone, .cell--void { background: rgba(120, 130, 120, 0.08); border-color: transparent; }
.cell--sel { box-shadow: inset 0 0 0 5rpx #fffdf7, 0 0 18rpx rgba(255, 253, 247, 0.85); }
.cell--hintpair { animation: litPop 0.5s ease-out infinite alternate; }
.cell--set { opacity: 0.86; }
.cell--live { box-shadow: 0 0 16rpx rgba(255, 253, 247, 0.8); }

.pad {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.pad__key {
  flex: 1;
  min-height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  color: var(--ink, #2f6b5b);
  background: var(--soft, #efe9db);
  border: 3rpx solid var(--frame, #fffdf7);
  border-radius: 14rpx;
}

@media (prefers-color-scheme: dark) {
  .cell--gone, .cell--void { background: rgba(120, 140, 150, 0.12); }
  .pad__key { background: #26342d; border-color: #33403a; color: #e8eee9; }
}
