/* 参悟页根容器挂 .pg--imm，与四个主页面共用 styles/immortal.wxss 的色板映射，
   --c-* 不用在本文件重抄一遍。本文件只补「这一页有、别处没有」的东西：
   功法头、局内 HUD、判定横幅、难度档、结算行。

   边界只有一条：**盘面是纸，其余是墨。**
   可以摸、可以划的那块（.grid / .cell / .ring-area / .orbit / .scroll / .pad）取
   minigames/theme.js 注入的 --soft / --ink / --bg / --frame，刻意保持浅色纸面，
   格子里的字才有落处；页面、HUD、横幅、弹层一律走 --c-imm-*。
   本页恒定深色，不写系统明暗媒体查询：系统切深色时纸与墨都不变。 */

/* 灵纹牌上的八种图案：一张内联的 sprite + 切位，单独放一个文件，
   免得这三十来 KB 的 base64 混在页面样式里，改起来看不清别的规则。 */
@import "../../styles/crest.wxss";
/* 卦象 / 器物一族的图案：另一张 sprite，同样单独放文件，免得 base64 混进页面规则。 */
@import "../../styles/emblems.wxss";

/* 盘面材质（--jade / --jade-paper / --jade-dim / --jade-ink / --gold-line）定义在
   styles/tokens.wxss：19 门共用一副玉牌，不随功法变；台色才由 --well 按族注入。
   牌与牌之间的沟槽不单独设色，直接取台色（--well），所以换族时沟槽自动跟着变。 */

/* 功法头不做盒子：标题直接落在墨底上，只用一条发丝线收口。
   原先是一张深卡叠在墨底上，两层深色几乎同值，看不出层次还多一圈圆角。 */
.pr-head {
    padding: var(--sp-6) var(--sp-2) var(--sp-6);
    border: 0;
    border-bottom: 1rpx solid var(--c-imm-line-soft);
    border-radius: 0;
    background: transparent;
    box-shadow: none;
}

/* 准备页顶部只报「这一局玩什么」：页面名已经写在导航栏（参悟），卡片里再写一遍
   「参 悟」就是同一行字出现两次。 */
.pr-head-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
}

/* 小印与「黄阶 ×1.00」分两处放：印在标题行、倍率在熟练度那一行。
   星级与一脉属于图鉴（功法页有谱系），不占开局前这一屏。 */
/* 选两个类名叠起来：.rank-badge 的基础尺寸在本文件更靠后定义，
   单类选择器会被它盖回去，小印就又变回 46rpx。 */
.rank-badge.rank-badge--sm {
    width: 38rpx;
    height: 38rpx;
    font-size: 22rpx;
}

.pr-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
}

/* 功法名是全页唯一的大字：不写手写空格、不挂衬线，层级交给字号与字重。 */
.pr-title {
    display: block;
    min-width: 0;
    margin-top: 18rpx;
    color: var(--c-imm-text);
    font-family: inherit;
}

/* 功法印记：一枚金线方印，唯一装饰，不做浅色块也不铺主题色。 */
.pr-seal {
    box-sizing: border-box;
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 88rpx;
    height: 88rpx;
    margin-top: 14rpx;
    border: 1rpx solid var(--c-imm-gold-dim);
    border-radius: var(--r-sm);
    transform: rotate(-6deg);
}

.pr-seal__glyph {
    color: var(--c-imm-gold);
    font-size: 42rpx;
    line-height: 1;
}

.pr-desc {
    display: block;
    margin-top: 12rpx;
    color: var(--c-imm-text-2);
    font-size: 25rpx;
    line-height: 1.7;
}

/* 换门：一行靠右的小字链，与标题抢位置的入口越少越好。 */
.pr-links {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--sp-3);
}

/* 「这一门」展开后：风味另起一段用金色细体，像书页上的批注。 */
.pr-flavor {
    display: block;
    margin-top: var(--sp-4);
    padding-left: var(--sp-4);
    border-left: 2rpx solid var(--c-imm-gold-dim);
    color: var(--c-imm-gold-dim);
    font-size: var(--fs-caption);
    line-height: var(--lh-body);
}

/* 练成之后两行：标签弱、数值亮，与功法页图鉴同一套读法。 */
.pr-gain {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-top: var(--sp-3);
}

.pr-gain__v {
    flex: 1 1 0;
    min-width: 0;
    text-align: right;
    color: var(--c-imm-gold);
    font-size: var(--fs-body-sm);
    word-break: break-all;
}

.pr-prof {
    margin-top: 28rpx;
}

.pr-tiny {
    color: var(--c-imm-text-3);
}

/* 下一段能拿到什么：跟进度条同一块，比正文再轻一档。 */
.pr-tier-next {
    display: block;
    margin-top: var(--sp-2);
    color: var(--c-imm-text-2);
}

/* 吸底条：与主页面同一条发丝线收口，不加重阴影（墨底上阴影看不出来，只会脏边）。 */
.pg .sticky-bar {
    border-top: 1rpx solid var(--c-imm-line-soft);
    box-shadow: none;
}

/* 终局底栏（留在本页之后）：左边两个去处是「再看一眼 / 走人」，右边金按钮是再来一局。
   两条文字链不换行、不被按钮挤断，剩下的宽度全给金按钮。 */
.pg .sticky-bar--done {
    justify-content: space-between;
    gap: var(--sp-6);
}

.sticky-bar--done .text-link {
    flex: 0 0 auto;
    white-space: nowrap;
}

/* 开局底栏里的代价行：耗气 / 布阵灵石。它是底栏唯一的读数，
   所以不换行、不省略——「灵力 −17」被截成「灵力 −1」比不写还糟。 */
.start-cost {
    flex: 1 1 auto;
    min-width: 0;
    text-align: right;
    color: var(--c-imm-text-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.start-cost--lack {
    color: var(--c-imm-danger);
}

/* 付不起时金按钮照样可点：点它不是开局，而是弹「差多少、去哪儿补」。
   做成死按钮的话，玩家只会以为页面卡住了。 */
.pg .btn--off {
    background: transparent;
    border: 1rpx solid var(--c-imm-gold-dim);
    color: var(--c-imm-gold-dim);
    box-shadow: none;
}

/* ---------- 局内 HUD ---------- */
/* 局内不再套一层卡：准备页是「一张卡接着一张卡」，进了局就只剩盘面与读数。
   卡片边框会跟盘面自己的墨框抢层次，两层框叠在一起最显廉价。 */
.pr-play {
    padding: 6rpx 0 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
}

/* HUD 与盘面之间一条发丝线收口：读数区与操作区从这里分开。 */
.hud {
    padding-bottom: 18rpx;
    border-bottom: 1rpx solid var(--c-imm-line-soft);
}

/* 局内不再显示功法头卡，靠这一行小字交代「在练哪门、什么难度」 */
.hud__top {
    align-items: flex-start;
}

.hud__id {
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.hud__skill {
    color: var(--c-imm-text-2);
    font-size: 22rpx;
    letter-spacing: 2rpx;
}

.hud__time {
    margin-top: 2rpx;
    color: var(--c-imm-text);
    /* 计时是这一屏最该有「器物感」的数字：衬线 + 等宽，读起来像香炷而不是标题。 */
    font-family: "Songti SC", "STSong", serif;
    font-size: 44rpx;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
    letter-spacing: 2rpx;
}

.hud__right {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: 12rpx;
    padding-top: 4rpx;
}

/* 收功：留在屏幕上方，离拇指热区远一点，误触代价太大 */
.hud__quit {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 56rpx;
    padding: 0 18rpx;
    border: 1rpx solid var(--c-imm-line);
    border-radius: 999rpx;
    background: rgba(236, 229, 216, 0.04);
    color: var(--c-imm-text-3);
    font-size: 22rpx;
    line-height: 1;
}

.hud__goal {
    line-height: 1.5;
}

.pr-hint {
    margin-top: 16rpx;
    padding-left: 16rpx;
    border-left: 2rpx solid var(--c-imm-gold-dim);
}

.pr-hint .tiny {
    line-height: 1.55;
}

/* 局内常驻一行术语速记：玩到一半看不懂符号时不用退出查说明 */
.pr-hint__terms {
    margin-top: 10rpx;
    padding: 10rpx 14rpx;
    border-left: 4rpx solid var(--c-imm-gold-dim);
    border-radius: 0 var(--r-xs) var(--r-xs) 0;
    background: rgba(207, 174, 109, 0.06);
}

.pr-hint__terms .tiny {
    color: var(--c-imm-text-2);
    line-height: 1.5;
}

/* ---------- 连 S 倍率：准备页只剩一行 ---------- */
/* 十个小圆点看层数，句子只写「下一局 S 值多少点」。点压到 16rpx 才放得进一行。 */
.combo-line {
    align-items: center;
    gap: 6rpx;
    flex-wrap: wrap;
}

.combo-chip {
    color: var(--c-imm-gold);
    font-size: 26rpx;
    font-weight: 600;
}

/* 评级徽章：只画一个字母 C，玩家会当成按钮去找它点。
   加「评级」二字并改成 pill，代价是两个多字的宽度，换的是不再猜。 */
.grade-chip {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-width: 52rpx;
    height: 44rpx;
    padding: 0 12rpx;
    border-radius: 22rpx;
    color: var(--c-imm-text);
    font-size: 28rpx;
    font-weight: 700;
}

.grade-chip__label {
    margin-right: 6rpx;
    font-size: 18rpx;
    font-weight: 500;
    opacity: 0.72;
}

/* 进度条：轨道吃进内影，填充带一层白光——深底上才不会看成两块纯色积木。 */
.hud__track {
    overflow: hidden;
    height: 10rpx;
    margin-top: 16rpx;
    border-radius: 10rpx;
    background: var(--c-imm-track);
    box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.5);
}

.hud__fill {
    position: relative;
    height: 100%;
    border-radius: 10rpx;
    box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.32), 0 0 12rpx rgba(255, 255, 255, 0.18);
    transition: width 0.25s ease;
}

/* 填充末端一颗小白点：进度条在走的时候，眼睛需要一个「头」。 */
.hud__fill::after {
    content: "";
    position: absolute;
    top: 50%;
    right: 0;
    width: 8rpx;
    height: 8rpx;
    margin-top: -4rpx;
    border-radius: 50%;
    background: #fffdf7;
    box-shadow: 0 0 10rpx rgba(255, 253, 247, 0.9);
}

.hearts {
    display: flex;
    align-items: center;
}

.heart {
    margin-right: 8rpx;
    color: var(--c-imm-line);
    font-size: 28rpx;
}

.heart--on {
    color: var(--c-imm-gold);
    text-shadow: 0 0 12rpx rgba(207, 174, 109, 0.55);
}

.hearts .tiny {
    margin-left: 8rpx;
}

.meter__track {
    overflow: hidden;
    height: 10rpx;
    margin-top: 6rpx;
    border-radius: 8rpx;
    background: var(--c-imm-track);
    box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.5);
}

.meter__fill {
    height: 100%;
    border-radius: 8rpx;
    box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.28);
    transition: width 0.2s ease;
}

/* 判定横幅：一条上下金线的口播，不是卡也不是按钮 */
.banner {
    display: block;
    padding: 12rpx 0;
    border-top: 1rpx solid var(--c-imm-gold-dim);
    border-bottom: 1rpx solid var(--c-imm-gold-dim);
    color: var(--c-imm-gold);
    text-align: center;
    font-size: 30rpx;
    letter-spacing: 4rpx;
    animation: bannerIn 0.4s ease-out;
}

/* ---------- 舞台与浮字 ---------- */
.stage {
    position: relative;
    margin-top: 8rpx;
}

/* 盘外一圈本族柔光：让盘面像被一盏灯从底下托着，而不是贴在一块黑纸上。
   只挂在 .stage 的伪元素上，盘面本身的层叠一分不动。 */
.stage::before {
    content: "";
    position: absolute;
    top: 4%;
    right: -6%;
    bottom: 4%;
    left: -6%;
    z-index: 0;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--glow, #6FD4E8), rgba(0, 0, 0, 0) 72%);
    opacity: 0.12;
    pointer-events: none;
}

.fx {
    position: absolute;
    top: 34%;
    left: 0;
    right: 0;
    z-index: 5;
    text-align: center;
    font-size: 34rpx;
    font-weight: 700;
    pointer-events: none;
}

.fx--good { color: var(--c-imm-jade); }
.fx--bad { color: var(--c-imm-danger); }
.fx--gold { color: var(--c-imm-gold); }
.fx--k0, .fx--k1 { animation: fxFloat 0.9s ease-out forwards; }

/* ---------- 蓄力停区 ---------- */
.charge {
    margin-top: 24rpx;
}

.charge__track {
    position: relative;
    overflow: hidden;
    height: 64rpx;
    border-radius: 14rpx;
    background: var(--soft, #e9e3d4);
    /* 一条凹进纸面的槽：内影从上方压下来，光标才像在槽里跑。 */
    box-shadow: inset 0 4rpx 10rpx rgba(74, 58, 30, 0.22), inset 0 -2rpx 0 rgba(255, 255, 255, 0.6);
}

/* 朱线区间：底色一层金，内侧再压一圈朱红，两条线就是「停在这里」的边界。 */
.charge__zone {
    position: absolute;
    top: 0;
    bottom: 0;
    background: linear-gradient(180deg, rgba(184, 137, 59, 0.5), rgba(184, 137, 59, 0.32));
    border-left: 5rpx solid #b4453c;
    border-right: 5rpx solid #b4453c;
    box-shadow: inset 0 0 14rpx rgba(180, 69, 60, 0.35);
}

.charge__cursor {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 10rpx;
    background: linear-gradient(180deg, #7fd0bc, var(--acc, #2f6b5b));
    /* 光标带一圈辉光：64rpx 高的槽里，一道纯色竖线很容易看丢。 */
    box-shadow: 0 0 14rpx rgba(47, 107, 91, 0.75), 0 0 4rpx rgba(255, 255, 255, 0.8);
    transform: translateX(-5rpx);
}

/* ---------- 节律判定盘 ---------- */
.ring-area {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 440rpx;
    margin-top: 20rpx;
    border-radius: 20rpx;
    background-color: var(--well, #0b2331);
    background-image: radial-gradient(120% 80% at 50% -10%, rgba(255, 243, 214, 0.14), rgba(255, 243, 214, 0) 60%);
    box-shadow: 0 0 0 1rpx rgba(207, 174, 109, 0.36), 0 18rpx 40rpx rgba(0, 0, 0, 0.45),
        inset 0 8rpx 24rpx rgba(0, 0, 0, 0.44);
}

.ring-judge {
    position: absolute;
    box-sizing: border-box;
    width: 200rpx;
    height: 200rpx;
    border: 6rpx solid #b4453c;
    border-radius: 50%;
    opacity: 0.65;
    /* 判定圈之外再散一圈朱气：珠子压上来时，边界比一根线更清楚。 */
    box-shadow: 0 0 0 10rpx rgba(180, 69, 60, 0.1), inset 0 0 22rpx rgba(180, 69, 60, 0.16);
}

.ring-orb {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 200rpx;
    height: 200rpx;
    border: 8rpx solid var(--acc, #3d8c74);
    border-radius: 50%;
    background: var(--bg, #efe9db);
    font-family: serif;
    font-size: 56rpx;
    box-shadow: 0 12rpx 26rpx rgba(0, 0, 0, 0.18), inset 0 4rpx 0 rgba(255, 255, 255, 0.55);
}

.ring-orb--perfect { background: #f6e6c8; }
.ring-orb--good { background: #e2efe6; }
.ring-orb--miss { background: #f5dedb; }

.ring-tip {
    position: absolute;
    bottom: 24rpx;
    color: var(--ink, #5d6358);
    font-size: 24rpx;
}

/* ---------- 通用格子 ----------
   盘面是一方「玉局」：深墨玉台（--well，按功法所属那一族取色）托一片暖白玉牌。
   台与牌的明度差六七倍，牌才立得起来——之前是纸白底上摆纸白牌，只靠一圈白描边分格，
   远看就是一整块发光的白板。
   质感只用四件事凑：牌面顶高光、牌底一道赭色厚度、牌下一条落影、牌与牌之间的沟槽。
   沟槽的做法是把格子的边框取成台色：格子仍按百分比铺满，牌面内缩 4rpx，
   于是相邻两牌之间自然空出 8rpx 的台色，不必去算 calc() 宽度。 */
.grid {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    margin-top: 22rpx;
    padding: 4rpx;
    border-radius: 22rpx;
    /* 不裁切：连连看的连线要从盘外绕过去，边上的灵纹「从上边绕过」的那一段
       正好落在盘面外半格。裁掉的话，玩家只看到两条断在盘边的竖线。
       圆角靠 .grid::after 自己的 border-radius 撑住，不依赖这一层裁切。 */
    overflow: visible;
    /* 台面：墨玉底 + 上缘暖光 + 下缘暗角。全部写在 .grid 自己的背景上，
       不另起一层伪元素——伪元素盖在格子上，整盘会被压成一片灰。 */
    background-color: var(--well, #0b2331);
    background-image:
        radial-gradient(120% 76% at 50% -18%, rgba(255, 243, 214, 0.16), rgba(255, 243, 214, 0) 62%),
        radial-gradient(135% 96% at 50% 120%, rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0) 64%);
    /* 一道 1rpx 金线压在最外，外面再裹一圈墨：盘面像嵌进墨里的玉盘，不是浮着的白块。 */
    box-shadow:
        0 0 0 1rpx rgba(207, 174, 109, 0.5),
        0 0 0 8rpx rgba(5, 10, 9, 0.55),
        0 26rpx 56rpx rgba(0, 0, 0, 0.55),
        inset 0 10rpx 26rpx rgba(0, 0, 0, 0.5),
        inset 0 -2rpx 0 rgba(255, 246, 220, 0.08);
    animation: boardIn 300ms ease-out both;
}

/* 开局那一沉：只动位移，不动透明度。
   透明度从 0 起跳会有一个真实风险——动画被系统「减少动效」关掉、或没跑起来时，
   整盘就停在 opacity:0，玩家看到的是一块空台。位移没跑起来只是「没动」，盘还在。 */
@keyframes boardIn {
    from { transform: translateY(14rpx); }
    to { transform: translateY(0); }
}

/* 盘沿内侧：一道极淡的金线 + 四角回纹。
   双线是「装裱」的暗示，单线只是边框；四角各压一枚 L 形小回纹，
   是整盘唯一一处「工艺感」的装饰，花四行渐变换掉纯矩形。 */
.grid::after {
    content: "";
    position: absolute;
    top: 9rpx;
    right: 9rpx;
    bottom: 9rpx;
    left: 9rpx;
    z-index: 2;
    border: 1rpx solid rgba(207, 174, 109, 0.2);
    border-radius: 16rpx;
    pointer-events: none;
    background:
        linear-gradient(90deg, rgba(207, 174, 109, 0.5) 0, rgba(207, 174, 109, 0.5) 26rpx, rgba(207, 174, 109, 0) 26rpx) top left / 26rpx 2rpx no-repeat,
        linear-gradient(180deg, rgba(207, 174, 109, 0.5) 0, rgba(207, 174, 109, 0.5) 26rpx, rgba(207, 174, 109, 0) 26rpx) top left / 2rpx 26rpx no-repeat,
        linear-gradient(270deg, rgba(207, 174, 109, 0.5) 0, rgba(207, 174, 109, 0.5) 26rpx, rgba(207, 174, 109, 0) 26rpx) top right / 26rpx 2rpx no-repeat,
        linear-gradient(180deg, rgba(207, 174, 109, 0.5) 0, rgba(207, 174, 109, 0.5) 26rpx, rgba(207, 174, 109, 0) 26rpx) top right / 2rpx 26rpx no-repeat,
        linear-gradient(90deg, rgba(207, 174, 109, 0.5) 0, rgba(207, 174, 109, 0.5) 26rpx, rgba(207, 174, 109, 0) 26rpx) bottom left / 26rpx 2rpx no-repeat,
        linear-gradient(0deg, rgba(207, 174, 109, 0.5) 0, rgba(207, 174, 109, 0.5) 26rpx, rgba(207, 174, 109, 0) 26rpx) bottom left / 2rpx 26rpx no-repeat,
        linear-gradient(270deg, rgba(207, 174, 109, 0.5) 0, rgba(207, 174, 109, 0.5) 26rpx, rgba(207, 174, 109, 0) 26rpx) bottom right / 26rpx 2rpx no-repeat,
        linear-gradient(0deg, rgba(207, 174, 109, 0.5) 0, rgba(207, 174, 109, 0.5) 26rpx, rgba(207, 174, 109, 0) 26rpx) bottom right / 2rpx 26rpx no-repeat;
}

.cell {
    box-sizing: border-box;
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    /* 边框 = 沟槽，必须跟台面同色；任何状态色都不许改 border-color。 */
    border: 4rpx solid var(--well, #0b2331);
    border-radius: 15rpx;
    background-color: var(--jade, #fdf7e6);
    /* 牌面：顶部一片近白的受光斜落到下缘的赭色，中间不出现分界线。 */
    background-image:
        radial-gradient(124% 96% at 50% -22%, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0) 58%),
        linear-gradient(180deg, rgba(255, 253, 244, 0) 46%, rgba(176, 142, 90, 0.2));
    color: var(--jade-ink, #3c382a);
    /* 字是盘面的内容：3 列盘给到 34rpx，4 / 6 / 9 列再按档降，别让数字缩成注解。 */
    font-size: 34rpx;
    font-weight: 600;
    /* 数字每局都在跳，等宽数字才不会让盘面跟着左右抖。 */
    font-variant-numeric: tabular-nums;
    box-shadow:
        0 4rpx 0 rgba(0, 0, 0, 0.34),
        0 8rpx 14rpx rgba(0, 0, 0, 0.3),
        inset 0 2rpx 0 rgba(255, 255, 255, 0.95),
        inset 0 -7rpx 10rpx rgba(146, 112, 62, 0.22),
        inset 0 0 0 1rpx rgba(164, 134, 86, 0.24);
    transition: background-color 0.18s ease, color 0.18s ease, box-shadow 0.18s ease, transform 0.1s ease;
}

/* 按下去的反馈只做缩放：状态色归状态类管，手感归这一条，两者不打架。
   盘上格子是这一屏唯一的输入面，没有按压反馈时玩家会怀疑「是不是没点上」。 */
.cell--press {
    transform: scale(0.962);
}

/* ---------- 牌面角花：玉牌四角的一小段金线 ----------
   数字盘与形状盘没有可替换的图案（数字是信息、箭头是方向），它们的「不简陋」
   靠这一层：四角各一枚 8rpx 的金线角花。密盘（6 列以上）不挂——格子只有 100rpx 宽，
   四角角花会跟数字抢注意力，反而显得脏。
   用伪元素而不是改 .cell 的 background-image：很多状态类（.cell--lit / --dead）
   会用 background 简写清掉图片，写进底盘会被状态色擦掉。 */
.cell::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background:
        linear-gradient(135deg, var(--gold-line, rgba(207, 174, 109, 0.55)) 0, var(--gold-line, rgba(207, 174, 109, 0.55)) 2rpx, rgba(207, 174, 109, 0) 2rpx) top left / 14rpx 14rpx no-repeat,
        linear-gradient(225deg, var(--gold-line, rgba(207, 174, 109, 0.55)) 0, var(--gold-line, rgba(207, 174, 109, 0.55)) 2rpx, rgba(207, 174, 109, 0) 2rpx) top right / 14rpx 14rpx no-repeat,
        linear-gradient(45deg, var(--gold-line, rgba(207, 174, 109, 0.55)) 0, var(--gold-line, rgba(207, 174, 109, 0.55)) 2rpx, rgba(207, 174, 109, 0) 2rpx) bottom left / 14rpx 14rpx no-repeat,
        linear-gradient(315deg, var(--gold-line, rgba(207, 174, 109, 0.55)) 0, var(--gold-line, rgba(207, 174, 109, 0.55)) 2rpx, rgba(207, 174, 109, 0) 2rpx) bottom right / 14rpx 14rpx no-repeat;
}

/* 命中一笔一次性金圈：只动 transform / opacity，不是常驻循环，也不占粒子预算。
   类挂上去那一刻播一次，挂在 --ok / --gold / --hint 上覆盖「对了 / 收了 / 被提示」
   三种最常见的判定；已终局的盘面不会再挂这些类。 */
@keyframes cellEtch {
    0% { opacity: 0.9; transform: scale(0.86); }
    100% { opacity: 0; transform: scale(1.16); }
}

.cell--ok::after,
.cell--gold::after,
.cell--hint::after,
.cell--hintpair::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 3rpx solid rgba(255, 240, 190, 0.9);
    border-radius: inherit;
    pointer-events: none;
    animation: cellEtch 420ms ease-out 1 forwards;
}

.grid--c3 .cell { width: 33.3333%; height: 156rpx; }
.grid--c4 .cell { width: 25%; height: 128rpx; font-size: 26rpx; }
.grid--c6 .cell { width: 16.6666%; height: 104rpx; font-size: 26rpx; border-radius: 12rpx; }
/* 七列只给推石入位的高档（内盘 5×5）。牌面、台面、内缩与六列同一套，
   只把每格收窄一格：14.28% × 七百多 rpx ≈ 100rpx，石箱图案仍然认得出。 */
.grid--c7 .cell { width: 14.2857%; height: 96rpx; font-size: 24rpx; border-radius: 12rpx; }
/* 八列只给落石垒基：六列时一块「长石」横跨三分之二个盘子，看着就是一块巨石压在窄巷里。
   八列把每格收到 12.5%（≈ 84rpx），块小了、横向也才有转身的地方。 */
.grid--c8 .cell { width: 12.5%; height: 84rpx; font-size: 22rpx; border-radius: 10rpx; }

/* 密盘（6 列以上）撤掉角花：格宽只剩百来 rpx，四角金线会跟数字抢注意力。 */
.grid--c6 .cell::before,
.grid--c7 .cell::before,
.grid--c8 .cell::before,
.grid--c9 .cell::before,
.grid--compact .cell::before,
.grid--lane .cell::before { display: none; }

/* 亮起 = 这一手要动的那一格：主题色实底 + 一道旧金细框 + 本族辉光。
   在深玉台上，「亮没亮」比「是哪个颜色」更早被看见，所以金框与外光两道一起上。 */
.cell--lit {
    background: var(--acc, #2a87ab);
    background-image: radial-gradient(124% 120% at 50% -20%, rgba(255, 255, 255, 0.6), rgba(255, 255, 255, 0) 64%);
    color: #fffdf7;
    box-shadow: 0 0 0 2rpx var(--gold-line, rgba(207, 174, 109, 0.55)), 0 6rpx 16rpx rgba(0, 0, 0, 0.42),
        0 0 24rpx var(--glow, #6FD4E8), inset 0 2rpx 0 rgba(255, 255, 255, 0.42);
    animation: litPop 0.35s ease-out;
}
/* 暗格：不是「浅一点的牌」，是把牌压成一块没上釉的坯——无高光、无镀边、字也退成灰。 */
.cell--off {
    background-color: var(--jade-dim, #b3ab96);
    background-image: none;
    color: #6b6555;
    box-shadow: inset 0 2rpx 6rpx rgba(90, 74, 44, 0.3);
    transition: background 0.25s ease, color 0.25s ease;
}
.cell--ok {
    background: var(--acc, #b8893b);
    background-image: radial-gradient(124% 120% at 50% -20%, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0) 62%);
    color: #fffdf7;
    box-shadow: 0 0 0 2rpx var(--gold-line, rgba(207, 174, 109, 0.55)), 0 4rpx 12rpx rgba(0, 0, 0, 0.36),
        inset 0 2rpx 0 rgba(255, 255, 255, 0.34);
}
.cell--bad { background: #b4453c; color: #fffdf7; animation: badShake 0.22s ease-out; box-shadow: 0 0 22rpx rgba(180, 69, 60, 0.5), inset 0 0 0 3rpx rgba(255, 236, 228, 0.28); }
.cell--hidden { background-color: var(--jade-dim, #b3ab96); background-image: none; color: #6b6555; }
/* 翻开 = 凹下去。未翻开的格子是凸起的玉牌，翻开的那一格压低并吃进内影，
   于是「哪些还没动过」不用记规则也能看出来——这是实体棋盘最好用的一条暗示。
   底色用比玉牌暖一档的纸（不跟台色同色）：同色只靠阴影分档，小屏上几乎看不出来。 */
.cell--open {
    background-color: var(--jade-paper, #e6d3ac);
    background-image: linear-gradient(180deg, rgba(120, 88, 46, 0.24), rgba(120, 88, 46, 0) 60%);
    color: var(--jade-ink, #3c382a);
    font-weight: 700;
    box-shadow: inset 0 6rpx 12rpx rgba(78, 58, 30, 0.4), inset 0 -2rpx 0 rgba(255, 255, 255, 0.42);
}
/* 探禁：翻开格上的数字按大小分色（1 / 2 / 3+），一眼扫得出「1 的边界在哪」。
   这是经典扫雷里唯一值得照搬的辅助；把数字画成符文反而读不出来。 */
.cell--open.cell--t1 { color: #2c6a58; }
.cell--open.cell--t2 { color: #a83b32; }
.cell--open.cell--t3 { color: #94661a; }
.cell--flag { background-color: #f6e7bf; background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.7), rgba(196, 155, 74, 0.3)); color: #8a6524; box-shadow: inset 0 0 0 3rpx rgba(162, 118, 45, 0.5), 0 3rpx 8rpx rgba(0, 0, 0, 0.3); }
.cell--mine { background: #b4453c; color: #fffdf7; animation: badShake 0.3s ease-out; box-shadow: 0 0 26rpx rgba(180, 69, 60, 0.55), inset 0 0 0 3rpx rgba(255, 214, 206, 0.5); }
.cell--hint { background: #b8893b; color: #fffdf7; animation: litPop 0.5s ease-out infinite alternate; box-shadow: 0 0 24rpx rgba(184, 137, 59, 0.5), inset 0 2rpx 0 rgba(255, 255, 255, 0.3); }
.cell--trail { background-color: #e6dcc2; background-image: none; color: #4c4736; }
.cell--gold {
    background: #b8893b;
    background-image: radial-gradient(124% 120% at 50% -20%, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0) 62%);
    color: #fffdf7;
    box-shadow: 0 0 0 2rpx rgba(255, 246, 214, 0.7), 0 0 24rpx rgba(207, 174, 109, 0.55),
        inset 0 2rpx 0 rgba(255, 255, 255, 0.34);
}
.cell--hot { box-shadow: inset 0 0 0 6rpx rgba(255, 243, 205, 0.6), 0 0 26rpx rgba(255, 236, 170, 0.42); }
/* 死门：暗红底 + 斜纹，和米色的暗格拉开一整档；斜纹给它「栅栏」的意思，不只是块红。
   亮着的死门提一档亮度，轮廓不变。 */
.cell--dead {
    background: #8d3b32;
    /* 斜纹单独盖一层：`background` 简写会清掉图片，所以图片必须写在它后面。 */
    background-image: repeating-linear-gradient(45deg, rgba(92, 35, 29, 0.55) 0, rgba(92, 35, 29, 0.55) 5rpx, rgba(92, 35, 29, 0) 5rpx, rgba(92, 35, 29, 0) 12rpx);
    color: #fff3e6;
    box-shadow: inset 0 0 0 4rpx #5c231d, inset 0 6rpx 14rpx rgba(0, 0, 0, 0.24);
}
.cell--dead-lit { background-color: #a84a3e; }
/* 破阵那一拍：整盘一次性泛金 + 金描边。换盘时 paint() 重置 cls，这一层自然收掉，
   不做常驻呼吸；动画只跑一次，也不占「常驻循环动画」的预算。 */
.cell--solved {
    box-shadow: inset 0 0 0 4rpx var(--c-imm-gold, #cfae6d);
    animation: solvedGlow 0.6s ease-out 1;
}

@keyframes solvedGlow {
    0% { box-shadow: inset 0 0 0 6rpx #cfae6d, 0 0 30rpx rgba(207, 174, 109, 0.7); }
    100% { box-shadow: inset 0 0 0 2rpx rgba(207, 174, 109, 0.35); }
}

/* ---------- 循光斩桩：刀路（划） ---------- */
.trail-hint {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    /* 大圆满会同时挂两条规则，右侧那行容易顶到边；允许换行，宁可排两行也别溢出。 */
    flex-wrap: wrap;
    margin-top: 20rpx;
}

.trail-hint__name {
    font-size: 32rpx;
    font-weight: 700;
    letter-spacing: 2rpx;
}

/* 刀路：已掠过的桩留一道浅光痕，光头最亮；金色是重斩长招。 */
.cell--path {
    background-color: #dfd0ae;
    background-image: none;
    color: var(--ink, #254253);
    box-shadow: inset 0 0 0 3rpx var(--acc, #4a6b86), inset 0 4rpx 8rpx rgba(78, 58, 30, 0.24);
}

.cell--pathgold {
    background-color: #ecd9a9;
    background-image: none;
    color: #7a5a1e;
    box-shadow: inset 0 0 0 3rpx rgba(184, 137, 59, 0.8), inset 0 4rpx 8rpx rgba(78, 58, 30, 0.2);
}

.cell--pathon {
    background: var(--acc, #4a6b86);
    background-image: radial-gradient(124% 120% at 50% -20%, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0) 62%);
    color: #fffdf7;
    box-shadow: 0 0 0 2rpx var(--gold-line, rgba(207, 174, 109, 0.55)), 0 0 22rpx var(--glow, #6FD4E8);
    transform: scale(1.04);
}

.cell--pathgold.cell--pathon {
    background: #b8893b;
    box-shadow: 0 0 22rpx rgba(184, 137, 59, 0.65);
}

/* 双锋的虚招：同样有箭头与靶心，但整条路压暗一档。
   真假不靠猜——真招的靶心在呼吸（见 .cell__end--live），虚招是静止的。 */
.cell--pathfake {
    background: rgba(74, 107, 134, 0.1);
    color: rgba(74, 107, 134, 0.42);
    box-shadow: inset 0 0 0 3rpx rgba(74, 107, 134, 0.16);
}

/* 禁桩：红叉一目了然，划过即断势。叉用 currentColor，深色舞台跟着走。 */
.cell--ban {
    background: rgba(180, 69, 60, 0.1);
    color: rgba(180, 69, 60, 0.72);
    box-shadow: inset 0 0 0 3rpx rgba(180, 69, 60, 0.3);
}

.cell--ban::before,
.cell--ban::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 54rpx;
    height: 6rpx;
    margin-left: -27rpx;
    margin-top: -3rpx;
    border-radius: 3rpx;
    background: currentColor;
}

.cell--ban::before { transform: rotate(45deg); }
.cell--ban::after { transform: rotate(-45deg); }

.cell--cut {
    background: #fffdf7;
    color: var(--acc, #4a6b86);
    animation: hitPop 0.18s ease-out;
}

/* 刀路方向：纯 CSS 三角 + 短杆，0° 朝上，inline transform 按相邻桩方向旋转。
   不用汉字、不用 unicode 字形，颜色继承格子 currentColor，浅色 / 深色舞台都清楚。 */
.cell__arrow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 56rpx;
    height: 56rpx;
    pointer-events: none;
}

.cell__arrow-head {
    position: absolute;
    left: 50%;
    top: 2rpx;
    width: 0;
    height: 0;
    margin-left: -13rpx;
    border-left: 13rpx solid transparent;
    border-right: 13rpx solid transparent;
    border-bottom: 20rpx solid currentColor;
}

.cell__arrow-shaft {
    position: absolute;
    left: 50%;
    top: 20rpx;
    width: 6rpx;
    height: 30rpx;
    margin-left: -3rpx;
    border-radius: 3rpx;
    background: currentColor;
}

/* 收势桩：双环靶心，一眼看出「划到这里为止」 */
.cell__end {
    position: absolute;
    left: 50%;
    top: 50%;
    box-sizing: border-box;
    width: 34rpx;
    height: 34rpx;
    border: 5rpx solid currentColor;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
}

.cell__end::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10rpx;
    height: 10rpx;
    border-radius: 50%;
    background: currentColor;
    transform: translate(-50%, -50%);
}

/* 双锋：真招靶心呼吸，虚招静止。只动 opacity 与 transform，守住动效预算。 */
.cell__end--live {
    animation: endBreath 1.1s ease-in-out infinite;
}

@keyframes endBreath {
    0%, 100% { opacity: 0.4; transform: translate(-50%, -50%) scale(0.88); }
    50% { opacity: 1; transform: translate(-50%, -50%) scale(1.14); }
}

/* 斩中时按刀招角度扫过盘面的一道白光：外层定位旋转，内层做扫光动画 */
.grid__slash {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 150%;
    height: 14rpx;
    z-index: 2;
    pointer-events: none;
}

.grid__slash-beam {
    width: 100%;
    height: 100%;
    border-radius: 8rpx;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.85) 22%, #fff 50%, rgba(255, 255, 255, 0.85) 78%, transparent);
    box-shadow: 0 0 20rpx rgba(255, 255, 255, 0.85);
    transform-origin: center;
    animation: slashSweep 0.24s ease-out forwards;
}

@keyframes slashSweep {
    0% { transform: scaleX(0); opacity: 0; }
    22% { opacity: 1; }
    100% { transform: scaleX(1); opacity: 0; }
}

/* 透明触摸层：只在划刀玩法的局内出现，其它玩法的滚动与点按完全不受影响 */
.swipe-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    z-index: 3;
}

/* ---------- 循光斩桩：刀光寿命线 / 重斩 / 斩中 ---------- */
.cell__life {
    position: absolute;
    left: 10rpx;
    right: 10rpx;
    bottom: 9rpx;
    height: 6rpx;
    border-radius: 3rpx;
    background: rgba(255, 253, 247, 0.92);
    box-shadow: 0 0 8rpx rgba(255, 253, 247, 0.55);
    transform-origin: left center;
    animation-name: lifeDrain;
    animation-timing-function: linear;
    animation-fill-mode: forwards;
    pointer-events: none;
}

@keyframes lifeDrain {
    from { transform: scaleX(1); }
    to { transform: scaleX(0); }
}

.cell--faded {
    background-color: var(--jade-dim, #b3ab96);
    background-image: none;
    color: #6b6555;
    box-shadow: inset 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
}

@keyframes hitPop {
    0% { transform: scale(1.07); }
    100% { transform: scale(1); }
}

/* 五行分色只作用于亮起的格子，t0 留给主题主色 */
.cell--lit.cell--t1 { background: #4f8f5a; }
.cell--lit.cell--t2 { background: #c25b3f; }
.cell--lit.cell--t3 { background: #b8893b; }
.cell--lit.cell--t4 { background: #7d8398; }
.cell--lit.cell--t5 { background: #3b7a8c; }

/* ---------- 辨伪择真：真招与虚影 ---------- */
.cell--decoy {
    background-color: var(--jade-dim, #b3ab96);
    background-image: none;
    color: #5f5949;
}

/* ---------- 循纹递推：竖向河道 ---------- */
.lane-rule {
    box-sizing: border-box;
    margin-top: 20rpx;
    padding: 14rpx 18rpx;
    border-left: 6rpx solid var(--acc, #3d8c74);
    border-radius: 10rpx;
    background: rgba(255, 253, 246, 0.06);
}

.grid--lane {
    padding: 14rpx;
}

.grid--lane .cell {
    height: 108rpx;
    border-radius: 12rpx;
}

.grid--lane .cell--fog {
    background-color: var(--jade-dim, #b3ab96);
    background-image: none;
    color: transparent;
    border-style: dashed;
    border-color: rgba(255, 253, 246, 0.28);
    box-shadow: inset 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
}

.grid--lane .cell--trail {
    background-color: #d9cbaa;
    background-image: none;
    color: #4c4736;
    opacity: 0.7;
}

.grid--lane .cell--stone {
    background-color: var(--jade, #fdf7e6);
    color: var(--jade-ink, #3c382a);
    border-color: var(--well, #0b2331);
    font-size: 34rpx;
    font-weight: 700;
}

.grid--lane .cell--stone.cell--t1 { box-shadow: inset 0 -10rpx 0 rgba(79, 143, 90, 0.5); }
.grid--lane .cell--stone.cell--t2 { box-shadow: inset 0 -10rpx 0 rgba(194, 91, 63, 0.5); }
.grid--lane .cell--stone.cell--t3 { box-shadow: inset 0 -10rpx 0 rgba(184, 137, 59, 0.55); }
.grid--lane .cell--stone.cell--t4 { box-shadow: inset 0 -10rpx 0 rgba(125, 131, 152, 0.55); }
.grid--lane .cell--stone.cell--t5 { box-shadow: inset 0 -10rpx 0 rgba(59, 122, 140, 0.55); }

/* ---------- 成对翻牌：牌背 / 翻开 / 已通 ---------- */
.cell--card {
    background-color: #2b3a34;
    background-image: linear-gradient(180deg, rgba(255, 253, 246, 0.14), rgba(255, 253, 246, 0) 56%);
    color: var(--c-imm-gold, #cfae6d);
    font-family: serif;
    font-size: 38rpx;
    box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.34), inset 0 0 0 1rpx rgba(207, 174, 109, 0.45);
}

.cell--flipped {
    background-color: var(--jade-paper, #e6d3ac);
    background-image: linear-gradient(180deg, rgba(120, 88, 46, 0.22), rgba(120, 88, 46, 0) 58%);
    color: var(--jade-ink, #3c382a);
    font-family: serif;
    font-size: 38rpx;
    box-shadow: inset 0 6rpx 12rpx rgba(78, 58, 30, 0.38), inset 0 -2rpx 0 rgba(255, 255, 255, 0.42);
    animation: litPop 0.28s ease-out;
}

.cell--flipped.cell--t1 { color: #4f8f5a; }
.cell--flipped.cell--t2 { color: #c25b3f; }
.cell--flipped.cell--t3 { color: #a8791f; }
.cell--flipped.cell--t4 { color: #6f5b9e; }
.cell--flipped.cell--t5 { color: #3b7a8c; }

.cell--matched {
    background-color: #d9cbaa;
    background-image: none;
    color: #4c4736;
    opacity: 0.55;
}

/* ---------- 五行相生：五盏灯围成一环 ----------
   环底与卷轴共用文件末尾那方「玉台」；这里只管尺寸与圆角。 */
.orbit {
    position: relative;
    height: 480rpx;
    margin-top: 20rpx;
    border-radius: 20rpx;
}

.orbit__core {
    position: absolute;
    top: 50%;
    left: 50%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 190rpx;
    height: 190rpx;
    border: 6rpx solid var(--acc, #3d8c74);
    border-radius: 50%;
    background: var(--bg, #efe9db);
    box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.16), inset 0 3rpx 0 rgba(255, 255, 255, 0.65);
    transform: translate(-50%, -50%);
}

.orbit__glyph {
    font-family: serif;
    font-size: 62rpx;
    line-height: 1.2;
}

.orbit__lamp {
    position: absolute;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 112rpx;
    height: 112rpx;
    border: 4rpx solid var(--well, #0b2331);
    border-radius: 50%;
    /* 五盏灯是玉牌做的小盏：表面受光、底下留一圈台色的沟槽，和盘上的牌同一套材质。 */
    background-color: var(--jade, #fdf7e6);
    background-image:
        radial-gradient(124% 96% at 50% -22%, rgba(255, 255, 255, 0.98), rgba(255, 255, 255, 0) 56%),
        linear-gradient(180deg, rgba(255, 253, 244, 0) 46%, rgba(176, 142, 90, 0.2));
    color: var(--ink, #5d6358);
    font-family: serif;
    font-size: 38rpx;
    box-shadow: 0 5rpx 0 rgba(0, 0, 0, 0.34), 0 8rpx 16rpx rgba(0, 0, 0, 0.28),
        inset 0 2rpx 0 rgba(255, 255, 255, 0.9);
}

.orbit__lamp--0 { top: 16rpx; left: 50%; transform: translateX(-50%); }
.orbit__lamp--1 { top: 118rpx; right: 34rpx; }
.orbit__lamp--2 { right: 74rpx; bottom: 32rpx; }
.orbit__lamp--3 { bottom: 32rpx; left: 74rpx; }
.orbit__lamp--4 { top: 118rpx; left: 34rpx; }

.orbit__lamp--t1 { border-color: #4f8f5a; }
.orbit__lamp--t2 { border-color: #c25b3f; }
.orbit__lamp--t3 { border-color: #b8893b; }
.orbit__lamp--t4 { border-color: #7d8398; }
.orbit__lamp--t5 { border-color: #3b7a8c; }

.orbit__lamp.lamp--current {
    background: var(--acc, #3d8c74);
    color: #fffdf7;
    box-shadow: 0 0 0 8rpx rgba(184, 137, 59, 0.28), 0 10rpx 20rpx rgba(0, 0, 0, 0.2);
}

.orbit__lamp.lamp--hit {
    background: #b8893b;
    color: #fffdf7;
    animation: litPop 0.35s ease-out;
}

/* ---------- 步法连段：卷轴 + 四个步法键 ---------- */
.scroll {
    box-sizing: border-box;
    margin-top: 20rpx;
    padding: 20rpx;
    border-radius: 18rpx;
}

.scroll__ribbon {
    display: flex;
    flex-wrap: wrap;
    min-height: 88rpx;
    margin-top: 16rpx;
}

/* 卷轴是一串步点，不是一行字：节点画成圆，走过的描边、当前那颗实心起光——
   一眼能看出流光在往前推，而不是在读一串文字。 */
.scroll__move {
    position: relative;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72rpx;
    height: 72rpx;
    margin: 0 12rpx 12rpx 0;
    border: 3rpx solid var(--well, #0b2331);
    border-radius: 50%;
    background-color: var(--jade, #fdf7e6);
    background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(255, 253, 244, 0) 52%, rgba(176, 142, 90, 0.3));
    color: var(--ink, #5d6358);
    box-shadow: 0 3rpx 0 rgba(0, 0, 0, 0.32), inset 0 2rpx 0 rgba(255, 255, 255, 0.9);
}

/* 步点之间连一小段线：一串圆点看上去才像「一条要走的路径」，
   而不是一排待点的按钮。走过的那些线更实。 */
.scroll__move::after {
    position: absolute;
    top: 50%;
    right: -12rpx;
    width: 12rpx;
    height: 2rpx;
    background: var(--acc, #3d8c74);
    opacity: 0.3;
    content: '';
    transform: translateY(-50%);
}

.scroll__move--done::after { opacity: 0.75; }
.scroll__move:last-child::after { display: none; }

.scroll__move--active {
    border-color: var(--acc, #3d8c74);
    background: var(--acc, #3d8c74);
    color: #fffdf7;
    box-shadow: 0 0 14rpx var(--acc, #3d8c74);
    animation: litPop 0.35s ease-out;
}

.scroll__move--done {
    border-color: var(--acc, #3d8c74);
    background: transparent;
    color: var(--acc, #3d8c74);
    opacity: 0.55;
}

.scroll__keys {
    display: flex;
    margin-top: 20rpx;
}

.scroll__key {
    box-sizing: border-box;
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    height: 120rpx;
    margin-right: 12rpx;
    border: 4rpx solid var(--well, #0b2331);
    border-radius: 16rpx;
    background-color: var(--jade, #fdf7e6);
    background-image:
        radial-gradient(124% 96% at 50% -22%, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0) 58%),
        linear-gradient(180deg, rgba(255, 253, 244, 0) 44%, rgba(176, 142, 90, 0.3));
    color: var(--ink, #5d6358);
    box-shadow: 0 5rpx 0 rgba(0, 0, 0, 0.34), inset 0 2rpx 0 rgba(255, 255, 255, 0.9);
}

/* 按下就整块翻成步色：连按同一个方向时，手指能立刻确认「这一下点上了」。 */
.scroll__key--press {
    background: var(--acc, #3d8c74);
    color: #fffdf7;
}

.scroll__key:last-child { margin-right: 0; }

/* ---------- 步法符号 ----------
   盘面不写汉字：进 / 退 / 侧 / 转 只作内部真值，画出来的是方向图形。
   箭头默认朝右，up = -90° / down = 90° / side = -45°；「旋身」没有方向，
   改用缺口圆环（四周皆可转，缺口表示还在转）。 */
.step {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34rpx;
    height: 34rpx;
}

.step__arrow {
    position: absolute;
    width: 26rpx;
    height: 5rpx;
    border-radius: 3rpx;
    background: currentColor;
}

.step__arrow::after {
    position: absolute;
    top: 50%;
    right: -1rpx;
    width: 0;
    height: 0;
    border-top: 9rpx solid transparent;
    border-bottom: 9rpx solid transparent;
    border-left: 12rpx solid currentColor;
    content: '';
    transform: translateY(-50%);
}

.step--up .step__arrow { transform: rotate(-90deg); }
.step--down .step__arrow { transform: rotate(90deg); }
.step--side .step__arrow { transform: rotate(-45deg); }

/* 旋身：缺口圆环只是「一圈」，加一枚切向的小箭头才是「在转」。
   不加箭头时这个图形读起来像字母 C，和评级徽章的 C 撞了。 */
.step__ring {
    position: relative;
    display: none;
    box-sizing: border-box;
    width: 27rpx;
    height: 27rpx;
    border: 5rpx solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
}

.step__ring::after {
    position: absolute;
    top: -6rpx;
    right: -7rpx;
    width: 0;
    height: 0;
    border-right: 13rpx solid currentColor;
    border-top: 8rpx solid transparent;
    border-bottom: 8rpx solid transparent;
    content: '';
    transform: rotate(-38deg);
}

.step--turn .step__arrow { display: none; }
.step--turn .step__ring { display: block; }

.step--lg {
    width: 48rpx;
    height: 48rpx;
}

.step--lg .step__arrow {
    width: 36rpx;
    height: 7rpx;
    border-radius: 4rpx;
}

.step--lg .step__arrow::after {
    border-top-width: 12rpx;
    border-bottom-width: 12rpx;
    border-left-width: 17rpx;
}

.step--lg .step__ring {
    width: 38rpx;
    height: 38rpx;
    border-width: 7rpx;
}

.step--lg .step__ring::after {
    top: -8rpx;
    right: -9rpx;
    border-right-width: 17rpx;
    border-top-width: 10rpx;
    border-bottom-width: 10rpx;
}

/* ---------- 起手式 ---------- */
.countdown-mask {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: var(--z-countdown);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--c-imm-mask);
}

.countdown-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--c-imm-text);
}

.countdown-seal {
    color: var(--c-imm-gold);
    font-size: 72rpx;
    letter-spacing: 10rpx;
}

.countdown-num {
    color: var(--c-imm-text);
    font-size: 150rpx;
    line-height: 1.4;
    animation: litPop 0.36s ease-out;
}

.countdown-inner .tiny { color: var(--c-imm-text-2); }

/* ---------- 结算 ---------- */
.modal--reveal { animation: modalReveal 0.42s ease-out; }

.res-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14rpx 0;
    border-bottom: 1rpx solid var(--c-imm-line-soft);
}

.res-note { padding: 6rpx 0; }

.res-note .body { color: var(--c-imm-text-2); }

@keyframes litPop {
    0% { transform: scale(0.82); opacity: 0.45; }
    60% { transform: scale(1.06); opacity: 1; }
    100% { transform: scale(1); opacity: 1; }
}
@keyframes badShake {
    0%, 100% { transform: translateX(0); }
    30% { transform: translateX(-8rpx); }
    70% { transform: translateX(8rpx); }
}
@keyframes fxFloat {
    0% { opacity: 0; transform: translateY(18rpx) scale(0.9); }
    18% { opacity: 1; transform: translateY(0) scale(1); }
    75% { opacity: 1; transform: translateY(-10rpx); }
    100% { opacity: 0; transform: translateY(-46rpx); }
}
@keyframes bannerIn {
    from { opacity: 0; letter-spacing: 14rpx; }
    to { opacity: 1; letter-spacing: 4rpx; }
}
@keyframes modalReveal {
    from { opacity: 0; transform: translateY(30rpx) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
}

/* ---------- 功法品阶 ---------- */
/* 品阶只留一枚小印（.rank-badge--sm）+ 一段倍率，卡与进阶链都撤了。 */
.rank-badge {
    width: 46rpx;
    height: 46rpx;
    margin-right: 12rpx;
    border-radius: 8rpx;
    color: var(--c-imm-bg);
    font-size: 26rpx;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* ---------- 难度档选择 ---------- */
.warn-note {
    display: block;
    padding: 12rpx 16rpx;
    border-left: 4rpx solid var(--c-imm-danger);
    border-radius: 0 var(--r-xs) var(--r-xs) 0;
    background: var(--c-imm-danger-soft);
    color: var(--c-imm-danger);
    font-size: 22rpx;
    line-height: 1.65;
}
.diff-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
}
/* 五档排成 3 + 2：用 flex-basis 让第二行两块自己撑满，
   否则右下角空出一格，看着像漏了一张卡。 */
.diff-chip {
    flex: 1 1 29%;
    box-sizing: border-box;
    padding: var(--sp-3) var(--sp-2);
    border: 1rpx solid var(--c-border);
    border-radius: var(--r-sm);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rpx;
    background: var(--c-imm-bg-2);
}
.diff-chip__name { font-size: var(--fs-body-sm); color: var(--c-text); font-weight: 600; }
.diff-chip__mult { font-size: var(--fs-caption); color: var(--c-text-2); }
.diff-chip__need { font-size: var(--fs-caption); color: var(--c-imm-gold); }
/* 选中这一档实际收紧了什么：一行小字，跟在档位下面，不占一格。 */
.diff-brief {
    display: block;
    margin-top: var(--sp-3);
    color: var(--c-imm-text-3);
    line-height: 1.6;
}
/* 选中档只换描边与字色，不铺色块：一屏只允许一处金色实心（开始参悟）。 */
.diff-chip--on { border-color: var(--c-imm-gold-dim); background: var(--c-imm-gold-soft); }
.diff-chip--on .diff-chip__name { color: var(--c-imm-gold); }
.diff-chip--on .diff-chip__mult { color: var(--c-imm-text-2); }
.diff-chip--lock { opacity: 0.55; }

/* 入门卡：左侧一道旧金细线，读完就收。不铺底色——它和规则卡是同一层，
   铺色会把它变成第二个「主卡」，一屏里就有两个重点了。 */
.intro-card { border-left: 4rpx solid var(--c-imm-gold-dim); }
.intro-steps { display: flex; flex-direction: column; gap: var(--sp-2); margin-top: var(--sp-3); }
.intro-step { color: var(--c-imm-text-2); line-height: 1.6; }
.intro-inline { display: block; margin-top: var(--sp-3); color: var(--c-imm-text-3); }
/* 关卡条：一左一右两个翻页格，中间写「第几关 + 本章第几关」。
   不用滚轮也不用长列表——999 关铺出来只会变成一张没人看得完的图。 */
.lv-row {
    display: flex;
    align-items: stretch;
    gap: var(--sp-2);
}
.lv-step {
    width: 96rpx;
    min-height: 96rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 40rpx;
    line-height: 1;
    color: var(--c-imm-gold);
    border: 1rpx solid var(--c-border);
    border-radius: var(--r-sm);
    background: var(--c-imm-bg-2);
}
.lv-step--off { color: var(--c-imm-text-3); opacity: 0.45; }
.lv-mid {
    flex: 1;
    min-height: 96rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4rpx;
    border: 1rpx solid var(--c-imm-gold-dim);
    border-radius: var(--r-sm);
    background: var(--c-imm-gold-soft);
}
.lv-num { font-size: var(--fs-h3); color: var(--c-imm-gold); font-weight: 600; line-height: 1.1; }
.lv-sub { font-size: var(--fs-caption); color: var(--c-imm-text-3); }


/* 盘面是纸、页面是墨：本页恒定深色，不再跟系统明暗翻转。
   纸面取的是注入的 --soft / --ink / --bg，因此格子里的字永远是深墨落在浅纸上；
   页面本身（准备页、HUD、结算）只认 --c-imm-*。系统切到深色时整页不变，
   盘面也不会突然变成另一种颜色。 */

/* ---------- 本门新法：熟练度阶段解锁的规则变化 ---------- */
.stage-rule {
  display: flex;
  align-items: flex-start;
  gap: var(--sp-3);
  margin-top: var(--sp-3);
}

.stage-rule__text { line-height: var(--lh-body); }

/* 胶囊开关：墨底上只有两句状态字，开是金边金字、关是灰边灰字。
   原生 switch 在深色下未选中轨道是一块白，和这套皮肤打架，所以自己做。
   热区撑到 --touch-xs，别让两个字小到点不准。 */
.stage-rule__toggle {
  flex: none;
  align-self: center;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 72rpx;
  min-height: var(--touch-xs);
  padding: 0 10rpx;
  border: 1rpx solid var(--c-imm-line);
  border-radius: 999rpx;
  color: var(--c-imm-text-3);
  font-size: var(--fs-caption);
  letter-spacing: 1rpx;
}

.stage-rule__toggle--on {
  border-color: var(--c-imm-gold-dim);
  color: var(--c-imm-gold);
}

/* ---------- 连 S 倍率的十格圆点 ---------- */
/* 圆点还在（形状比数字快），但不铺十张卡片；亮到第 10 格就是封顶。 */
.combo-dot {
  width: 16rpx;
  height: 16rpx;
  border: 1rpx solid var(--c-imm-gold-dim);
  border-radius: 50%;
  background: transparent;
  box-sizing: border-box;
}

.combo-dot--on { background: var(--c-imm-gold); border-color: var(--c-imm-gold); }

/* ---------- 三套经典玩法的盘面：矮格 / 灵纹 / 落石 / 方向键 ---------- */
/* 6 列以上、8 行的盘面要把格子压矮，否则小屏装不下；只在 vm.extras.compact 时启用。 */
.grid--compact .cell {
  height: 76rpx;
  font-size: 24rpx;
  border-width: 3rpx;
  border-radius: 10rpx;
}

.cell--chip { font-size: 34rpx; letter-spacing: 0; }
/* 空位：牌被收走了，只剩台。整格透明 + 撤掉沟槽，才真的「空」得干净。 */
.cell--gone, .cell--void { background: transparent; background-image: none; border-color: transparent; box-shadow: none; }
/* 选中：玉牌上用金线箍住，白线在白牌上等于没画。 */
.cell--sel { box-shadow: inset 0 0 0 4rpx var(--c-imm-gold, #cfae6d), 0 0 20rpx rgba(207, 174, 109, 0.5); }
.cell--hintpair { animation: litPop 0.5s ease-out infinite alternate; }
.cell--set { opacity: 0.86; }
.cell--live { box-shadow: inset 0 0 0 3rpx var(--c-imm-gold, #cfae6d), 0 0 18rpx rgba(207, 174, 109, 0.45); }

/* ---------- 收牌迸溅：在收走的那一格原地炸开一小把 ----------
   挂在 .grid 里的独立浮层（.spark），不是格子的伪元素：消消乐收完立刻掉落重排，
   那一格当场就换了内容，格子演不出「我被收走了」。浮层则与盘面状态无关。
   坐标由页面按「第几列第几行」算成百分比，所以只管摆位，不管格子尺寸档。
   时长 520ms 与 data/visual.js 的 MOTION.sparkMs 对齐（页面按它撤节点）。 */
.spark {
    position: absolute;
    z-index: 3;
    width: 0;
    height: 0;
    pointer-events: none;
}

/* 一圈细环荡开：给「这一格空了」一个边界。直径压到一格左右，再大就成了罩子。
   它比粒子先淡出——环留到最后一帧，就成了「呼啦圈」，收尾要脆。 */
.spark__ring {
    position: absolute;
    left: -42rpx;
    top: -42rpx;
    box-sizing: border-box;
    width: 84rpx;
    height: 84rpx;
    border-width: 5rpx;
    border-style: solid;
    border-radius: 50%;
    opacity: 0;
    animation: sparkRing 500ms ease-out forwards;
}

/* 起手一下白光：没有它，粒子从静止开始飞，读起来像「撒了一把」而不是「崩开」。 */
.spark__core {
    position: absolute;
    left: -17rpx;
    top: -17rpx;
    width: 34rpx;
    height: 34rpx;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255, 250, 236, 0.92), rgba(255, 250, 236, 0));
    opacity: 0;
    animation: sparkCore 200ms ease-out forwards;
}

/* 尺寸与位置由页面按粒子的序号给（14 / 17 / 20rpx），这里只管形状与动画。 */
.spark__dot {
    position: absolute;
    border-radius: 50%;
    opacity: 0;
    animation: sparkFly 500ms ease-out forwards;
}

@keyframes sparkRing {
    0% { opacity: 0; transform: scale(0.5); }
    12% { opacity: 0.95; }
    44% { opacity: 0.6; }
    100% { opacity: 0; transform: scale(1.2); }
}

@keyframes sparkCore {
    0% { opacity: 0; transform: scale(0.35); }
    26% { opacity: 0.9; }
    100% { opacity: 0; transform: scale(1.2); }
}

/* 起点留 20rpx：八粒从同一个点出发会挤成一团花，起步就该散开。
   透明度压到 38% 才开始掉：一过 130ms 就淡成半透明，碎屑还没飞到位就没了。 */
@keyframes sparkFly {
    0% { opacity: 0; transform: rotate(var(--a, 0deg)) translateX(20rpx) scale(1); }
    8% { opacity: 1; }
    62% { opacity: 0.9; }
    100% { opacity: 0; transform: rotate(var(--a, 0deg)) translateX(var(--d, 148rpx)) scale(0.55); }
}

/* ---------- 灵纹牌：盘面上摆的是图案，不是字形（牵灵引线 / 灵植三秀） ----------
   牌面从深色块退回瓷白：深底上摆彩色的果子看不清，图案要有纸底才立得住。
   八种图案的 sprite 与切位在 styles/crest.wxss，由本文件顶部那条导入语句引进。 */

.cell--lit.cell--chip {
    /* 灵纹牌被点亮时不铺主题色（图案会看不清），而是把牌面顶到最亮 + 一道金框：
       一排六张里「哪张被点了」靠亮度与金线，不靠换底色。 */
    background-color: #fffdf4;
    background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(248, 238, 218, 0.72));
    box-shadow: 0 0 0 3rpx var(--c-imm-gold, #cfae6d), 0 6rpx 14rpx rgba(0, 0, 0, 0.4),
        0 0 20rpx rgba(207, 174, 109, 0.4), inset 0 2rpx 0 rgba(255, 255, 255, 0.95);
}

/* 选中的牌：白描边在瓷白牌上看不见，改成一道金线。不位移——位移会和按压的
   transform 抢同一个属性，按下就没反馈了。 */
.cell--chip.cell--sel {
    box-shadow: inset 0 0 0 5rpx #c08a2e, 0 0 20rpx rgba(192, 138, 46, 0.45);
}

/* 收走的灵果：留位置、不留牌，整格透明露出台面。 */
.cell--chip.cell--gone {
    background: transparent;
    border-color: transparent;
    box-shadow: none;
    opacity: 0;
}

.pad {
  display: flex;
  gap: var(--sp-3);
  margin-top: var(--sp-4);
}

/* ---------- 落石垒基：下一块预告 ----------
   四乘四的小格，摆在方向键同一行左侧。它是「规划」的唯一依据，
   所以给足对比度：亮块用与主盘同一套五行色，空格只留一个几乎看不见的底点。 */
.next-row {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  margin-top: var(--sp-3);
}

.next-row__label { color: var(--c-imm-text-3); }

.next-piece {
  display: flex;
  flex-wrap: wrap;
  /* 四格 × 19rpx + 左右内边 8rpx = 84rpx。写 76 会让第四格换到下一行，
     看起来像「下一块是三格的一条」。 */
  width: 84rpx;
  padding: 4rpx;
  border-radius: 8rpx;
  background-color: var(--well, #0b2331);
  box-shadow: inset 0 0 0 1rpx rgba(207, 174, 109, 0.32);
}

.next-piece__cell {
  width: 19rpx;
  height: 19rpx;
  border-radius: 3rpx;
}

.next-piece__cell--on {
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.42), rgba(255, 255, 255, 0));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.55), 0 1rpx 2rpx rgba(0, 0, 0, 0.4);
}

.next-piece__cell--t1 { background-color: #4f8f5a; }
.next-piece__cell--t2 { background-color: #c25b3f; }
.next-piece__cell--t3 { background-color: #b8893b; }
.next-piece__cell--t4 { background-color: #7d8398; }
.next-piece__cell--t5 { background-color: #3b7a8c; }

/* 落点虚影：这一块直线掉下去会停在哪。只描一圈淡边、不填色——
   填了就和真的落定块分不开，玩家会以为自己已经放好了。 */
.cell--ghost {
  background: rgba(207, 174, 109, 0.16);
  background-image: none;
  box-shadow: inset 0 0 0 3rpx rgba(207, 174, 109, 0.55);
  opacity: 0.85;
}

.cell--ghost.cell--t1 { box-shadow: inset 0 0 0 3rpx rgba(119, 179, 132, 0.62); }
.cell--ghost.cell--t2 { box-shadow: inset 0 0 0 3rpx rgba(214, 124, 98, 0.62); }
.cell--ghost.cell--t3 { box-shadow: inset 0 0 0 3rpx rgba(206, 166, 94, 0.62); }
.cell--ghost.cell--t4 { box-shadow: inset 0 0 0 3rpx rgba(158, 164, 184, 0.62); }
.cell--ghost.cell--t5 { box-shadow: inset 0 0 0 3rpx rgba(104, 168, 186, 0.62); }

/* ---------- 牵灵引线：连上的那一对之间的折线 ----------
   只画横段与竖段（玩法层已经把共线点压掉了），所以宽高各写一条就够。
   线出盘是允许的：边上的灵纹本来就要从盘外绕，格子外面那半格也属于这条线。 */
.grid__link {
    position: absolute;
    z-index: 4;
    pointer-events: none;
    background: var(--c-imm-gold, #cfae6d);
    box-shadow: 0 0 14rpx rgba(207, 174, 109, 0.72);
    border-radius: 3rpx;
}

.grid__link--h {
    height: 5rpx;
    margin-top: -2.5rpx;
    transform-origin: left center;
    animation: linkGrowX 190ms ease-out both;
}

.grid__link--v {
    width: 5rpx;
    margin-left: -2.5rpx;
    transform-origin: center top;
    animation: linkGrowY 190ms ease-out both;
}

@keyframes linkGrowX {
    from { transform: scaleX(0.02); }
    to { transform: scaleX(1); }
}

@keyframes linkGrowY {
    from { transform: scaleY(0.02); }
    to { transform: scaleY(1); }
}

/* 化行：整行一道暖光扫过。这是浮层，不是格子状态——
   盘面在化层那一刻已经变空，格子自己没有「我刚被消掉」的痕迹可演。 */.grid__line {
  position: absolute;
  left: 0;
  right: 0;
  pointer-events: none;
  z-index: 3;
  border-radius: 6rpx;
  background: linear-gradient(90deg,
    rgba(255, 240, 200, 0) 0%,
    rgba(255, 248, 220, 0.94) 16%,
    rgba(255, 252, 236, 0.98) 50%,
    rgba(255, 248, 220, 0.94) 84%,
    rgba(255, 240, 200, 0) 100%);
  animation: lineSweep 440ms ease-out forwards;
}

@keyframes lineSweep {
    0% { transform: scaleY(0.55); opacity: 0; }
    22% { opacity: 0.96; }
    62% { transform: scaleY(1.06); opacity: 0.7; }
    100% { transform: scaleY(1.2); opacity: 0; }
}

.pad__key {
  flex: 1;
  min-height: var(--touch);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  color: var(--jade-ink, #3c382a);
  background-color: var(--jade, #fdf7e6);
  background-image:
    radial-gradient(124% 96% at 50% -22%, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0) 58%),
    linear-gradient(180deg, rgba(255, 253, 244, 0) 44%, rgba(176, 142, 90, 0.3));
  border: 4rpx solid var(--well, #0b2331);
  border-radius: var(--r-md);
  /* 一颗能按下去的玉键：底边留 5rpx 厚度，按下去缩回 3rpx，手感靠这两行。 */
  box-shadow: 0 5rpx 0 rgba(0, 0, 0, 0.34), inset 0 2rpx 0 rgba(255, 255, 255, 0.9);
  transition: transform 0.08s ease, box-shadow 0.08s ease;
}

/* 方向键图形：全部用边框画三角形，不用字体里的箭头字符。
   ← ⟳ ⇓ 这类符号在部分安卓 / 桌面浏览器会被系统换成彩色立体 emoji，
   四个白键上出现三种材质，一眼就是「网页里贴了个符号」。 */
.pad__icon {
    position: relative;
    width: 0;
    height: 0;
    border-style: solid;
}

.pad__icon--left {
    border-width: 11rpx 18rpx 11rpx 0;
    border-color: transparent var(--jade-ink, #3c382a) transparent transparent;
}

.pad__icon--right {
    border-width: 11rpx 0 11rpx 18rpx;
    border-color: transparent transparent transparent var(--jade-ink, #3c382a);
}

.pad__icon--up {
    border-width: 0 11rpx 16rpx 11rpx;
    border-color: transparent transparent var(--jade-ink, #3c382a) transparent;
}

.pad__icon--down {
    border-width: 16rpx 11rpx 0 11rpx;
    border-color: var(--jade-ink, #3c382a) transparent transparent transparent;
}

/* 转石：一个缺口的圆环 + 一枚小尖。缺的那一口就是「转向」的意思。 */
.pad__icon--rotate {
    width: 26rpx;
    height: 26rpx;
    border: 4rpx solid var(--jade-ink, #3c382a);
    border-right-color: transparent;
    border-radius: 50%;
}

.pad__icon--rotate::after {
    content: "";
    position: absolute;
    right: -6rpx;
    top: -1rpx;
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 6rpx 0 6rpx 9rpx;
    border-color: transparent transparent transparent var(--jade-ink, #3c382a);
}

/* 速降：一横压在向下的三角上，与「下」区分开——下是一格，降是到底。 */
.pad__icon--drop {
    border-width: 16rpx 11rpx 0 11rpx;
    border-color: var(--jade-ink, #3c382a) transparent transparent transparent;
    margin-top: 10rpx;
}

.pad__icon--drop::before {
    content: "";
    position: absolute;
    top: -12rpx;
    left: -11rpx;
    width: 22rpx;
    height: 4rpx;
    border-radius: 2rpx;
    background: var(--jade-ink, #3c382a);
}

.pad__key--press {
  transform: translateY(3rpx);
  box-shadow: 0 2rpx 0 rgba(120, 100, 60, 0.26), inset 0 2rpx 0 rgba(255, 255, 255, 0.5);
}

/* ---------- 阵灯推演：翻转范围微光 ---------- */
/* 点一格时，被翻的自身 + 四邻同步闪一拍。a / b 两个类名交替，连点同一格动画才会重播；
   animation 不设 forwards，跑完自动回到灯态，不占常驻循环动画的预算。 */
.cell--flip-a, .cell--flip-b { animation: flipGlow 0.26s ease-out 1; }

@keyframes flipGlow {
    0% { box-shadow: inset 0 0 0 6rpx rgba(255, 253, 247, 0.95), 0 0 20rpx rgba(255, 253, 247, 0.5); }
    100% { box-shadow: inset 0 0 0 0 rgba(255, 253, 247, 0), 0 0 0 rgba(255, 253, 247, 0); }
}

/* ---------- 首局手把手 ---------- */
/* 一张窄条 + 一格呼吸：不盖盘面、不遮整屏。看规则最快的方式是亲手点一次。 */
.teach {
    padding-bottom: var(--sp-2);
    border-bottom: 1rpx solid var(--c-imm-line-soft);
    margin-bottom: var(--sp-3);
}

.teach__skip {
    min-height: var(--touch-xs);
    line-height: var(--touch-xs);
}

.teach__text {
    color: var(--c-imm-text);
    line-height: 1.6;
}

/* 该点的那一格自己呼吸：盘面不写「点这里」，靠光影指路。 */
.cell--teach-next {
    animation: teachPulse 1.15s ease-in-out infinite;
}

@keyframes teachPulse {
    0%, 100% {
        box-shadow: inset 0 0 0 0 rgba(255, 253, 247, 0), 0 0 0 0 rgba(207, 174, 109, 0);
        transform: scale(1);
    }
    50% {
        box-shadow: inset 0 0 0 5rpx rgba(255, 253, 247, 0.92), 0 0 28rpx rgba(207, 174, 109, 0.55);
        transform: scale(1.03);
    }
}

/* ---------- 参悟结算：留在本页 ---------- */
/* 主按钮改成「留在本页」后，连刷要有一条不抢主按钮的轻量出口。 */
.modal__again, .settle__again {
    display: block;
    text-align: center;
    min-height: var(--touch-xs);
    line-height: var(--touch-xs);
    font-size: var(--fs-body-sm);
    margin-top: var(--sp-3);
}

/* 准备页顶部那行「上局战绩」：数值在左、可点的入口在右，不占首屏一行说明。 */
.pr-record {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
    margin-top: var(--sp-3);
    padding-top: var(--sp-2);
    border-top: 1rpx solid var(--c-imm-line-soft);
}

/* 倒数三秒里的反悔入口：别跟「点一下跳过」抢，catchtap 单独接。 */
.countdown__stay {
    margin-top: var(--sp-4);
    padding: var(--sp-2) var(--sp-4);
    font-size: var(--fs-body-sm);
}


/* ---------- 六门经典盘面：填数 / 合数 / 扫数 / 让路 / 推箱 / 择大 ----------
   盘面仍是「纸」，所以这里的底色与字色接管场景注入的 --soft / --ink；
   数值分色只用来分档（个位 / 十位 / 合到更大），不把答案标出来。 */
.grid--c5 .cell {
    width: 20%;
    height: 118rpx;
    font-size: 26rpx;
}

/* 9×9 一屏放得下：字小一档、沟槽细一档，深浅靠色调而不是靠加粗边框。 */
.grid--c9 .cell {
    width: 11.1111%;
    height: 74rpx;
    font-size: 22rpx;
    font-weight: 700;
    border-width: 3rpx;
    border-radius: 8rpx;
}

.cell--num {
    background-color: var(--jade, #fdf7e6);
    color: var(--ink, #26405f);
    font-size: 30rpx;
    font-weight: 700;
}

.cell--num.cell--t2 { color: #2f6b5b; }.cell--num.cell--t3 { color: #a8791f; }
.cell--num.cell--t4 { color: #b4453c; }
.cell--num.cell--t5 { color: #6f5b9e; }
.cell--num.cell--t6 { color: #3d7f8c; }
.cell--num.cell--t7 { color: #8a4560; }
.cell--num.cell--t8 { color: #4f6b45; }

/* ---------- 同数相合：数值牌 ----------
   2048 的读法只有一条：数字多大。底色是这条信息的第二层编码——
   从小到大的米黄排到赭红，扫一眼盘面就知道「大的都在左下角」。
   旧版白底黑字 + 只换字色，深玉台上一格一格都是白补丁，看不出梯度。 */
.cell--tile {
    background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0));
    color: #3a3226;
    font-size: 30rpx;
    font-weight: 700;
    letter-spacing: -1rpx;
}

/* 色阶要「跳」得出来：相邻两档只差一点点的话，玩家还是得逐格读数字。
   从米白一路走到赭红，每一档都比上一档暗一截、红一截。 */
.cell--tile.cell--t1 { background-color: #ece2cb; }
.cell--tile.cell--t2 { background-color: #e0c793; }
.cell--tile.cell--t3 { background-color: #d4ac6c; }
.cell--tile.cell--t4 { background-color: #c68d4c; color: #fff6e6; }
.cell--tile.cell--t5 { background-color: #b9713c; color: #fff6e6; }
.cell--tile.cell--t6 { background-color: #a85733; color: #fff4e0; }
.cell--tile.cell--t7 { background-color: #96402f; color: #fff4e0; }
.cell--tile.cell--t8 { background-color: #7f3340; color: #fff4e0; }

/* 空格：凹进去的一格。压深 + 上缘内影，和凸起的数值牌正好一凹一凸。 */
.cell--slot {
    background: rgba(0, 0, 0, 0.26);
    background-image: none;
    box-shadow: inset 0 3rpx 8rpx rgba(0, 0, 0, 0.55), inset 0 -1rpx 0 rgba(255, 246, 220, 0.05);
}

/* 三位数比两位数多半格宽、四位数再窄一号：1024 用 30rpx 会顶出格子。 */
.cell--tile-3 { font-size: 24rpx; }
.cell--tile-4 { font-size: 20rpx; letter-spacing: -2rpx; }

/* 当前最大的一块压一圈金边：它是这一局的进度条，也是玩家判断「还差几步」的锚点。 */
.cell--best {
    box-shadow: inset 0 0 0 3rpx rgba(207, 174, 109, 0.85), 0 0 18rpx rgba(207, 174, 109, 0.32);
}

/* ---------- 三秀同收：不成立与刚落下 ----------
   两条都只动 transform：动效被系统关掉时，牌还在原位，只是不抖也不落。 */
.cell--shake0, .cell--shake1 { animation: cellShake 280ms ease-in-out; }
.cell--drop0, .cell--drop1 { animation: cellDrop 220ms ease-out; }

@keyframes cellShake {
    0%, 100% { transform: translateX(0); }
    26% { transform: translateX(-7rpx); }
    58% { transform: translateX(7rpx); }
    82% { transform: translateX(-3rpx); }
}

/* 新苗从上方压进来：起点在格子外面一点，落定时回正。
   不做透明度渐变——半透明的灵纹牌叠在别的牌上会看成「多了一张」。 */
@keyframes cellDrop {
    from { transform: translateY(-46%) scaleY(0.84); }
    to { transform: translateY(0) scaleY(1); }
}

/* 合并弹 / 新块弹：两个不同的手感，不共用一条动画。
   合并是「撞上了」——缩一下再弹开；新块是「凭空出现」——从半大长到整格。
   两条都只动 transform，不动 opacity：动效被系统关掉时格子还在，只是不弹。 */
.cell--pop0, .cell--pop1 { animation: tileMerge 200ms ease-out; }
.cell--fresh0, .cell--fresh1 { animation: tileFresh 190ms ease-out; }

@keyframes tileMerge {
    0% { transform: scale(0.84); }
    58% { transform: scale(1.1); }
    100% { transform: scale(1); }
}

@keyframes tileFresh {
    0% { transform: scale(0.46); }
    100% { transform: scale(1); }
}

/* 题面格与自填格必须一眼分得开：题面压深一档、自填用亮纸。 */
.cell--given {
    background: #e7e0cf;
    color: #2b2b28;
    font-weight: 800;
}

/* 选中一格的同行同列同宫：浅浅压一层，扫排除法时眼睛有落点。 */
.cell--peer { background: #efe7d4; }

/* 顺序点格不提供「下一个在哪」的描边：盘面只分「点过的（变灰）」与「没点的」，
   位置得自己扫。给目标格描圈等于替玩家找，这一门就不成立了。 */

/* 推箱与让路：石壁 / 地面 / 阵位 / 人 / 石箱，全靠底色与形状分，不写汉字。 */
.cell--wall { background: #4a4a44; border-color: #35352f; }
.cell--floor { background: #f2ede0; }
.cell--goal { background: #f2ede0; color: #b8893b; font-size: 32rpx; }
.cell--man { background: var(--acc, #4f6b45); color: #fffdf7; font-size: 32rpx; }
.cell--boxed { background: #c9b083; color: #4a3a1f; font-size: 32rpx; }
.cell--boxed.cell--on-goal { background: #b8893b; color: #fffdf7; }

/* 数字键：1–9 加一个清除，五行两排；比方向键小一点，但仍是可点尺寸。 */
.pad--numbers {
    flex-wrap: wrap;
}

.pad--numbers .pad__key {
    flex: 0 0 calc(20% - var(--sp-3));
    min-height: 88rpx;
    font-size: 34rpx;
}

/* ---------- 另外三块盘面共用同一方「玉台」 ----------
   滑块让路 / 卷轴 / 五灯环不是格子拼的，但它们是同一类东西：一块要摸的深色台面。
   底色、受光、金线与落影在这里只写一次，免得改配色时漏掉两块。 */
.klotski,
.scroll,
.orbit {
    background-color: var(--well, #0b2331);
    background-image:
        radial-gradient(120% 76% at 50% -18%, rgba(255, 243, 214, 0.16), rgba(255, 243, 214, 0) 62%),
        radial-gradient(135% 96% at 50% 120%, rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0) 64%);
    box-shadow:
        0 0 0 1rpx rgba(207, 174, 109, 0.42),
        0 0 0 7rpx rgba(5, 10, 9, 0.5),
        0 20rpx 44rpx rgba(0, 0, 0, 0.5),
        inset 0 8rpx 22rpx rgba(0, 0, 0, 0.45);
}

/* ---------- 滑块让路：整块定位，不拿格子拼 ---------- */
.klotski {
    position: relative;
    width: 100%;
    padding-top: 100%;
    margin-top: 24rpx;
    border-radius: 18rpx;
    overflow: hidden;
    /* 台面下压出 4×4 的棋格：块挪动时，玩家需要一个「格」做参照，
       否则只看见几块色片在飘。格子比台亮一点点，不抢块。 */
    background-image:
        linear-gradient(90deg, rgba(255, 246, 220, 0.07) 1rpx, rgba(255, 246, 220, 0) 1rpx),
        linear-gradient(180deg, rgba(255, 246, 220, 0.07) 1rpx, rgba(255, 246, 220, 0) 1rpx),
        radial-gradient(120% 76% at 50% -18%, rgba(255, 243, 214, 0.16), rgba(255, 243, 214, 0) 62%),
        radial-gradient(135% 96% at 50% 120%, rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0) 64%);
    background-size: 25% 25%, 25% 25%, 100% 100%, 100% 100%;
}

.klotski__exit {
    position: absolute;
    bottom: 0;
    width: 50%;
    height: 25%;
    border: 4rpx dashed rgba(207, 174, 109, 0.85);
    border-bottom-width: 8rpx;
    border-radius: 12rpx 12rpx 0 0;
    background: radial-gradient(80% 70% at 50% 100%, rgba(207, 174, 109, 0.22), rgba(207, 174, 109, 0) 70%);
}

.klotski__blk {
    position: absolute;
    box-sizing: border-box;
    /* 边框取台色 = 块与块之间留沟槽，和盘上的玉牌同一套「摆在一块板上」的做法。 */
    border: 4rpx solid var(--well, #0b2331);
    border-radius: 12rpx;
    /* 木块：上缘受光、底边留 6rpx 厚度、整体落影。挪动时块与块之间才有「叠着」的关系。 */
    background-color: #d9c8a8;
    background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0) 56%, rgba(146, 112, 62, 0.26));
    box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.4), inset 0 2rpx 0 rgba(255, 255, 255, 0.8),
        inset 0 0 0 1rpx rgba(164, 134, 86, 0.3);
}

.klotski__blk--main { background-color: var(--acc, #96603c); }
.klotski__blk--wide { background-color: #c9a06a; }
.klotski__blk--tall { background-color: #b5836a; }
.klotski__blk--ga,
.klotski__blk--gb { background-color: #cdbb9a; }

/* 选中：金环箍住 + 抬高一档。只动阴影与位移，块的位置仍由 left/top 的百分比决定。 */
.klotski__blk--sel {
    box-shadow: 0 0 0 6rpx var(--c-imm-gold, #cfae6d), 0 14rpx 24rpx rgba(0, 0, 0, 0.24),
        inset 0 2rpx 0 rgba(255, 255, 255, 0.6);
}

.klotski__core {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 34%;
    height: 34%;
    margin: -17% 0 0 -17%;
    border-radius: 50%;
    border: 4rpx solid rgba(255, 253, 247, 0.85);
}
