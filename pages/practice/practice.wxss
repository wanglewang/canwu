/* 参悟页根容器挂 .pg--imm，与四个主页面共用 styles/immortal.wxss 的色板映射，
   --c-* 不用在本文件重抄一遍。本文件只补「这一页有、别处没有」的东西：
   功法头、局内 HUD、判定横幅、难度档、结算行。

   边界只有一条：**盘面是纸，其余是墨。**
   可以摸、可以划的那块（.grid / .cell / .ring-area / .orbit / .scroll / .pad）取
   minigames/theme.js 注入的 --soft / --ink / --bg / --frame，刻意保持浅色纸面，
   格子里的字才有落处；页面、HUD、横幅、弹层一律走 --c-imm-*。
   本页恒定深色，不写系统明暗媒体查询：系统切深色时纸与墨都不变。 */

/* 功法头不做盒子：标题直接落在墨底上，只用一条发丝线收口。
   原先是一张深卡叠在墨底上，两层深色几乎同值，看不出层次还多一圈圆角。 */
.pr-head {
    padding: var(--sp-6) var(--sp-2) var(--sp-6);
    border: 0;
    border-bottom: 1rpx solid var(--c-imm-line-soft);
    border-radius: 0;
    background: transparent;
    box-shadow: none;
}

/* 准备页顶部只报「这一局玩什么」：页面名已经写在导航栏（参悟），卡片里再写一遍
   「参 悟」就是同一行字出现两次。 */
.pr-head-row {
    display: flex;
    justify-content: flex-end;
}

.pr-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
}

/* 功法名是全页唯一的大字：不写手写空格、不挂衬线，层级交给字号与字重。 */
.pr-title {
    display: block;
    min-width: 0;
    margin-top: 18rpx;
    color: var(--c-imm-text);
    font-family: inherit;
}

/* 功法印记：一枚金线方印，唯一装饰，不做浅色块也不铺主题色。 */
.pr-seal {
    box-sizing: border-box;
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 88rpx;
    height: 88rpx;
    margin-top: 14rpx;
    border: 1rpx solid var(--c-imm-gold-dim);
    border-radius: var(--r-sm);
    transform: rotate(-6deg);
}

.pr-seal__glyph {
    color: var(--c-imm-gold);
    font-size: 42rpx;
    line-height: 1;
}

.pr-desc {
    display: block;
    margin-top: 12rpx;
    color: var(--c-imm-text-2);
    font-size: 25rpx;
    line-height: 1.7;
}

.pr-prof {
    margin-top: 28rpx;
}

.pr-tiny {
    color: var(--c-imm-text-3);
}

/* 下一段能拿到什么：跟进度条同一块，比正文再轻一档。 */
.pr-tier-next {
    display: block;
    margin-top: var(--sp-2);
    color: var(--c-imm-text-2);
}

/* 吸底条：与主页面同一条发丝线收口，不加重阴影（墨底上阴影看不出来，只会脏边）。 */
.pg .sticky-bar {
    border-top: 1rpx solid var(--c-imm-line-soft);
    box-shadow: none;
}

/* ---------- 局内 HUD ---------- */
.pr-play {
    padding: 26rpx 28rpx 24rpx;
}

/* 局内不再显示功法头卡，靠这一行小字交代「在练哪门、什么难度」 */
.hud__top {
    align-items: flex-start;
}

.hud__id {
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.hud__skill {
    color: var(--c-imm-text-3);
    font-size: 20rpx;
    letter-spacing: 2rpx;
}

.hud__time {
    margin-top: 4rpx;
    color: var(--c-imm-text);
    font-size: 40rpx;
    line-height: 1.2;
}

.hud__right {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    padding-top: 6rpx;
}

/* 收功：留在屏幕上方，离拇指热区远一点，误触代价太大 */
.hud__quit {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 56rpx;
    margin-left: 14rpx;
    padding: 0 18rpx;
    border: 1rpx solid var(--c-imm-line);
    border-radius: 999rpx;
    color: var(--c-imm-text-3);
    font-size: 22rpx;
    line-height: 1;
}

.hud__goal {
    line-height: 1.5;
}

.pr-hint {
    margin-top: 12rpx;
}

.pr-hint .tiny {
    line-height: 1.55;
}

/* 局内常驻一行术语速记：玩到一半看不懂符号时不用退出查说明 */
.pr-hint__terms {
    margin-top: 10rpx;
    padding: 10rpx 14rpx;
    border-left: 4rpx solid var(--c-imm-gold-dim);
    border-radius: 0 var(--r-xs) var(--r-xs) 0;
    background: var(--c-imm-gold-soft);
}

.pr-hint__terms .tiny {
    color: var(--c-imm-text-2);
    line-height: 1.5;
}

/* ---------- 准备页「怎么玩」 ---------- */
.guide__toggle {
    font-size: 23rpx;
}

.guide__goal {
    display: block;
    line-height: 1.7;
}

.guide__steps {
    margin-top: 16rpx;
}

.guide__step {
    display: flex;
    align-items: flex-start;
    gap: 12rpx;
    margin-top: 12rpx;
}

.guide__no {
    flex: 0 0 36rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36rpx;
    height: 36rpx;
    border-radius: 50%;
    background: var(--c-imm-panel-2);
    color: var(--c-imm-gold);
    font-size: 20rpx;
}

.guide__step .tiny,
.guide__term-desc {
    line-height: 1.6;
}

.guide__term {
    display: flex;
    align-items: flex-start;
    gap: 12rpx;
    margin-top: 14rpx;
}

.guide__term-name {
    flex: 0 0 auto;
    max-width: 240rpx;
    text-align: left;
}

.guide__note {
    padding: 14rpx 16rpx;
    border-left: 4rpx solid var(--c-imm-gold-dim);
    border-radius: 0 var(--r-xs) var(--r-xs) 0;
    background: var(--c-imm-gold-soft);
}

.guide__note .tiny {
    display: block;
    line-height: 1.6;
}

.guide__inline {
    padding: 12rpx 14rpx;
    border-radius: var(--r-xs);
    background: var(--c-imm-panel-2);
}

/* 已解锁的进阶机制接在基础操作后面，同一条速记里不换行分段。 */
.guide__inline-more {
    color: var(--c-imm-gold);
}

.combo-chip {
    margin-right: 12rpx;
    color: var(--c-imm-gold);
    font-size: 26rpx;
    font-weight: 600;
}

/* 评级徽章：只画一个字母 C，玩家会当成按钮去找它点。
   加「评级」二字并改成 pill，代价是两个多字的宽度，换的是不再猜。 */
.grade-chip {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-width: 52rpx;
    height: 44rpx;
    padding: 0 12rpx;
    border-radius: 22rpx;
    color: var(--c-imm-text);
    font-size: 28rpx;
    font-weight: 700;
}

.grade-chip__label {
    margin-right: 6rpx;
    font-size: 18rpx;
    font-weight: 500;
    opacity: 0.72;
}

.hud__track {
    overflow: hidden;
    height: 14rpx;
    border-radius: 10rpx;
    background: var(--c-imm-track);
}

.hud__fill {
    height: 100%;
    border-radius: 10rpx;
    transition: width 0.25s ease;
}

.hearts {
    display: flex;
    align-items: center;
}

.heart {
    margin-right: 8rpx;
    color: var(--c-imm-line);
    font-size: 28rpx;
}

.heart--on {
    color: var(--c-imm-gold);
}

.hearts .tiny {
    margin-left: 8rpx;
}

.meter__track {
    overflow: hidden;
    height: 10rpx;
    margin-top: 6rpx;
    border-radius: 8rpx;
    background: var(--c-imm-track);
}

.meter__fill {
    height: 100%;
    border-radius: 8rpx;
    transition: width 0.2s ease;
}

/* 判定横幅：一条上下金线的口播，不是卡也不是按钮 */
.banner {
    display: block;
    padding: 12rpx 0;
    border-top: 1rpx solid var(--c-imm-gold-dim);
    border-bottom: 1rpx solid var(--c-imm-gold-dim);
    color: var(--c-imm-gold);
    text-align: center;
    font-size: 30rpx;
    letter-spacing: 4rpx;
    animation: bannerIn 0.4s ease-out;
}

/* ---------- 舞台与浮字 ---------- */
.stage {
    position: relative;
    margin-top: 8rpx;
}

.fx {
    position: absolute;
    top: 34%;
    left: 0;
    right: 0;
    z-index: 5;
    text-align: center;
    font-size: 34rpx;
    font-weight: 700;
    pointer-events: none;
}

.fx--good { color: var(--c-imm-jade); }
.fx--bad { color: var(--c-imm-danger); }
.fx--gold { color: var(--c-imm-gold); }
.fx--k0, .fx--k1 { animation: fxFloat 0.9s ease-out forwards; }

/* ---------- 蓄力停区 ---------- */
.charge {
    margin-top: 24rpx;
}

.charge__track {
    position: relative;
    overflow: hidden;
    height: 64rpx;
    border-radius: 14rpx;
    background: var(--soft, #e9e3d4);
}

.charge__zone {
    position: absolute;
    top: 0;
    bottom: 0;
    background: rgba(184, 137, 59, 0.42);
    border-left: 5rpx solid #b4453c;
    border-right: 5rpx solid #b4453c;
}

.charge__cursor {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 10rpx;
    background: var(--acc, #2f6b5b);
    transform: translateX(-5rpx);
}

/* ---------- 节律判定盘 ---------- */
.ring-area {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 440rpx;
    margin-top: 20rpx;
    border-radius: 20rpx;
    background: var(--soft, #e9e3d4);
}

.ring-judge {
    position: absolute;
    box-sizing: border-box;
    width: 200rpx;
    height: 200rpx;
    border: 6rpx solid #b4453c;
    border-radius: 50%;
    opacity: 0.65;
}

.ring-orb {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 200rpx;
    height: 200rpx;
    border: 8rpx solid var(--acc, #3d8c74);
    border-radius: 50%;
    background: var(--bg, #efe9db);
    font-family: serif;
    font-size: 56rpx;
}

.ring-orb--perfect { background: #f6e6c8; }
.ring-orb--good { background: #e2efe6; }
.ring-orb--miss { background: #f5dedb; }

.ring-tip {
    position: absolute;
    bottom: 24rpx;
    color: var(--ink, #5d6358);
    font-size: 24rpx;
}

/* ---------- 通用格子 ---------- */
.grid {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    margin-top: 24rpx;
    padding: 10rpx;
    border-radius: 18rpx;
    overflow: hidden;
}

.cell {
    box-sizing: border-box;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 5rpx solid #fffdf7;
    border-radius: 16rpx;
    background: var(--soft, #efe9db);
    color: var(--ink, #8a8f83);
    font-size: 30rpx;
    font-weight: 600;
}

.grid--c3 .cell { width: 33.3333%; height: 156rpx; }
.grid--c4 .cell { width: 25%; height: 128rpx; font-size: 26rpx; }
.grid--c6 .cell { width: 16.6666%; height: 100rpx; font-size: 24rpx; border-width: 3rpx; border-radius: 10rpx; }

.cell--lit {
    background: var(--acc, #3d8c74);
    color: #fffdf7;
    animation: litPop 0.35s ease-out;
}
.cell--off { background: #ded7c6; color: #a09e8f; transition: background 0.25s ease, color 0.25s ease; }
.cell--ok { background: var(--acc, #b8893b); color: #fffdf7; }
.cell--bad { background: #b4453c; color: #fffdf7; animation: badShake 0.22s ease-out; }
.cell--hidden { background: #d5cdb9; color: #9a9a8b; }
.cell--open { background: #f7f3e8; color: var(--ink, #2f6b5b); font-weight: 700; }
/* 探禁：翻开格上的数字按大小分色（1 / 2 / 3+），一眼扫得出「1 的边界在哪」。
   这是经典扫雷里唯一值得照搬的辅助；把数字画成符文反而读不出来。 */
.cell--open.cell--t1 { color: #2f6b5b; }
.cell--open.cell--t2 { color: #b4453c; }
.cell--open.cell--t3 { color: #a8791f; }
.cell--flag { background: #f5ead2; color: #a2762d; }
.cell--mine { background: #b4453c; color: #fffdf7; animation: badShake 0.3s ease-out; }
.cell--hint { background: #b8893b; color: #fffdf7; animation: litPop 0.5s ease-out infinite alternate; }
.cell--trail { background: var(--soft, #dcecf1); color: var(--ink, #22505f); }
.cell--gold { background: #b8893b; color: #fffdf7; }
.cell--hot { box-shadow: inset 0 0 0 6rpx rgba(255, 243, 205, 0.55); }
/* 死门：暗红底 + 叉号，和米色的暗格拉开一整档；亮着的死门提一档亮度，轮廓不变。 */
.cell--dead { background: #8d3b32; color: #fff3e6; box-shadow: inset 0 0 0 4rpx #5c231d; }
.cell--dead-lit { background: #a84a3e; }

/* 破阵那一拍：整盘一次性泛金 + 金描边。换盘时 paint() 重置 cls，这一层自然收掉，
   不做常驻呼吸；动画只跑一次，也不占「常驻循环动画」的预算。 */
.cell--solved {
    box-shadow: inset 0 0 0 4rpx var(--c-imm-gold, #cfae6d);
    animation: solvedGlow 0.6s ease-out 1;
}

@keyframes solvedGlow {
    0% { box-shadow: inset 0 0 0 6rpx #cfae6d, 0 0 30rpx rgba(207, 174, 109, 0.7); }
    100% { box-shadow: inset 0 0 0 2rpx rgba(207, 174, 109, 0.35); }
}

/* ---------- 循光斩桩：刀路（划） ---------- */
.trail-hint {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    /* 大圆满会同时挂两条规则，右侧那行容易顶到边；允许换行，宁可排两行也别溢出。 */
    flex-wrap: wrap;
    margin-top: 20rpx;
}

.trail-hint__name {
    font-size: 32rpx;
    font-weight: 700;
    letter-spacing: 2rpx;
}

/* 刀路：已掠过的桩留一道浅光痕，光头最亮；金色是重斩长招。 */
.cell--path {
    background: rgba(74, 107, 134, 0.26);
    color: var(--ink, #254253);
    box-shadow: inset 0 0 0 3rpx rgba(74, 107, 134, 0.35);
}

.cell--pathgold {
    background: rgba(184, 137, 59, 0.3);
    color: #8a6524;
    box-shadow: inset 0 0 0 3rpx rgba(184, 137, 59, 0.45);
}

.cell--pathon {
    background: var(--acc, #4a6b86);
    color: #fffdf7;
    box-shadow: 0 0 20rpx rgba(74, 107, 134, 0.55);
    transform: scale(1.04);
}

.cell--pathgold.cell--pathon {
    background: #b8893b;
    box-shadow: 0 0 22rpx rgba(184, 137, 59, 0.65);
}

/* 双锋的虚招：同样有箭头与靶心，但整条路压暗一档。
   真假不靠猜——真招的靶心在呼吸（见 .cell__end--live），虚招是静止的。 */
.cell--pathfake {
    background: rgba(74, 107, 134, 0.1);
    color: rgba(74, 107, 134, 0.42);
    box-shadow: inset 0 0 0 3rpx rgba(74, 107, 134, 0.16);
}

/* 禁桩：红叉一目了然，划过即断势。叉用 currentColor，深色舞台跟着走。 */
.cell--ban {
    background: rgba(180, 69, 60, 0.1);
    color: rgba(180, 69, 60, 0.72);
    box-shadow: inset 0 0 0 3rpx rgba(180, 69, 60, 0.3);
}

.cell--ban::before,
.cell--ban::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 54rpx;
    height: 6rpx;
    margin-left: -27rpx;
    margin-top: -3rpx;
    border-radius: 3rpx;
    background: currentColor;
}

.cell--ban::before { transform: rotate(45deg); }
.cell--ban::after { transform: rotate(-45deg); }

.cell--cut {
    background: #fffdf7;
    color: var(--acc, #4a6b86);
    animation: hitPop 0.18s ease-out;
}

/* 刀路方向：纯 CSS 三角 + 短杆，0° 朝上，inline transform 按相邻桩方向旋转。
   不用汉字、不用 unicode 字形，颜色继承格子 currentColor，浅色 / 深色舞台都清楚。 */
.cell__arrow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 56rpx;
    height: 56rpx;
    pointer-events: none;
}

.cell__arrow-head {
    position: absolute;
    left: 50%;
    top: 2rpx;
    width: 0;
    height: 0;
    margin-left: -13rpx;
    border-left: 13rpx solid transparent;
    border-right: 13rpx solid transparent;
    border-bottom: 20rpx solid currentColor;
}

.cell__arrow-shaft {
    position: absolute;
    left: 50%;
    top: 20rpx;
    width: 6rpx;
    height: 30rpx;
    margin-left: -3rpx;
    border-radius: 3rpx;
    background: currentColor;
}

/* 收势桩：双环靶心，一眼看出「划到这里为止」 */
.cell__end {
    position: absolute;
    left: 50%;
    top: 50%;
    box-sizing: border-box;
    width: 34rpx;
    height: 34rpx;
    border: 5rpx solid currentColor;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
}

.cell__end::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10rpx;
    height: 10rpx;
    border-radius: 50%;
    background: currentColor;
    transform: translate(-50%, -50%);
}

/* 双锋：真招靶心呼吸，虚招静止。只动 opacity 与 transform，守住动效预算。 */
.cell__end--live {
    animation: endBreath 1.1s ease-in-out infinite;
}

@keyframes endBreath {
    0%, 100% { opacity: 0.4; transform: translate(-50%, -50%) scale(0.88); }
    50% { opacity: 1; transform: translate(-50%, -50%) scale(1.14); }
}

/* 斩中时按刀招角度扫过盘面的一道白光：外层定位旋转，内层做扫光动画 */
.grid__slash {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 150%;
    height: 14rpx;
    z-index: 2;
    pointer-events: none;
}

.grid__slash-beam {
    width: 100%;
    height: 100%;
    border-radius: 8rpx;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.85) 22%, #fff 50%, rgba(255, 255, 255, 0.85) 78%, transparent);
    box-shadow: 0 0 20rpx rgba(255, 255, 255, 0.85);
    transform-origin: center;
    animation: slashSweep 0.24s ease-out forwards;
}

@keyframes slashSweep {
    0% { transform: scaleX(0); opacity: 0; }
    22% { opacity: 1; }
    100% { transform: scaleX(1); opacity: 0; }
}

/* 透明触摸层：只在划刀玩法的局内出现，其它玩法的滚动与点按完全不受影响 */
.swipe-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    z-index: 3;
}

/* ---------- 循光斩桩：刀光寿命线 / 重斩 / 斩中 ---------- */
.cell__life {
    position: absolute;
    left: 10rpx;
    right: 10rpx;
    bottom: 9rpx;
    height: 6rpx;
    border-radius: 3rpx;
    background: rgba(255, 253, 247, 0.92);
    transform-origin: left center;
    animation-name: lifeDrain;
    animation-timing-function: linear;
    animation-fill-mode: forwards;
    pointer-events: none;
}

@keyframes lifeDrain {
    from { transform: scaleX(1); }
    to { transform: scaleX(0); }
}

.cell--faded {
    background: #cfc8b8;
    color: #9a9a8b;
}

@keyframes hitPop {
    0% { transform: scale(1.07); }
    100% { transform: scale(1); }
}

/* 五行分色只作用于亮起的格子，t0 留给主题主色 */
.cell--lit.cell--t1 { background: #4f8f5a; }
.cell--lit.cell--t2 { background: #c25b3f; }
.cell--lit.cell--t3 { background: #b8893b; }
.cell--lit.cell--t4 { background: #7d8398; }
.cell--lit.cell--t5 { background: #3b7a8c; }

/* ---------- 辨伪择真：真招与虚影 ---------- */
.cell--decoy {
    background: #8d8b7d;
    color: #fffdf7;
}

/* ---------- 循纹递推：竖向河道 ---------- */
.lane-rule {
    box-sizing: border-box;
    margin-top: 20rpx;
    padding: 14rpx 18rpx;
    border-left: 6rpx solid var(--acc, #3d8c74);
    border-radius: 10rpx;
    background: var(--soft, #e9e3d4);
}

.grid--lane {
    padding: 18rpx;
    background: linear-gradient(180deg, var(--soft, #e9e3d4), var(--bg, #efe9db));
}

.grid--lane .cell {
    height: 108rpx;
    border-radius: 12rpx;
}

.grid--lane .cell--fog {
    background: rgba(120, 140, 150, 0.16);
    color: transparent;
    border-style: dashed;
}

.grid--lane .cell--trail {
    background: var(--soft, #e9e3d4);
    color: var(--ink, #5d6358);
    opacity: 0.6;
}

.grid--lane .cell--stone {
    background: var(--bg, #efe9db);
    color: var(--ink, #5d6358);
    border-color: var(--acc, #3d8c74);
    font-size: 34rpx;
}

.grid--lane .cell--stone.cell--t1 { box-shadow: inset 0 -10rpx 0 rgba(79, 143, 90, 0.5); }
.grid--lane .cell--stone.cell--t2 { box-shadow: inset 0 -10rpx 0 rgba(194, 91, 63, 0.5); }
.grid--lane .cell--stone.cell--t3 { box-shadow: inset 0 -10rpx 0 rgba(184, 137, 59, 0.55); }
.grid--lane .cell--stone.cell--t4 { box-shadow: inset 0 -10rpx 0 rgba(125, 131, 152, 0.55); }
.grid--lane .cell--stone.cell--t5 { box-shadow: inset 0 -10rpx 0 rgba(59, 122, 140, 0.55); }

/* ---------- 成对翻牌：牌背 / 翻开 / 已通 ---------- */
.cell--card {
    background: var(--ink, #5d6358);
    color: var(--bg, #efe9db);
    font-family: serif;
    font-size: 38rpx;
}

.cell--flipped {
    background: var(--bg, #efe9db);
    color: var(--ink, #5d6358);
    border-color: var(--acc, #3d8c74);
    font-family: serif;
    font-size: 38rpx;
    animation: litPop 0.28s ease-out;
}

.cell--flipped.cell--t1 { color: #4f8f5a; }
.cell--flipped.cell--t2 { color: #c25b3f; }
.cell--flipped.cell--t3 { color: #a8791f; }
.cell--flipped.cell--t4 { color: #6f5b9e; }
.cell--flipped.cell--t5 { color: #3b7a8c; }

.cell--matched {
    background: var(--soft, #e9e3d4);
    color: var(--ink, #5d6358);
    opacity: 0.5;
}

/* ---------- 五行相生：五盏灯围成一环 ---------- */
.orbit {
    position: relative;
    height: 480rpx;
    margin-top: 20rpx;
    border-radius: 20rpx;
    background: var(--soft, #e9e3d4);
}

.orbit__core {
    position: absolute;
    top: 50%;
    left: 50%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 190rpx;
    height: 190rpx;
    border: 6rpx solid var(--acc, #3d8c74);
    border-radius: 50%;
    background: var(--bg, #efe9db);
    transform: translate(-50%, -50%);
}

.orbit__glyph {
    font-family: serif;
    font-size: 62rpx;
    line-height: 1.2;
}

.orbit__lamp {
    position: absolute;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 112rpx;
    height: 112rpx;
    border: 5rpx solid var(--frame, #fffdf7);
    border-radius: 50%;
    background: var(--bg, #efe9db);
    color: var(--ink, #5d6358);
    font-family: serif;
    font-size: 38rpx;
}

.orbit__lamp--0 { top: 16rpx; left: 50%; transform: translateX(-50%); }
.orbit__lamp--1 { top: 118rpx; right: 34rpx; }
.orbit__lamp--2 { right: 74rpx; bottom: 32rpx; }
.orbit__lamp--3 { bottom: 32rpx; left: 74rpx; }
.orbit__lamp--4 { top: 118rpx; left: 34rpx; }

.orbit__lamp--t1 { border-color: #4f8f5a; }
.orbit__lamp--t2 { border-color: #c25b3f; }
.orbit__lamp--t3 { border-color: #b8893b; }
.orbit__lamp--t4 { border-color: #7d8398; }
.orbit__lamp--t5 { border-color: #3b7a8c; }

.orbit__lamp.lamp--current {
    background: var(--acc, #3d8c74);
    color: #fffdf7;
    box-shadow: 0 0 0 8rpx rgba(184, 137, 59, 0.28);
}

.orbit__lamp.lamp--hit {
    background: #b8893b;
    color: #fffdf7;
    animation: litPop 0.35s ease-out;
}

/* ---------- 步法连段：卷轴 + 四个步法键 ---------- */
.scroll {
    box-sizing: border-box;
    margin-top: 20rpx;
    padding: 20rpx;
    border-radius: 18rpx;
    background: var(--soft, #e9e3d4);
}

.scroll__ribbon {
    display: flex;
    flex-wrap: wrap;
    min-height: 88rpx;
    margin-top: 16rpx;
}

/* 卷轴是一串步点，不是一行字：节点画成圆，走过的描边、当前那颗实心起光——
   一眼能看出流光在往前推，而不是在读一串文字。 */
.scroll__move {
    position: relative;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72rpx;
    height: 72rpx;
    margin: 0 12rpx 12rpx 0;
    border: 3rpx solid var(--frame, #fffdf7);
    border-radius: 50%;
    background: var(--bg, #efe9db);
    color: var(--ink, #5d6358);
}

/* 步点之间连一小段线：一串圆点看上去才像「一条要走的路径」，
   而不是一排待点的按钮。走过的那些线更实。 */
.scroll__move::after {
    position: absolute;
    top: 50%;
    right: -12rpx;
    width: 12rpx;
    height: 2rpx;
    background: var(--acc, #3d8c74);
    opacity: 0.3;
    content: '';
    transform: translateY(-50%);
}

.scroll__move--done::after { opacity: 0.75; }
.scroll__move:last-child::after { display: none; }

.scroll__move--active {
    border-color: var(--acc, #3d8c74);
    background: var(--acc, #3d8c74);
    color: #fffdf7;
    box-shadow: 0 0 14rpx var(--acc, #3d8c74);
    animation: litPop 0.35s ease-out;
}

.scroll__move--done {
    border-color: var(--acc, #3d8c74);
    background: transparent;
    color: var(--acc, #3d8c74);
    opacity: 0.55;
}

.scroll__keys {
    display: flex;
    margin-top: 20rpx;
}

.scroll__key {
    box-sizing: border-box;
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    height: 120rpx;
    margin-right: 12rpx;
    border: 5rpx solid var(--acc, #3d8c74);
    border-radius: 16rpx;
    background: var(--bg, #efe9db);
    color: var(--ink, #5d6358);
}

/* 按下就整块翻成步色：连按同一个方向时，手指能立刻确认「这一下点上了」。 */
.scroll__key--press {
    background: var(--acc, #3d8c74);
    color: #fffdf7;
}

.scroll__key:last-child { margin-right: 0; }

/* ---------- 步法符号 ----------
   盘面不写汉字：进 / 退 / 侧 / 转 只作内部真值，画出来的是方向图形。
   箭头默认朝右，up = -90° / down = 90° / side = -45°；「旋身」没有方向，
   改用缺口圆环（四周皆可转，缺口表示还在转）。 */
.step {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34rpx;
    height: 34rpx;
}

.step__arrow {
    position: absolute;
    width: 26rpx;
    height: 5rpx;
    border-radius: 3rpx;
    background: currentColor;
}

.step__arrow::after {
    position: absolute;
    top: 50%;
    right: -1rpx;
    width: 0;
    height: 0;
    border-top: 9rpx solid transparent;
    border-bottom: 9rpx solid transparent;
    border-left: 12rpx solid currentColor;
    content: '';
    transform: translateY(-50%);
}

.step--up .step__arrow { transform: rotate(-90deg); }
.step--down .step__arrow { transform: rotate(90deg); }
.step--side .step__arrow { transform: rotate(-45deg); }

/* 旋身：缺口圆环只是「一圈」，加一枚切向的小箭头才是「在转」。
   不加箭头时这个图形读起来像字母 C，和评级徽章的 C 撞了。 */
.step__ring {
    position: relative;
    display: none;
    box-sizing: border-box;
    width: 27rpx;
    height: 27rpx;
    border: 5rpx solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
}

.step__ring::after {
    position: absolute;
    top: -6rpx;
    right: -7rpx;
    width: 0;
    height: 0;
    border-right: 13rpx solid currentColor;
    border-top: 8rpx solid transparent;
    border-bottom: 8rpx solid transparent;
    content: '';
    transform: rotate(-38deg);
}

.step--turn .step__arrow { display: none; }
.step--turn .step__ring { display: block; }

.step--lg {
    width: 48rpx;
    height: 48rpx;
}

.step--lg .step__arrow {
    width: 36rpx;
    height: 7rpx;
    border-radius: 4rpx;
}

.step--lg .step__arrow::after {
    border-top-width: 12rpx;
    border-bottom-width: 12rpx;
    border-left-width: 17rpx;
}

.step--lg .step__ring {
    width: 38rpx;
    height: 38rpx;
    border-width: 7rpx;
}

.step--lg .step__ring::after {
    top: -8rpx;
    right: -9rpx;
    border-right-width: 17rpx;
    border-top-width: 10rpx;
    border-bottom-width: 10rpx;
}

/* ---------- 起手式 ---------- */
.countdown-mask {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: var(--z-countdown);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--c-imm-mask);
}

.countdown-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--c-imm-text);
}

.countdown-seal {
    color: var(--c-imm-gold);
    font-size: 72rpx;
    letter-spacing: 10rpx;
}

.countdown-num {
    color: var(--c-imm-text);
    font-size: 150rpx;
    line-height: 1.4;
    animation: litPop 0.36s ease-out;
}

.countdown-inner .tiny { color: var(--c-imm-text-2); }

/* ---------- 结算 ---------- */
.modal--reveal { animation: modalReveal 0.42s ease-out; }

.res-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14rpx 0;
    border-bottom: 1rpx solid var(--c-imm-line-soft);
}

.res-note { padding: 6rpx 0; }

.res-note .body { color: var(--c-imm-text-2); }

@keyframes litPop {
    0% { transform: scale(0.82); opacity: 0.45; }
    60% { transform: scale(1.06); opacity: 1; }
    100% { transform: scale(1); opacity: 1; }
}
@keyframes badShake {
    0%, 100% { transform: translateX(0); }
    30% { transform: translateX(-8rpx); }
    70% { transform: translateX(8rpx); }
}
@keyframes fxFloat {
    0% { opacity: 0; transform: translateY(18rpx) scale(0.9); }
    18% { opacity: 1; transform: translateY(0) scale(1); }
    75% { opacity: 1; transform: translateY(-10rpx); }
    100% { opacity: 0; transform: translateY(-46rpx); }
}
@keyframes bannerIn {
    from { opacity: 0; letter-spacing: 14rpx; }
    to { opacity: 1; letter-spacing: 4rpx; }
}
@keyframes modalReveal {
    from { opacity: 0; transform: translateY(30rpx) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
}

/* ---------- 功法品阶与进阶链 ---------- */
/* 品阶卡是唯一带金底的块：一行品阶 + 一行进阶链，靠颜色成组，不再叠独立小盒。 */
.rank-card {
    border: 1rpx solid var(--c-imm-gold-dim);
    border-radius: var(--r-sm);
    background: var(--c-imm-gold-soft);
    padding: 20rpx 22rpx;
}
.rank-badge {
    width: 46rpx;
    height: 46rpx;
    margin-right: 12rpx;
    border-radius: 8rpx;
    color: var(--c-imm-bg);
    font-size: 26rpx;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
}
.rank-chain__item {
    display: inline-block;
    margin: 0 10rpx 10rpx 0;
    padding: 8rpx 14rpx;
    border-radius: var(--r-xs);
    background: var(--c-imm-panel-2);
    color: var(--c-imm-text-2);
    font-size: 22rpx;
    line-height: 1.5;
}
.rank-chain__item--now { border: 1rpx solid var(--c-imm-gold-dim); background: var(--c-imm-gold-soft); color: var(--c-imm-gold); font-weight: 600; }

/* ---------- 难度档选择 ---------- */
.warn-note {
    display: block;
    padding: 12rpx 16rpx;
    border-left: 4rpx solid var(--c-imm-danger);
    border-radius: 0 var(--r-xs) var(--r-xs) 0;
    background: var(--c-imm-danger-soft);
    color: var(--c-imm-danger);
    font-size: 22rpx;
    line-height: 1.65;
}
.diff-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
}
.diff-chip {
    width: calc((100% - 20rpx) / 3);
    box-sizing: border-box;
    padding: var(--sp-3) var(--sp-2);
    border: 1rpx solid var(--c-border);
    border-radius: var(--r-sm);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rpx;
    background: var(--c-imm-bg-2);
}
.diff-chip__name { font-size: var(--fs-body-sm); color: var(--c-text); font-weight: 600; }
.diff-chip__mult { font-size: var(--fs-caption); color: var(--c-text-2); }
.diff-chip__need { font-size: var(--fs-caption); color: var(--c-imm-gold); }
/* 选中这一档实际收紧了什么：一行小字，跟在档位下面，不占一格。 */
.diff-brief {
    display: block;
    margin-top: var(--sp-3);
    color: var(--c-imm-text-3);
    line-height: 1.6;
}
/* 选中档只换描边与字色，不铺色块：一屏只允许一处金色实心（开始参悟）。 */
.diff-chip--on { border-color: var(--c-imm-gold-dim); background: var(--c-imm-gold-soft); }
.diff-chip--on .diff-chip__name { color: var(--c-imm-gold); }
.diff-chip--on .diff-chip__mult { color: var(--c-imm-text-2); }
.diff-chip--lock { opacity: 0.55; }

/* 盘面是纸、页面是墨：本页恒定深色，不再跟系统明暗翻转。
   纸面取的是注入的 --soft / --ink / --bg，因此格子里的字永远是深墨落在浅纸上；
   页面本身（准备页、HUD、结算）只认 --c-imm-*。系统切到深色时整页不变，
   盘面也不会突然变成另一种颜色。 */

/* ---------- 本门新法：熟练度阶段解锁的规则变化 ---------- */
.stage-rule {
  display: flex;
  align-items: flex-start;
  gap: var(--sp-3);
  margin-top: var(--sp-3);
}

.stage-rule__text { line-height: var(--lh-body); }

/* 胶囊开关：墨底上只有两句状态字，开是金边金字、关是灰边灰字。
   原生 switch 在深色下未选中轨道是一块白，和这套皮肤打架，所以自己做。
   热区撑到 --touch-xs，别让两个字小到点不准。 */
.stage-rule__toggle {
  flex: none;
  align-self: center;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 72rpx;
  min-height: var(--touch-xs);
  padding: 0 10rpx;
  border: 1rpx solid var(--c-imm-line);
  border-radius: 999rpx;
  color: var(--c-imm-text-3);
  font-size: var(--fs-caption);
  letter-spacing: 1rpx;
}

.stage-rule__toggle--on {
  border-color: var(--c-imm-gold-dim);
  color: var(--c-imm-gold);
}

/* ---------- 三连 S 晋级：准备页常驻进度 ---------- */
.streak-card {
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--c-imm-gold-dim);
  border-radius: var(--r-sm);
  background: var(--c-imm-gold-soft);
}

.streak-dots { display: flex; gap: 12rpx; }

.streak-dot {
  width: 28rpx;
  height: 28rpx;
  border: 1rpx solid var(--c-imm-gold-dim);
  border-radius: 50%;
  background: transparent;
  box-sizing: border-box;
}

.streak-dot--on { background: var(--c-imm-gold); border-color: var(--c-imm-gold); }

/* ---------- 三套经典玩法的盘面：矮格 / 灵纹 / 落石 / 方向键 ---------- */
/* 6 列以上、8 行的盘面要把格子压矮，否则小屏装不下；只在 vm.extras.compact 时启用。 */
.grid--compact .cell {
  height: 76rpx;
  font-size: 24rpx;
  border-width: 3rpx;
  border-radius: 10rpx;
}

.cell--chip { font-size: 34rpx; letter-spacing: 0; }
.cell--gone, .cell--void { background: rgba(120, 130, 120, 0.08); border-color: transparent; }
.cell--sel { box-shadow: inset 0 0 0 5rpx #fffdf7, 0 0 18rpx rgba(255, 253, 247, 0.85); }
.cell--hintpair { animation: litPop 0.5s ease-out infinite alternate; }
.cell--set { opacity: 0.86; }
.cell--live { box-shadow: 0 0 16rpx rgba(255, 253, 247, 0.8); }

.pad {
  display: flex;
  gap: var(--sp-3);
  margin-top: var(--sp-4);
}

.pad__key {
  flex: 1;
  min-height: var(--touch);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  color: var(--ink, #2f6b5b);
  background: var(--soft, #efe9db);
  border: 3rpx solid var(--frame, #fffdf7);
  border-radius: var(--r-md);
}

/* ---------- 阵灯推演：翻转范围微光 ---------- */
/* 点一格时，被翻的自身 + 四邻同步闪一拍。a / b 两个类名交替，连点同一格动画才会重播；
   animation 不设 forwards，跑完自动回到灯态，不占常驻循环动画的预算。 */
.cell--flip-a, .cell--flip-b { animation: flipGlow 0.26s ease-out 1; }

@keyframes flipGlow {
    0% { box-shadow: inset 0 0 0 6rpx rgba(255, 253, 247, 0.95), 0 0 20rpx rgba(255, 253, 247, 0.5); }
    100% { box-shadow: inset 0 0 0 0 rgba(255, 253, 247, 0), 0 0 0 rgba(255, 253, 247, 0); }
}

/* ---------- 首局手把手 ---------- */
/* 一张窄条 + 一格呼吸：不盖盘面、不遮整屏。看规则最快的方式是亲手点一次。 */
.teach {
    padding-bottom: var(--sp-2);
    border-bottom: 1rpx solid var(--c-imm-line-soft);
    margin-bottom: var(--sp-3);
}

.teach__skip {
    min-height: var(--touch-xs);
    line-height: var(--touch-xs);
}

.teach__text {
    color: var(--c-imm-text);
    line-height: 1.6;
}

/* 该点的那一格自己呼吸：盘面不写「点这里」，靠光影指路。 */
.cell--teach-next {
    animation: teachPulse 1.15s ease-in-out infinite;
}

@keyframes teachPulse {
    0%, 100% {
        box-shadow: inset 0 0 0 0 rgba(255, 253, 247, 0), 0 0 0 0 rgba(207, 174, 109, 0);
        transform: scale(1);
    }
    50% {
        box-shadow: inset 0 0 0 5rpx rgba(255, 253, 247, 0.92), 0 0 28rpx rgba(207, 174, 109, 0.55);
        transform: scale(1.03);
    }
}

/* ---------- 参悟结算：留在本页 ---------- */
/* 主按钮改成「留在本页」后，连刷要有一条不抢主按钮的轻量出口。 */
.modal__again, .settle__again {
    display: block;
    text-align: center;
    min-height: var(--touch-xs);
    line-height: var(--touch-xs);
    font-size: var(--fs-body-sm);
    margin-top: var(--sp-3);
}

/* 准备页顶部那行「上局战绩」：数值在左、可点的入口在右，不占首屏一行说明。 */
.pr-record {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
    margin-top: var(--sp-3);
    padding-top: var(--sp-2);
    border-top: 1rpx solid var(--c-imm-line-soft);
}

/* 倒数三秒里的反悔入口：别跟「点一下跳过」抢，catchtap 单独接。 */
.countdown__stay {
    margin-top: var(--sp-4);
    padding: var(--sp-2) var(--sp-4);
    font-size: var(--fs-body-sm);
}

