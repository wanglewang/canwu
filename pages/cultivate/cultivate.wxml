<view class="pg pg--imm">
  <view class="imm-head">
    <text class="imm-head__slot"></text>
    <text class="imm-head__title">修炼</text>
    <text class="imm-head__action pressable" hover-class="pressable--on" bindtap="onGoHelp">说明</text>
  </view>

  <view wx:if="{{skills.length === 0}}" class="imm-panel">
    <text class="imm-empty">{{copy.emptySkills}}</text>
    <button class="imm-btn imm-btn--block" bindtap="onGoSkills">去功法页看看</button>
  </view>

  <block wx:else>
    <scroll-view class="imm-scroll" scroll-x enable-flex>
      <view class="imm-book {{item.on ? 'imm-book--on' : ''}} pressable" hover-class="pressable--on"
            wx:for="{{skills}}" wx:key="id" data-id="{{item.id}}" bindtap="onSelect">
        <text class="imm-book__mark">{{item.mark}}</text>
        <text class="imm-book__name">{{item.shortName}}</text>
      </view>
    </scroll-view>

    <view class="imm-stage">
      <text class="imm-stage__score">{{lastText}}</text>
      <portrait variant="{{portrait}}" realm="{{realmIndex}}" size="normal" />
    </view>

    <view class="imm-panel">
      <view class="imm-panel__head">
        <text class="imm-panel__label">当前功法</text>
        <text class="imm-chip">{{current.profTierName}}</text>
      </view>
      <text class="imm-realm">{{current.name}}</text>
      <view class="imm-bar"><view class="imm-bar__fill" style="width:{{current.percent}}%"></view></view>
      <view class="imm-strip">
        <text>熟练度</text>
        <text class="imm-strip__value">{{current.prof}} / {{current.nextThreshold}}</text>
      </view>
      <view class="imm-strip">
        <text>{{current.nextText}}</text>
      </view>
    </view>

    <view class="imm-btn-row">
      <button class="imm-btn" bindtap="onStart">开始修炼</button>
      <button class="imm-btn--ghost" bindtap="onGoSkills">换功法</button>
    </view>
  </block>
</view>
