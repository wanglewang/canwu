<view class="pg pg--imm">
  <view wx:if="{{!d}}" class="imm-panel">
    <text class="imm-empty">{{copy.emptySkills}}</text>
    <button class="imm-btn imm-btn--block" bindtap="onGoSkills">{{copy.actions.goSkills}}</button>
  </view>

  <block wx:else>
    <!-- 功法头：一枚印 + 正名 + 类别 / 品阶 / 这一门练什么。 -->
    <view class="dt-head">
      <view class="dt-seal">{{d.mark}}</view>
      <view class="dt-head__body">
        <text class="dt-name">{{d.name}}</text>
        <view class="dt-tags">
          <text class="imm-chip">{{d.type}}</text>
          <text class="imm-chip">{{d.tierLabel}}</text>
        </view>
        <text class="dt-method">{{d.methodName}} · {{d.gameName}}</text>
      </view>
    </view>

    <view class="imm-panel">
      <text class="dt-desc">{{d.desc}}</text>
      <text class="dt-flavor">{{d.flavor}}</text>
    </view>

    <!-- 修为：段位、进度、离下一段还差多少。 -->
    <view class="imm-panel">
      <view class="imm-panel__head">
        <text class="imm-panel__label">{{copy.sections.detailProf}}</text>
        <text class="imm-chip">{{d.profTierName}}</text>
      </view>
      <view class="imm-bar"><view class="imm-bar__fill" style="width:{{d.percent}}%"></view></view>
      <view class="imm-strip">
        <text>熟练度</text>
        <text class="imm-strip__value">{{d.prof}}</text>
      </view>
      <view class="imm-strip">
        <text>{{d.nextText}}</text>
      </view>
      <!-- 境界吃亏的门说清「还能练，只是打折」，别让人以为这门作废了。 -->
      <text wx:if="{{d.decayed}}" class="dt-warn">{{d.decayText}}</text>
    </view>

    <!-- 练成之后：只列属性与收益两条；大成特效未达成时是空头支票，留在图鉴里。 -->
    <view class="imm-panel">
      <text class="imm-panel__label">{{copy.sections.codexGain}}</text>
      <view class="dt-gain" wx:for="{{d.gainLines}}" wx:key="label">
        <text class="dt-gain__label">{{item.label}}</text>
        <text class="dt-gain__value">{{item.value}}</text>
      </view>
    </view>

    <view class="imm-panel">
      <view class="imm-panel__head">
        <text class="imm-panel__label">{{copy.sections.detailRecord}}</text>
        <text class="dt-last">{{lastText}}</text>
      </view>
      <text class="dt-note">连 {{d.sStreakGoal}} 局 S 直接晋一段 · 已连 {{d.sStreak}} 局</text>
    </view>

    <button class="imm-btn imm-btn--block" bindtap="onStart">{{copy.actions.start}}</button>

    <view class="dt-links">
      <text class="text-link text-link--muted pressable" hover-class="pressable--on" bindtap="onToggleSwap">{{copy.actions.swap}}</text>
      <text class="text-link text-link--muted pressable" hover-class="pressable--on" bindtap="onGoHelp">{{copy.sections.methodHelp}}</text>
    </view>
  </block>

  <!-- 换功法：页内一层，点一门就换掉，不必退回列表再点一遍。 -->
  <view class="mask" wx:if="{{swapOpen}}" bindtap="onToggleSwap">
    <view class="modal" catchtap="noop">
      <text class="modal__title">{{copy.sections.swapTitle}}</text>
      <view class="imm-list">
        <view class="imm-row pressable" hover-class="pressable--on" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onSwapTo">
          <view class="imm-row__mark">{{item.mark}}</view>
          <view class="imm-row__body">
            <text class="imm-row__name">{{item.cardName}}</text>
            <text class="imm-row__sub">{{item.metaText}}</text>
          </view>
          <text wx:if="{{item.current}}" class="imm-chip imm-chip--jade">当前</text>
        </view>
      </view>
      <view class="modal__actions">
        <button class="imm-btn--ghost imm-btn--block" bindtap="onToggleSwap">{{copy.actions.close}}</button>
      </view>
    </view>
  </view>

  <view class="pg__foot">
    <text class="text-link text-link--muted pressable" hover-class="pressable--on" bindtap="onGoPageHelp">本页说明 ›</text>
  </view>
</view>
