/* 修炼页：一排功法牌 + 修炼台 + 熟练度，页面上没有一句规则说明。 */
.imm-scroll {
    width: 100%;
    white-space: nowrap;
    margin-top: var(--sp-2);
}

.imm-book {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 132rpx;
    height: 172rpx;
    margin-right: var(--sp-3);
    border: 1rpx solid var(--c-imm-line);
    border-radius: var(--r-md);
    background: var(--c-imm-panel);
    vertical-align: top;
}

.imm-book--on {
    border-color: var(--c-imm-gold-dim);
    background: var(--c-imm-gold-soft);
}

.imm-book__mark {
    color: var(--c-imm-text-3);
    font-size: var(--fs-h2);
    line-height: 1;
}

.imm-book--on .imm-book__mark { color: var(--c-imm-gold); }

.imm-book__name {
    color: var(--c-imm-text-2);
    font-size: var(--fs-note);
    margin-top: var(--sp-4);
    max-width: 108rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.imm-book--on .imm-book__name { color: var(--c-imm-gold); }

.imm-stage .portrait { margin-top: 0; }
