/* 功法详情 = 这一门功法的静室：一枚印、一段来历、修为进度、练成之后、上一局，然后开局。
   不再是平铺全部功法的练功台——选功法是功法页的职责，这里只对着一门。
   换功法在页内弹一层（.mask + .modal），不退回列表。

   一屏只留「开始参悟」一处金色实心；换功法与玩法说明都是文字链。 */

.dt-head {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-5);
    padding: var(--sp-5) 0 var(--sp-2);
}

/* 功法印：一枚方章，字用类别首字，与功法页左侧方标同一个字。 */
.dt-seal {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 128rpx;
    height: 128rpx;
    border: 2rpx solid var(--c-imm-gold-dim);
    border-radius: var(--r-md);
    background: var(--c-imm-tile);
    color: var(--c-imm-gold);
    font-size: 56rpx;
    line-height: 1;
}

.dt-head__body {
    flex: 1 1 0;
    min-width: 0;
    padding-top: var(--sp-1);
}

.dt-name {
    display: block;
    color: var(--c-imm-text);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dt-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: var(--sp-3);
}

.dt-method {
    display: block;
    margin-top: var(--sp-3);
    color: var(--c-imm-text-3);
    font-size: var(--fs-caption);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* 来历：正文说这一门在做什么，引文另起一段用金色细体，像书页上的批注。 */
.dt-desc {
    display: block;
    color: var(--c-imm-text-2);
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body);
}

.dt-flavor {
    display: block;
    margin-top: var(--sp-4);
    padding-left: var(--sp-4);
    border-left: 2rpx solid var(--c-imm-gold-dim);
    color: var(--c-imm-gold-dim);
    font-size: var(--fs-caption);
    line-height: var(--lh-body);
}

/* 练成之后：两行键值，标签弱、数值亮。 */
.dt-gain {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-top: var(--sp-3);
}

.dt-gain__label {
    flex: none;
    color: var(--c-imm-text-3);
    font-size: var(--fs-caption);
}

.dt-gain__value {
    flex: 1 1 0;
    min-width: 0;
    text-align: right;
    color: var(--c-imm-gold);
    font-size: var(--fs-body-sm);
    word-break: break-all;
}

.dt-last {
    flex: none;
    color: var(--c-imm-text-2);
    font-size: var(--fs-body-sm);
}

.dt-note {
    display: block;
    margin-top: var(--sp-3);
    color: var(--c-imm-text-3);
    font-size: var(--fs-caption);
}

.dt-warn {
    display: block;
    margin-top: var(--sp-3);
    color: var(--c-danger-text);
    font-size: var(--fs-caption);
    line-height: var(--lh-body);
}

/* 两条次级入口并排靠右，都只是文字，不抢主按钮。 */
.dt-links {
    display: flex;
    justify-content: flex-end;
    gap: var(--sp-6);
    margin-top: var(--sp-5);
    min-height: var(--touch-xs);
    align-items: center;
}

/* 主按钮别贴着卡片底边；只补上边距，不碰左右的 auto */
.imm-panel + .imm-btn--block { margin-top: var(--sp-8); }
